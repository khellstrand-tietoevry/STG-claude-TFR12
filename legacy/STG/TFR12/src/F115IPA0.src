      *----------------------------------------------------------------*02090000
      * Internal area:                                                  02100000
      *                                                                 02110000
       01  W-Int-IO-Area.                                               02120000
           Copy R115IPA0.                                               02130000
      *                                                                 02140000
      *----------------------------------------------------------------*02150000
      * Assorted copy-areas:                                            02160000
      *                                                                 02170000
       01  Filler.                                                      02180000
           Copy R115IPAS.                                               02190000
      *                                                                 02200000
       01  Filler.                                                      02210000
           Copy R1781910.                                               02220000
      *                                                                 02230000
       01  Filler.                                                      02240000
           Copy R5879010.                                               02250000
      *                                                                 02260000
       01  Filler.                                                      02270000
           Copy R7918030.                                               02280000
      *                                                                 02290000
       Copy R7919100.                                                   02300000
       Copy R115X000.                                                   02310000
      *                                                                 02320000
      *################################################################.02330000
       Linkage Section.                                                 02340000
      *                                                                 02350000
       01  L-Ext-IO-Area                 Pic  X(560).                   02360000
       Copy R7919999.                                                   02370000
      *                                                                 02380000
      *################################################################.02390000
       Procedure Division                Using L-Ext-IO-Area            02400000
                                               R7919999-Error-Area.     02410000
      *                                                                 02420000
       A000-Main                         Section.                       02430000
      *                                                                 02440000
           Perform B000-Initialize                                      02450000
      *                                                                 02460000
           Evaluate True                                                02470000
             When SW-IA-Initialize                                      02480000
               Continue                                                 02490000
      *                                                                 02500000
             When Other                                                 02510000
               Perform ZI00-Conv-Input-Version                          02520000
               Perform C000-Interface                                   02530000
               Perform ZO00-Conv-Output-Version                         02540000
      *                                                                 02550000
           End-Evaluate                                                 02560000
      *                                                                 02570000
           Goback.                                                      02580000
      *################################################################*02590000
       B000-Initialize                   Section.                       02600000
      *                                                                 02610000
           Set   R7919999-Return-OK      To    True                     02620000
      *                                                                 02630000
           Evaluate True                                                02640000
             When L-Ext-IO-Area (1:10)   =     'INITIALIZE'             02650000
               Set   Sw-IA-Initialize    To    True                     02660000
             When Other                                                 02670000
               Move  Space               To    W-Input-Action           02680000
           End-Evaluate                                                 02690000
      *                                                                 02700000
           Compute  W-Max-Occ-WS-Tab                                    02710000
               =    Length               Of    WS-DB2-Table             02720000
               /    Length               Of    WS-DB2-Row               02730000
      *                                                                 02740000
           If  Sw-IA-Initialize                                         02750000
           or  WS-DB2-Row-Status (1)     Not   Numeric                  02760000
               Initialize                      W-Storage                02770000
               Move  +0                  To    Ind-WS-Put               02780000
           End-If                                                       02790000
      *                                                                 02800000
           If  WC-Row-No                 Not   Numeric                  02810000
           or  WC-Total-No-Of-Rows       Not   Numeric                  02820000
               Initialize                      WC-Counters              02830000
           End-If                                                       02840000
      *                                                                 02850000
           Evaluate True                                                02860000
             When Not R115X000-Is-Initiated                             02870000
               Initialize                      R115X000-External-Data   02880000
             When Not R115X000-Version                                  02890000
               Initialize                      R7918030-ErrorMessage    02900000
               Move  'GL-VERSION-INVALID'                               02910000
                                         To    R7918030-In-MessageCode  02920000
               Move  'VAR1'              To R7918030-In-Variable-Key (1)02930000
               Move  R115X000-Version-No To R7918030-In-Variable-Data(1)02940000
               Move  'VAR2'              To R7918030-In-Variable-Key (2)02950000
               Move  'R115X000'          To R7918030-In-Variable-Data(2)02960000
               Perform Z000-Error-Message                               02970000
               Move  'B001'              To    R7919999-Paragraph       02980000
               Perform Z900-Abend                                       02990000
           End-Evaluate                                                 03000000
      *                                                                 03010000
           .                                                            03020000
      *################################################################.03030000
       C000-Interface                    Section.                       03040000
      *                                                                 03050000
           Perform C100-Verify                                          03060000
      *                                                                 03070000
           Evaluate True                                                03080000
             When R115IPA0-In-Get-1st                                   03090000
               Perform C200-Initialize-Output                           03100000
               Perform D000-Get-1st                                     03110000
               Perform E000-Get-Next                                    03120000
      *                                                                 03130000
             When R115IPA0-In-Get-Next                                  03140000
               Perform C200-Initialize-Output                           03150000
               Perform E000-Get-Next                                    03160000
      *                                                                 03170000
             When R115IPA0-In-Select                                    03180000
               Perform C200-Initialize-Output                           03190000
               Perform F000-Select                                      03200000
      *                                                                 03210000
             When R115IPA0-In-Insert                                    03220000
               Perform G000-Insert                                      03230000
      *                                                                 03240000
             When R115IPA0-In-Update                                    03250000
               Perform H000-Update                                      03260000
      *                                                                 03270000
             When R115IPA0-In-Delete                                    03280000
               Perform I000-Delete                                      03290000
      *                                                                 03300000
             When Other                                                 03310000
               Initialize                      R7918030-ErrorMessage    03320000
               Move  'GL-IN-AKSJON-UV'   To    R7918030-In-MessageCode  03330000
               Move  'VAR1'              To R7918030-In-Variable-Key (1)03340000
               Move  R115IPA0-In-Action  To R7918030-In-Variable-Data(1)03350000
               Perform Z000-Error-Message                               03360000
               Move  'C001'              To    R7919999-Paragraph       03370000
               Perform Z900-Abend                                       03380000
      *                                                                 03390000
           End-Evaluate                                                 03400000
      *                                                                 03410000
           .                                                            03420000
      *################################################################.03430000
       C100-Verify                       Section.                       03440000
      *                                                                 03450000
           Evaluate True                                                03460000
             When R115IPA0-In-Actual                                    03470000
               Set   SW-Table-Actual     To    True                     03480000
      *                                                                 03490000
             When R115IPA0-In-Work                                      03500000
               Set   SW-Table-Work       To    True                     03510000
      *                                                                 03520000
             When other                                                 03530000
               Initialize                      R7918030-ErrorMessage    03540000
               Move  'GL-IN-TABLE-VERSION-UV'                           03550000
                                         To    R7918030-In-MessageCode  03560000
               Move  'VAR1'              To R7918030-In-Variable-Key (1)03570000
               Move  R115IPA0-In-Table-Version                          03580000
                                         To R7918030-In-Variable-Data(1)03590000
               Perform Z000-Error-Message                               03600000
               Move  'C101'              To    R7919999-Paragraph       03610000
               Perform Z900-Abend                                       03620000
      *                                                                 03630000
           End-Evaluate                                                 03640000
      *                                                                 03650000
           .                                                            03660000
      *################################################################.03670000
       C200-Initialize-Output            Section.                       03680000
      *                                                                 03690000
           Initialize                          R115IPA0-Data            03700000
      *                                                                 03710000
           .                                                            03720000
      *################################################################.03730000
       D000-Get-1st                      Section.                       03740000
      *                                                                 03750000
           Perform D100-Prepare-Input                                   03760000
           Perform D200-Prepare-Qualification                           03770000
           Perform D300-Select-Cursor                                   03780000
           If  R115IPA0-In-CC-Count                                     03790000
               Perform D400-Count-Cursor                                03800000
           End-If                                                       03810000
           Perform D500-Open-Cursor                                     03820000
      *                                                                 03830000
           .                                                            03840000
      *################################################################.03850000
       D100-Prepare-Input                Section.                       03860000
      *                                                                 03870000
      * We create internal from- and to-values, depending on the input. 03880000
      *                                                                 03890000
           Initialize                          WE-Cursor-Info           03900000
      *                                                                 03910000
           Move  R115IPA0-In-Fin-Inst-ID To    WE-Fin-Inst-ID           03920000
           Move  R115IPA0-In-Fin-Inst-No To    WE-Fin-Inst-No           03930000
      *                                                                 03940000
           Move  R115IPA0-In-Contract-Type                              03950000
                                         To    WE-Contract-Type         03960000
           Move  +0                      To    W-Tally                  03970000
           Inspect WE-Contract-Type     Tallying W-Tally for all '*' '%'03980000
           If  W-Tally                   >     +0                       03990000
               Inspect WE-Contract-Type  Converting '* ' to '%%'        04000000
           End-If                                                       04010000
      *                                                                 04020000
           Move  R115IPA0-In-Contract-No To    WE-Contract-No           04030000
      *                                                                 04040000
           Move  R115IPA0-In-CA-Currency To    WE-CA-Currency           04050000
           Move  +0                      To    W-Tally                  04060000
           Inspect WE-CA-Currency       Tallying W-Tally for all '*' '%'04070000
           If  W-Tally                   >     +0                       04080000
               Inspect WE-CA-Currency    Converting '* ' to '%%'        04090000
           End-If                                                       04100000
      *                                                                 04110000
           Evaluate True                                                04120000
             When R115IPA0-In-PA-Seq-No  =     +0                       04130000
               Move  +0001               To    WE-From-PA-Seq-No        04140000
               Move  +9999               To    WE-To-PA-Seq-No          04150000
                                                                        04160000
             When other                                                 04170000
               Move  R115IPA0-In-PA-Seq-No                              04180000
                                         To    WE-From-PA-Seq-No        04190000
               Move  R115IPA0-In-PA-Seq-No                              04200000
                                         To    WE-To-PA-Seq-No          04210000
                                                                        04220000
           End-Evaluate                                                 04230000
      *                                                                 04240000
           Move  R115IPA0-In-Status      To    WE-Status                04250000
           Move  +0                      To    W-Tally                  04260000
           Inspect WE-Status            Tallying W-Tally for all '*' '%'04270000
           If  W-Tally                   >     +0                       04280000
               Inspect WE-Status         Converting '* ' to '%%'        04290000
           End-If                                                       04300000
      *                                                                 04310000
           .                                                            04320000
      *################################################################.04330000
       D200-Prepare-Qualification        Section.                       04340000
      *                                                                 04350000
      * We store the qualification, so that we can check that the       04360000
      * qualification do not change on any following Get-Next.          04370000
      *                                                                 04380000
           Initialize                          WS-Cursor-Info           04390000
           Move  WE-Key                  To    WS-Key                   04400000
           Move  WE-Code-Sequence        To    WS-Code-Sequence         04410000
      *                                                                 04420000
           Initialize WC-Counters                                       04430000
      *                                                                 04440000
      * We check that we do not have any "negative" intervals.          04450000
      * DB2 is not very fond of those...                                04460000
      *                                                                 04470000
      * We fill in the SQL host variables.                              04480000
      *                                                                 04490000
           Initialize                          W-DB-Key                 04500000
      *                                                                 04510000
           Move  WE-Fin-Inst-ID          To    W-DB-Fin-Inst-ID         04520000
           Move  WE-Contract-Type        To    W-DB-Contract-Type       04530000
      *                                                                 04540000
           Move  WE-Contract-No          To    W-DB-Contract-No         04550000
      *                                                                 04560000
           Move  WE-CA-Currency          To    W-DB-CA-Currency         04570000
           Move  WE-From-PA-Seq-No       To    W-DB-From-PA-Seq-No      04580000
           Move  WE-To-PA-Seq-No         To    W-DB-To-PA-Seq-No        04590000
      *                                                                 04600000
           If  WE-Fin-Inst-No            Not = Space                    04610000
           and W-DB-Fin-Inst-ID          =     +0                       04620000
               Move  WE-Fin-Inst-No      To    W-Fin-Inst-No            04630000
               Perform N100-Fetch-Fin-Inst-ID                           04640000
               Move  W-Fin-Inst-ID       To    W-DB-Fin-Inst-ID         04650000
           End-If                                                       04660000
      *                                                                 04670000
           Move  WE-Status               To    W-DB-Status              04680000
      *                                                                 04690000
           .                                                            04700000
      *################################################################.04710000
       D300-Select-Cursor                Section.                       04720000
      *                                                                 04730000
      * We choose which cursor to use, depending on the qualification.  04740000
      *                                                                 04750000
           Move  Space                   To    SW-Cursor-Code           04760000
      *                                                                 04770000
           If  W-DB-Fin-Inst-ID          Not = +0                       04780000
               Set  Sw-Use-Fin-Inst      To    True                     04790000
           End-If                                                       04800000
      *                                                                 04810000
           If  W-DB-Contract-Type        Not = Space                    04820000
           and W-DB-Contract-Type (1:1)  Not = '%'                      04830000
               Set   SW-Use-Contract-Type                               04840000
                                         To    True                     04850000
           End-If                                                       04860000
      *                                                                 04870000
           If  W-DB-Contract-No          Not = +0                       04880000
               Set   SW-Use-Contract-No  To    True                     04890000
           End-If                                                       04900000
      *                                                                 04910000
           If  R115IPA0-In-CA-Currency   Not = Space                    04920000
           or  R115IPA0-In-PA-Seq-No     Not = +0                       04930000
               Set  Sw-Use-Part-Amount   To    True                     04940000
           End-If                                                       04950000
      *                                                                 04960000
           If  W-DB-Status               Not = Space                    04970000
           and W-DB-Status (1:1)         Not = '%'                      04980000
               Set   SW-Use-Status       To    True                     04990000
           End-If                                                       05000000
      *                                                                 05010000
           Evaluate True                                                05020000
             When SW-Use-Fi-Asc                                         05030000
             or   SW-Use-Fi-CT-Asc                                      05040000
             or   SW-Use-Fi-CT-CN-Asc                                   05050000
             or   SW-Use-Fi-CT-CN-PA-Asc                                05060000
             or   SW-Use-Fi-St-Asc                                      05070000
             or   SW-Use-Fi-CT-St-Asc                                   05080000
               Continue                                                 05090000
      *                                                                 05100000
             When other                                                 05110000
               Initialize                      R7918030-ErrorMessage    05120000
               Move  'GL-CURSOR-UV'      To    R7918030-In-MessageCode  05130000
               Move  'VAR1'              To R7918030-In-Variable-Key (1)05140000
               Move  SW-Cursor-Code      To R7918030-In-Variable-Data(1)05150000
               Perform Z000-Error-Message                               05160000
               Move  'D302'              To    R7919999-Paragraph       05170000
               Perform Z900-Abend                                       05180000
      *                                                                 05190000
           End-Evaluate                                                 05200000
      *                                                                 05210000
           .                                                            05220000
      *################################################################.05230000
       D400-Count-Cursor                 Section.                       05240000
      *                                                                 05250000
           Initialize                          R115IPAS-SQL-Submodules  05260000
           Set   R115IPAS-Version        To    True                     05270000
           Set   R115IPAS-In-Count-Cursor                               05280000
                                         To    True                     05290000
           Move  R115IPA0-In-Table-Version                              05300000
                                         To    R115IPAS-In-Table-Version05310000
           Move  Sw-Cursor-Code          To    R115IPAS-Cursor-Code     05320000
           Move  W-DB-Key                To    R115IPAS-DB-Key          05330000
      *                                                                 05340000
           Call  'F115IPAR'              Using R115IPAS-SQL-Submodules  05350000
                                               DCLTF-Part-Amount        05360000
                                               R7919999-Error-Area      05370000
           End-Call                                                     05380000
      *                                                                 05390000
           Evaluate True                                                05400000
             When R7919999-Return-OK                                    05410000
               Move  R115IPAS-Out-Total-Rows                            05420000
                                         To    WC-Total-No-Of-Rows      05430000
      *                                                                 05440000
             When other                                                 05450000
               Move  'D401'              To    R7919999-Paragraph       05460000
               Perform Z900-Abend                                       05470000
      *                                                                 05480000
           End-Evaluate                                                 05490000
      *                                                                 05500000
           .                                                            05510000
      *################################################################.05520000
       D500-Open-Cursor                  Section.                       05530000
      *                                                                 05540000
           Initialize                          R115IPAS-SQL-Submodules  05550000
           Set   R115IPAS-Version        To    True                     05560000
           Set   R115IPAS-In-Open-Cursor To    True                     05570000
           Move  R115IPA0-In-Table-Version                              05580000
                                         To    R115IPAS-In-Table-Version05590000
           Move  Sw-Cursor-Code          To    R115IPAS-Cursor-Code     05600000
           Move  W-DB-Key                To    R115IPAS-DB-Key          05610000
      *                                                                 05620000
           Call  'F115IPAR'              Using R115IPAS-SQL-Submodules  05630000
                                               DCLTF-Part-Amount        05640000
                                               R7919999-Error-Area      05650000
           End-Call                                                     05660000
      *                                                                 05670000
           Evaluate True                                                05680000
             When R7919999-Return-OK                                    05690000
               Set   WS-Cursor-OK        To    True                     05700000
      *                                                                 05710000
             When other                                                 05720000
               Move  'D501'              To    R7919999-Paragraph       05730000
               Perform Z900-Abend                                       05740000
      *                                                                 05750000
           End-Evaluate                                                 05760000
      *                                                                 05770000
           .                                                            05780000
      *################################################################.05790000
       E000-Get-Next                     Section.                       05800000
      *                                                                 05810000
           Perform D100-Prepare-Input                                   05820000
           Perform E100-Check-Qualification                             05830000
           Perform E200-Fetch-Cursor                                    05840000
      *                                                                 05850000
           If  R7919999-Return-OK                                       05860000
               Perform L100-Store-DCL                                   05870000
               Perform J000-Get-Columns                                 05880000
           End-If                                                       05890000
      *                                                                 05900000
           .                                                            05910000
      *################################################################.05920000
       E100-Check-Qualification          Section.                       05930000
      *                                                                 05940000
      * We use the WE-fields for comparison with the WS-fields.         05950000
      * This to verify that the qualification has not changes since     05960000
      * the Get-1st.                                                    05970000
      *                                                                 05980000
           Evaluate True                                                05990000
             When WE-Key                 =     WS-Key                   06000000
             and  WE-Code-Sequence       =     WS-Code-Sequence         06010000
             and  WS-Cursor-OK                                          06020000
               Continue                                                 06030000
      *                                                                 06040000
             When WE-Key                 =     WS-Key                   06050000
             and  WE-Code-Sequence       =     WS-Code-Sequence         06060000
             and  WS-Cursor-End                                         06070000
               Initialize                      R7918030-ErrorMessage    06080000
               Move  'DB-LEST-SISTE'     To    R7918030-In-MessageCode  06090000
               Move  'VAR1'              To R7918030-In-Variable-Key (1)06100000
               Move  W-Table-Name        To R7918030-In-Variable-Data(1)06110000
               Perform Z000-Error-Message                               06120000
               Move  'E101'              To    R7919999-Paragraph       06130000
               Perform Z900-Abend                                       06140000
      *                                                                 06150000
             When Other                                                 06160000
               Initialize                      R7918030-ErrorMessage    06170000
               Move  'GL-BRUK-GET-1ST'   To    R7918030-In-MessageCode  06180000
               Perform Z000-Error-Message                               06190000
               Move  'E102'              To    R7919999-Paragraph       06200000
               Perform Z900-Abend                                       06210000
      *                                                                 06220000
           End-Evaluate                                                 06230000
      *                                                                 06240000
           .                                                            06250000
      *################################################################.06260000
       E200-Fetch-Cursor                 Section.                       06270000
      *                                                                 06280000
           Initialize                          R115IPAS-SQL-Submodules  06290000
           Set   R115IPAS-Version        To    True                     06300000
           Set   R115IPAS-In-Fetch-Cursor                               06310000
                                         To    True                     06320000
           Move  R115IPA0-In-Table-Version                              06330000
                                         To    R115IPAS-In-Table-Version06340000
           Move  Sw-Cursor-Code          To    R115IPAS-Cursor-Code     06350000
           Move  W-DB-Key                To    R115IPAS-DB-Key          06360000
      *                                                                 06370000
           Call  'F115IPAR'              Using R115IPAS-SQL-Submodules  06380000
                                               DCLTF-Part-Amount        06390000
                                               R7919999-Error-Area      06400000
           End-Call                                                     06410000
      *                                                                 06420000
           Evaluate True                                                06430000
             When R7919999-Return-OK                                    06440000
               Add   +1                  To    WC-Row-No                06450000
      *                                                                 06460000
             When R7919999-Return-Error                                 06470000
               Set   WS-Cursor-End       To    True                     06480000
               If  WC-Row-No             =     +0                       06490000
                 Then                                                   06500000
                   Initialize                  R7918030-ErrorMessage    06510000
                   Move  'DB-FOREKOMST-NF'                              06520000
                                         To    R7918030-In-MessageCode  06530000
                   Move  'VAR1'          To R7918030-In-Variable-Key (1)06540000
                   Move  W-Table-Name    To R7918030-In-Variable-Data(1)06550000
                   Perform Z000-Error-Message                           06560000
                 Else                                                   06570000
                   Initialize                  R7918030-ErrorMessage    06580000
                   Move  'DB-LEST-SISTE' To    R7918030-In-MessageCode  06590000
                   Move  'VAR1'          To R7918030-In-Variable-Key (1)06600000
                   Move  W-Table-Name    To R7918030-In-Variable-Data(1)06610000
                   Perform Z000-Error-Message                           06620000
               End-If                                                   06630000
      *                                                                 06640000
             When other                                                 06650000
               Move  'E201'              To    R7919999-Paragraph       06660000
               Perform Z900-Abend                                       06670000
      *                                                                 06680000
           End-Evaluate                                                 06690000
      *                                                                 06700000
           .                                                            06710000
      *################################################################.06720000
       F000-Select                       Section.                       06730000
      *                                                                 06740000
           Perform F100-Prepare-Qualification                           06750000
      *                                                                 06760000
      * We will first look through the storage, to see if we have       06770000
      * already got the wanted occurence.                               06780000
      *                                                                 06790000
           Perform L200-Find-DCL                                        06800000
      *                                                                 06810000
      * If we didn't find anything, we need to read. Then we store.     06820000
      *                                                                 06830000
           If  Ind-WS                    >     W-Max-Occ-WS-Tab         06840000
           or  WS-DB2-Not-Read (Ind-WS)                                 06850000
               Perform F200-Select-Row                                  06860000
               Perform L100-Store-DCL                                   06870000
           End-If                                                       06880000
      *                                                                 06890000
      * At last we check what we've got to offer.                       06900000
      *                                                                 06910000
           Evaluate True                                                06920000
             When WS-DB2-Read (Ind-WS)                                  06930000
               Move  WS-DB2-DCL (Ind-WS) To    DCLTF-Part-Amount        06940000
               Perform J000-Get-Columns                                 06950000
      *                                                                 06960000
             When other                                                 06970000
               Initialize                      R7918030-ErrorMessage    06980000
               Move  'DB-FOREKOMST-NF-Q' To    R7918030-In-MessageCode  06990000
               Move  'VAR1'              To R7918030-In-Variable-Key (1)07000000
               Move  W-Table-Name        To R7918030-In-Variable-Data(1)07010000
               Move  'VAR2'              To R7918030-In-Variable-Key (2)07020000
               Move  FK-OAKO-FinInst-ID  To WD-Fin-Inst-ID              07030000
               Move  FK-TFMC-Contr-No    To WD-Contract-No              07040000
               Move  TFPA-Seq-No         To WD-PA-Seq-No                07050000
               String WD-Fin-Inst-ID           Delimited by size        07060000
                      '/'                      Delimited by size        07070000
                      FK-TFMC-Contr-Type       Delimited by space       07080000
                      WD-Contract-No           Delimited by size        07090000
                      '/'                      Delimited by size        07100000
                      FK-TFCA-Currency         Delimited by space       07110000
                      WD-PA-Seq-No             Delimited by size        07120000
                                       Into R7918030-In-Variable-Data(2)07130000
               End-String                                               07140000
               Perform Z000-Error-Message                               07150000
               Set   R7919999-Return-Error                              07160000
                                         To    True                     07170000
      *                                                                 07180000
           End-Evaluate                                                 07190000
      *                                                                 07200000
           .                                                            07210000
      *################################################################.07220000
       F100-Prepare-Qualification        Section.                       07230000
      *                                                                 07240000
      * We fill in the host variables for the SQL.                      07250000
      *                                                                 07260000
           Initialize                          DCLTF-Part-Amount        07270000
      *                                                                 07280000
           Move  R115IPA0-In-Fin-Inst-ID To    FK-OAKO-FinInst-ID       07290000
           Move  R115IPA0-In-Contract-Type                              07300000
                                         To    FK-TFMC-Contr-Type       07310000
           Move  R115IPA0-In-Contract-No To    FK-TFMC-Contr-No         07320000
      *                                                                 07330000
           Move  R115IPA0-In-CA-Currency To    FK-TFCA-Currency         07340000
           Move  R115IPA0-In-PA-Seq-No   To    TFPA-Seq-No              07350000
      *                                                                 07360000
           If  R115IPA0-In-Fin-Inst-No   Not = Space                    07370000
           and R115IPA0-In-Fin-Inst-ID   =     +0                       07380000
               Move  R115IPA0-In-Fin-Inst-No                            07390000
                                         To    W-Fin-Inst-No            07400000
               Perform N100-Fetch-Fin-Inst-ID                           07410000
               Move  W-Fin-Inst-ID       To    FK-OAKO-FinInst-ID       07420000
           End-If                                                       07430000
      *                                                                 07440000
           .                                                            07450000
      *################################################################.07460000
       F200-Select-Row                   Section.                       07470000
      *                                                                 07480000
           Initialize                          R115IPAS-SQL-Submodules  07490000
           Set   R115IPAS-Version        To    True                     07500000
           Set   R115IPAS-In-Select      To    True                     07510000
           Move  R115IPA0-In-Table-Version                              07520000
                                         To    R115IPAS-In-Table-Version07530000
      *                                                                 07540000
           Call  'F115IPAR'              Using R115IPAS-SQL-Submodules  07550000
                                               DCLTF-Part-Amount        07560000
                                               R7919999-Error-Area      07570000
           End-Call                                                     07580000
      *                                                                 07590000
           Evaluate True                                                07600000
             When R7919999-Return-OK                                    07610000
               Continue                                                 07620000
      *                                                                 07630000
             When R7919999-Return-Error                                 07640000
               Continue                                                 07650000
      *                                                                 07660000
             When other                                                 07670000
               Move  'F201'              To    R7919999-Paragraph       07680000
               Perform Z900-Abend                                       07690000
      *                                                                 07700000
           End-Evaluate                                                 07710000
      *                                                                 07720000
           .                                                            07730000
      *################################################################.07740000
       G000-Insert                       Section.                       07750000
      *                                                                 07760000
           Perform G100-Move-Input-To-DCL                               07770000
           Perform G200-Insert-Row                                      07780000
      *                                                                 07790000
           Perform L300-Remove-DCL                                      07800000
