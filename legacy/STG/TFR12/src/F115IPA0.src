           Set   R7919100-In-Konv-Fra-AMD9                              08140000
                                         To    True                     08150000
           Set   R7919100-In-Konv-Til-DB2                               08160000
                                         To    True                     08170000
           Call  'F7919100'              Using R7919100-Konverter-Dato  08180000
                                               R7919999-Error           08190000
           End-Call                                                     08200000
           If  Not R7919999-Retur-OK                                    08210000
               Move  'G101'              To    R7919999-Paragraf        08220000
               Perform Z900-Abend                                       08230000
           End-If                                                       08240000
           Move  R7919100-Ut-Dato-DB2    To    TFPA-Register-Date       08250000
      *                                                                 08260000
           Move R115IPA0-User-ID         To    TFPA-User-ID             08270000
           Move R115IPA0-Amount          To    TFPA-Part-Amount         08280000
           Move R115IPA0-Prev-Amount     To    TFPA-Prev-P-Amount       08290000
           Move R115IPA0-Curr-Amount     To    TFPA-Curr-P-Amount       08300000
           Move R115IPA0-Excess-Amount   To    TFPA-Excess-Amount       08310000
           Move R115IPA0-Incom-Swift     To    TFPA-Incom-Swift         08320000
           Move R115IPA0-Availability    To    TFPA-Availability        08330000
      *                                                                 08340000
           Initialize                          R7919100-Konverter-Dato  08350000
           Set   R7919100-Versjon        To    True                     08360000
           Move  R115IPA0-Accept-Date    To    R7919100-In-Dato-AMD9    08370000
           Set   R7919100-In-Konv-Fra-AMD9                              08380000
                                         To    True                     08390000
           Set   R7919100-In-Konv-Til-DB2                               08400000
                                         To    True                     08410000
           Call  'F7919100'              Using R7919100-Konverter-Dato  08420000
                                               R7919999-Error           08430000
           End-Call                                                     08440000
           If  Not R7919999-Retur-OK                                    08450000
               Move  'G102'              To    R7919999-Paragraf        08460000
               Perform Z900-Abend                                       08470000
           End-If                                                       08480000
           Move  R7919100-Ut-Dato-DB2    To    TFPA-Accept-Date         08490000
      *                                                                 08500000
           .                                                            08510000
      *################################################################.08520000
       G200-Insert-Row                   Section.                       08530000
      *                                                                 08540000
           Initialize                          R115IPAS-SQL-Submodules  08550000
           Set   R115IPAS-Version        To    True                     08560000
           Set   R115IPAS-In-Insert      To    True                     08570000
           Move  R115IPA0-In-Table-Version                              08580000
                                         To    R115IPAS-In-Table-Version08590000
      *                                                                 08600000
           Call  'F115IPAU'              Using R115IPAS-SQL-Submodules  08610000
                                               DCLTF-Part-Amount        08620000
                                               R7919999-Error-Area      08630000
           End-Call                                                     08640000
      *                                                                 08650000
