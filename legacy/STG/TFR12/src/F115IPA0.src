             88  SW-Use-Fi-CT-CN-Asc                Value 'FTN  '.      01290000
             88  SW-Use-Fi-CT-CN-PA-Asc             Value 'FTNP '.      01300000
             88  SW-Use-Fi-St-Asc                   Value 'F   S'.      01310000
             88  SW-Use-Fi-CT-St-Asc                Value 'FT  S'.      01320000
