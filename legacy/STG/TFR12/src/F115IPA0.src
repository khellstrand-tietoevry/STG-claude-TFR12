      *################################################################.08800000
       H000-Update                       Section.                       08810000
      *                                                                 08820000
           Perform H100-Check-Qualification                             08830000
           Perform G100-Move-Input-To-DCL                               08840000
      *                                                                 08850000
           Perform H200-Update-Row                                      08860000
      *                                                                 08870000
           Perform L300-Remove-DCL                                      08880000
           Perform L100-Store-DCL                                       08890000
      *                                                                 08900000
           .                                                            08910000
      *################################################################.08920000
       H100-Check-Qualification          Section.                       08930000
      *                                                                 08940000
           Evaluate True                                                08950000
             When R115IPA0-Fin-Inst-ID   Not = +0                       08960000
               Continue                                                 08970000
                                                                        08980000
             When R115IPA0-Fin-Inst-No   Not = Space                    08990000
               Move  R115IPA0-Fin-Inst-No                               09000000
                                         To    W-Fin-Inst-No            09010000
               Perform N100-Fetch-Fin-Inst-ID                           09020000
               Move  W-Fin-Inst-ID       To    R115IPA0-Fin-Inst-ID     09030000
                                                                        09040000
             When R115IPA0-In-Fin-Inst-Id Not = +0                      09050000
               Move R115IPA0-In-Fin-Inst-ID                             09060000
                                         To    R115IPA0-Fin-Inst-ID     09070000
                                                                        09080000
             When R115IPA0-In-Fin-Inst-No                               09090000
                                         Not = Space                    09100000
               Move  R115IPA0-In-Fin-Inst-No                            09110000
                                         To    W-Fin-Inst-No            09120000
               Perform N100-Fetch-Fin-Inst-ID                           09130000
               Move  W-Fin-Inst-ID       To    R115IPA0-Fin-Inst-ID     09140000
                                                                        09150000
             When other                                                 09160000
               Initialize                      R7918030-ErrorMessage    09170000
               Move  'TF-FIN-INST-MISSING'                              09180000
                                         To    R7918030-In-MessageCode  09190000
               Perform Z000-Error-Message                               09200000
               Set   R7919999-Return-Error                              09210000
                                         To    True                     09220000
                                                                        09230000
           End-Evaluate                                                 09240000
      *                                                                 09250000
           Evaluate True                                                09260000
             When R115IPA0-Contract-Type Not = Space                    09270000
               Continue                                                 09280000
                                                                        09290000
             When R115IPA0-In-Contract-Type                             09300000
                                         Not = Space                    09310000
               Move R115IPA0-In-Contract-Type                           09320000
                                         To    R115IPA0-Contract-Type   09330000
                                                                        09340000
             When other                                                 09350000
               Initialize                      R7918030-ErrorMessage    09360000
               Move  'TF-CONTRACT-MISSING'                              09370000
                                         To    R7918030-In-MessageCode  09380000
               Perform Z000-Error-Message                               09390000
               Set   R7919999-Return-Error                              09400000
                                         To    True                     09410000
                                                                        09420000
           End-Evaluate                                                 09430000
      *                                                                 09440000
           Evaluate True                                                09450000
             When R115IPA0-Contract-No   Not = +0                       09460000
               Continue                                                 09470000
                                                                        09480000
             When R115IPA0-In-Contract-No                               09490000
                                         Not = +0                       09500000
               Move R115IPA0-In-Contract-No                             09510000
                                         To    R115IPA0-Contract-No     09520000
                                                                        09530000
             When other                                                 09540000
               Initialize                      R7918030-ErrorMessage    09550000
               Move  'TF-CONTRACT-MISSING'                              09560000
                                         To    R7918030-In-MessageCode  09570000
               Perform Z000-Error-Message                               09580000
               Set   R7919999-Return-Error                              09590000
                                         To    True                     09600000
                                                                        09610000
           End-Evaluate                                                 09620000
      *                                                                 09630000
           Evaluate True                                                09640000
             When R115IPA0-CA-Currency   Not = Space                    09650000
               Continue                                                 09660000
                                                                        09670000
             When R115IPA0-In-CA-Currency                               09680000
                                         Not = Space                    09690000
               Move R115IPA0-In-CA-Currency                             09700000
                                         To    R115IPA0-CA-Currency     09710000
                                                                        09720000
             When other                                                 09730000
               Initialize                      R7918030-ErrorMessage    09740000
               Move  'TF-PART-AMOUNT-MISSING'                           09750000
                                         To    R7918030-In-MessageCode  09760000
               Perform Z000-Error-Message                               09770000
               Set   R7919999-Return-Error                              09780000
                                         To    True                     09790000
                                                                        09800000
           End-Evaluate                                                 09810000
      *                                                                 09820000
           Evaluate True                                                09830000
             When R115IPA0-PA-Seq-No     Not = +0                       09840000
               Continue                                                 09850000
                                                                        09860000
             When R115IPA0-In-PA-Seq-No  Not = +0                       09870000
               Move R115IPA0-In-PA-Seq-No                               09880000
                                         To    R115IPA0-PA-Seq-No       09890000
                                                                        09900000
             When other                                                 09910000
               Initialize                      R7918030-ErrorMessage    09920000
               Move  'TF-PART-AMOUNT-MISSING'                           09930000
                                         To    R7918030-In-MessageCode  09940000
               Perform Z000-Error-Message                               09950000
               Set   R7919999-Return-Error                              09960000
                                         To    True                     09970000
                                                                        09980000
           End-Evaluate                                                 09990000
      *                                                                 10000000
           .                                                            10010000
      *################################################################.10020000
       H200-Update-Row                   Section.                       10030000
      *                                                                 10040000
           Initialize                          R115IPAS-SQL-Submodules  10050000
           Set   R115IPAS-Version        To    True                     10060000
           Set   R115IPAS-In-Update      To    True                     10070000
           Move  R115IPA0-In-Table-Version                              10080000
                                         To    R115IPAS-In-Table-Version10090000
      *                                                                 10100000
           Call  'F115IPAU'              Using R115IPAS-SQL-Submodules  10110000
                                               DCLTF-Part-Amount        10120000
                                               R7919999-Error-Area      10130000
           End-Call                                                     10140000
      *                                                                 10150000
           Evaluate True                                                10160000
             When R7919999-Return-OK                                    10170000
               Continue                                                 10180000
      *                                                                 10190000
             When R7919999-Return-Error                                 10200000
               Continue                                                 10210000
      *                                                                 10220000
             When other                                                 10230000
               Move  'H201'              To    R7919999-Paragraph       10240000
               Perform Z900-Abend                                       10250000
      *                                                                 10260000
           End-Evaluate                                                 10270000
      *                                                                 10280000
           .                                                            10290000
      *################################################################.10300000
       I000-Delete                       Section.                       10310000
      *                                                                 10320000
           Perform F100-Prepare-Qualification                           10330000
           Perform I200-Delete-Row                                      10340000
      *                                                                 10350000
           Perform L300-Remove-DCL                                      10360000
      *                                                                 10370000
           .                                                            10380000
      *################################################################.10390000
       I200-Delete-Row                   Section.                       10400000
      *                                                                 10410000
           Initialize                          R115IPAS-SQL-Submodules  10420000
           Set   R115IPAS-Version        To    True                     10430000
           Set   R115IPAS-In-Delete      To    True                     10440000
           Move  R115IPA0-In-Table-Version                              10450000
                                         To    R115IPAS-In-Table-Version10460000
      *                                                                 10470000
           Call  'F115IPAU'              Using R115IPAS-SQL-Submodules  10480000
                                               DCLTF-Part-Amount        10490000
                                               R7919999-Error-Area      10500000
           End-Call                                                     10510000
      *                                                                 10520000
           Evaluate True                                                10530000
             When R7919999-Return-OK                                    10540000
               Continue                                                 10550000
      *                                                                 10560000
             When R7919999-Return-Error                                 10570000
               Continue                                                 10580000
      *                                                                 10590000
             When other                                                 10600000
               Move  'I201'              To    R7919999-Paragraph       10610000
               Perform Z900-Abend                                       10620000
      *                                                                 10630000
           End-Evaluate                                                 10640000
      *                                                                 10650000
           .                                                            10660000
      *################################################################.10670000
       J000-Get-Columns                  Section.                       10680000
      *                                                                 10690000
           Perform J100-Move-DCL-To-Output                              10700000
      *                                                                 10710000
           .                                                            10720000
      *################################################################.10730000
       J100-Move-DCL-To-Output           Section.                       10740000
      *                                                                 10750000
           Move  FK-OAKO-FinInst-ID      To    R115IPA0-Fin-Inst-ID     10760000
           Move  FK-TFMC-Contr-Type      To    R115IPA0-Contract-Type   10770000
           Move  FK-TFMC-Contr-No        To    R115IPA0-Contract-No     10780000
           Move  FK-TFCA-Currency        To    R115IPA0-CA-Currency     10790000
           Move  TFPA-Seq-No             To    R115IPA0-PA-Seq-No       10800000
      *                                                                 10810000
           Move  TFPA-Status             To    R115IPA0-Status          10820000
           Move  TFPA-In-Progress        To    R115IPA0-In-Progress     10830000
      *                                                                 10840000
           Initialize                          R7919100-Konverter-Dato  10850000
           Set   R7919100-Versjon        To    True                     10860000
           Move  TFPA-Register-Date      To    R7919100-In-Dato-DB2     10870000
           Set   R7919100-In-Konv-Fra-DB2                               10880000
                                         To    True                     10890000
           Set   R7919100-In-Konv-Til-AMD9                              10900000
                                         To    True                     10910000
           Call  'F7919100'              Using R7919100-Konverter-Dato  10920000
                                               R7919999-Error           10930000
           End-Call                                                     10940000
           If  Not R7919999-Retur-OK                                    10950000
               Move  'J101'              To    R7919999-Paragraf        10960000
               Perform Z900-Abend                                       10970000
           End-If                                                       10980000
           Move  R7919100-Ut-Dato-AMD9   To    R115IPA0-Register-Date   10990000
      *                                                                 11000000
           Move  TFPA-User-ID            To    R115IPA0-User-ID         11010000
           Move  TFPA-Part-Amount        To    R115IPA0-Amount          11020000
           Move  TFPA-Prev-P-Amount      To    R115IPA0-Prev-Amount     11030000
           Move  TFPA-Curr-P-Amount      To    R115IPA0-Curr-Amount     11040000
           Move  TFPA-Excess-Amount      To    R115IPA0-Excess-Amount   11050000
           Move  TFPA-Incom-Swift        To    R115IPA0-Incom-Swift     11060000
           Move  TFPA-Availability       To    R115IPA0-Availability    11070000
      *                                                                 11080000
           Initialize                          R7919100-Konverter-Dato  11090000
           Set   R7919100-Versjon        To    True                     11100000
           Move  TFPA-Accept-Date        To    R7919100-In-Dato-DB2     11110000
           Set   R7919100-In-Konv-Fra-DB2                               11120000
                                         To    True                     11130000
           Set   R7919100-In-Konv-Til-AMD9                              11140000
                                         To    True                     11150000
           Call  'F7919100'              Using R7919100-Konverter-Dato  11160000
                                               R7919999-Error           11170000
           End-Call                                                     11180000
           If  Not R7919999-Retur-OK                                    11190000
               Move  'J102'              To    R7919999-Paragraf        11200000
               Perform Z900-Abend                                       11210000
           End-If                                                       11220000
           Move  R7919100-Ut-Dato-AMD9   To    R115IPA0-Accept-Date     11230000
      *                                                                 11240000
           Move  FK-OAKO-FinInst-ID      To    W-Fin-Inst-ID            11250000
           Perform N200-Fetch-Fin-Inst-No                               11260000
           Move  W-Fin-Inst-No           To    R115IPA0-Fin-Inst-No     11270000
      *                                                                 11280000
      * Info about the cursor:                                          11290000
      *                                                                 11300000
           Move  WC-Row-No               To  R115IPA0-Out-Row-No        11310000
           Move  WC-Total-No-Of-Rows     To  R115IPA0-Out-Total-Rows    11320000
      *                                                                 11330000
           .                                                            11340000
      *################################################################.11350000
       L100-Store-DCL                    Section.                       11360000
      *                                                                 11370000
      * We might already have this row in storage.                      11380000
      *                                                                 11390000
           Perform L200-Find-DCL                                        11400000
      *                                                                 11410000
           If  Ind-WS                    >     W-Max-Occ-WS-Tab         11420000
           or  WS-DB2-Not-Read (Ind-WS)                                 11430000
             Then                                                       11440000
      *        If we have reached the end of the storage-table,         11450000
      *        we start on the beginning.                               11460000
      *        This way, we always keep the "newest" occurrences.       11470000
               Add   +1                  To    Ind-WS-Put               11480000
               If  Ind-WS-Put            >     W-Max-Occ-WS-Tab         11490000
                   Move  +1              To    Ind-WS-Put               11500000
               End-If                                                   11510000
               Move  Ind-WS-Put          To    Ind-WS                   11520000
             Else                                                       11530000
               Move  Ind-WS              To    Ind-WS-Put               11540000
           End-If                                                       11550000
      *                                                                 11560000
      * We store the identification.                                    11570000
      *                                                                 11580000
           Move  R115IPA0-In-Table-Version                              11590000
                                         To    WS-DB2-Tbl-Version       11600000
                                                            (Ind-WS-Put)11610000
           Move  FK-OAKO-FinInst-ID      To    WS-DB2-Fin-Inst-ID       11620000
                                                            (Ind-WS-Put)11630000
           Move  FK-TFMC-Contr-Type      To    WS-DB2-Contract-Type     11640000
                                                            (Ind-WS-Put)11650000
           Move  FK-TFMC-Contr-No        To    WS-DB2-Contract-No       11660000
                                                            (Ind-WS-Put)11670000
           Move  FK-TFCA-Currency        To    WS-DB2-CA-Currency       11680000
                                                            (Ind-WS-Put)11690000
           Move  TFPA-Seq-No             To    WS-DB2-PA-Seq-No         11700000
                                                            (Ind-WS-Put)11710000
      *                                                                 11720000
      * The DCL is stored if found, the status is set.                  11730000
      *                                                                 11740000
           Evaluate True                                                11750000
             When Length                 Of    DCLTF-Part-Amount        11760000
                > Length                 Of    WS-DB2-DCL               11770000
               Move  Length              Of    DCLTF-Part-Amount        11780000
                                         To    WD-Length                11790000
               Initialize                      R7918030-ErrorMessage    11800000
               Move  'GL-WL-DCL-UTVIDES' To    R7918030-In-MessageCode  11810000
               Move  'VAR1'              To R7918030-In-Variable-Key (1)11820000
               Move  WD-Length           To R7918030-In-Variable-Data(1)11830000
               Perform Z000-Error-Message                               11840000
               Move  'L101'              To    R7919999-Paragraph       11850000
               Perform Z900-Abend                                       11860000
      *                                                                 11870000
             When R7919999-Return-Error                                 11880000
               Set   WS-DB2-Not-Found (Ind-WS-Put)                      11890000
                                         To    True                     11900000
      *                                                                 11910000
             When other                                                 11920000
               Move  DCLTF-Part-Amount                                  11930000
                                         To    WS-DB2-DCL   (Ind-WS-Put)11940000
               Set   WS-DB2-Read (Ind-WS-Put)                           11950000
                                         To    True                     11960000
      *                                                                 11970000
           End-Evaluate                                                 11980000
      *                                                                 11990000
           .                                                            12000000
      *################################################################.12010000
       L200-Find-DCL                     Section.                       12020000
      *                                                                 12030000
           Perform Varying Ind-WS                                       12040000
                   From  +1              By    +1                       12050000
                   Until Ind-WS          >     W-Max-Occ-WS-Tab         12060000
                   or  ( WS-DB2-Tbl-Version (Ind-WS)                    12070000
                                         =     R115IPA0-In-Table-Version12080000
                     and WS-DB2-Fin-Inst-ID (Ind-WS)                    12090000
                                         =     FK-OAKO-FinInst-ID       12100000
                     and WS-DB2-Contract-Type (Ind-WS)                  12110000
                                         =     FK-TFMC-Contr-Type       12120000
                     and WS-DB2-Contract-No (Ind-WS)                    12130000
                                         =     FK-TFMC-Contr-No         12140000
                     and WS-DB2-CA-Currency (Ind-WS)                    12150000
                                         =     FK-TFCA-Currency         12160000
                     and WS-DB2-PA-Seq-No (Ind-WS)                      12170000
                                         =     TFPA-Seq-No )            12180000
           End-Perform                                                  12190000
      *                                                                 12200000
           .                                                            12210000
      *################################################################*12220000
       L300-Remove-DCL                   Section.                       12230000
      *                                                                 12240000
           Perform Varying Ind-WS                                       12250000
                   From  +1              By    +1                       12260000
                   Until Ind-WS          >     W-Max-Occ-WS-Tab         12270000
                   or  ( WS-DB2-Tbl-Version (Ind-WS)                    12280000
                                         =     R115IPA0-In-Table-Version12290000
                     and WS-DB2-Fin-Inst-ID (Ind-WS)                    12300000
                                         =     FK-OAKO-FinInst-ID       12310000
                     and WS-DB2-Contract-Type (Ind-WS)                  12320000
                                         =     FK-TFMC-Contr-Type       12330000
                     and WS-DB2-Contract-No (Ind-WS)                    12340000
                                         =     FK-TFMC-Contr-No         12350000
                     and WS-DB2-CA-Currency (Ind-WS)                    12360000
                                         =     FK-TFCA-Currency         12370000
                     and WS-DB2-PA-Seq-No (Ind-WS)                      12380000
                                         =     TFPA-Seq-No )            12390000
           End-Perform                                                  12400000
      *                                                                 12410000
           Evaluate True                                                12420000
             When Ind-WS                 >     W-Max-Occ-WS-Tab         12430000
               Continue                                                 12440000
      *                                                                 12450000
             When other                                                 12460000
               Initialize                      WS-DB2-Row (Ind-WS)      12470000
      *                                                                 12480000
           End-Evaluate                                                 12490000
      *                                                                 12500000
           .                                                            12510000
      *################################################################*12520000
       N100-Fetch-Fin-Inst-ID            Section.                       12530000
      *                                                                 12540000
           Move  W-Fin-Inst-No (1:4)     To    W-Tmp-Konsern-Nr         12550000
      *                                                                 12560000
           If  Not R5879010-Versjon                                     12570000
           or  R5879010-In-Konsernnr     Not = W-Tmp-Konsern-Nr         12580000
      *                                                                 12590000
               Initialize                      R5879010-Konsern         12600000
               Set   R5879010-Versjon    To    True                     12610000
               Set   R5879010-In-Select  To    True                     12620000
               Move  W-Tmp-Konsern-Nr    To    R5879010-In-Konsernnr    12630000
               Call  'F5879010'          Using R5879010-Konsern         12640000
                                               R7919999-Error-Area      12650000
               End-Call                                                 12660000
               If  Not R7919999-Return-OK                               12670000
                   Move  'N101'          To    R7919999-Paragraph       12680000
                   Perform Z900-Abend                                   12690000
               End-If                                                   12700000
      *                                                                 12710000
           End-If                                                       12720000
      *                                                                 12730000
           Move  R5879010-Ut-KO-Konsern-Id                              12740000
                                         To    W-Fin-Inst-ID            12750000
      *                                                                 12760000
           .                                                            12770000
      *################################################################*12780000
       N200-Fetch-Fin-Inst-No            Section.                       12790000
      *                                                                 12800000
           If  Not R5879010-Versjon                                     12810000
           or  R5879010-In-Konsern-ID    Not = W-Fin-Inst-ID            12820000
      *                                                                 12830000
               Initialize                      R5879010-Konsern         12840000
               Set   R5879010-Versjon    To    True                     12850000
               Set   R5879010-In-Select  To    True                     12860000
               Move  W-Fin-Inst-ID       To    R5879010-In-Konsern-ID   12870000
               Call  'F5879010'          Using R5879010-Konsern         12880000
                                               R7919999-Error-Area      12890000
               End-Call                                                 12900000
               If  Not R7919999-Return-OK                               12910000
                   Move  'N201'          To    R7919999-Paragraph       12920000
                   Perform Z900-Abend                                   12930000
               End-If                                                   12940000
      *                                                                 12950000
           End-If                                                       12960000
      *                                                                 12970000
           Move  R5879010-Ut-KO-Konsernnummer                           12980000
                                         To    W-Tmp-Konsern-Nr         12990000
           Move  W-Tmp-Konsern-Nr        To    W-Fin-Inst-No            13000000
      *                                                                 13010000
           .                                                            13020000
      *################################################################*13030000
       ZI00-Conv-Input-Version           Section.                       13040000
      *                                                                 13050000
      * Version control.                                                13060000
      * If conversion is needed, we call the conversion module.         13070000
      *                                                                 13080000
           Set   R115IPA0-Version        To    True                     13090000
           Move  Length                  Of    R115IPA0-Part-Amount     13100000
                                         To    W-IO-Length              13110000
      *                                                                 13120000
           Evaluate True                                                13130000
             When L-Ext-IO-Area (1:8)    =     R115IPA0-Version-No      13140000
             and  Length                 Of    L-Ext-IO-Area            13150000
                                         Not < W-IO-Length              13160000
               Move  L-Ext-IO-Area (1:W-IO-Length)                      13170000
                                         To    W-Int-IO-Area            13180000
      *                                                                 13190000
             When Other                                                 13200000
               Call  'F115I999'                                         13210000
                   Using By Content      'F115IPA0 '                    13220000
                                         'INPUT '                       13230000
                         By Reference    L-Ext-IO-Area                  13240000
                                         W-Int-IO-Area                  13250000
                                         R7919999-Error-Area            13260000
               End-Call                                                 13270000
      *                                                                 13280000
               If  R7919999-Return-Abend                                13290000
                   Move  'ZI03'          To    R7919999-Paragraph       13300000
                   Perform Z900-Abend                                   13310000
               End-If                                                   13320000
      *                                                                 13330000
           End-Evaluate                                                 13340000
      *                                                                 13350000
           .                                                            13360000
      *################################################################*13370000
       ZO00-Conv-Output-Version          Section.                       13380000
      *                                                                 13390000
      * Version control.                                                13400000
      * If conversion is needed, we call the conversion module.         13410000
      *                                                                 13420000
           Evaluate True                                                13430000
             When L-Ext-IO-Area (1:8)    =     R115IPA0-Version-No      13440000
             and  Length                 Of    L-Ext-IO-Area            13450000
                                         Not < W-IO-Length              13460000
               Move  W-Int-IO-Area       To    L-Ext-IO-Area            13470000
                                                         (1:W-IO-Length)13480000
      *                                                                 13490000
             When Other                                                 13500000
               Call  'F115I999'                                         13510000
                   Using By Content      'F115IPA0 '                    13520000
                                         'OUTPUT '                      13530000
                         By Reference    L-Ext-IO-Area                  13540000
                                         W-Int-IO-Area                  13550000
                                         R7919999-Error-Area            13560000
               End-Call                                                 13570000
      *                                                                 13580000
               If  R7919999-Return-Abend                                13590000
                   Move  'ZO01'          To    R7919999-Paragraph       13600000
                   Perform Z900-Abend                                   13610000
               End-If                                                   13620000
      *                                                                 13630000
           End-Evaluate                                                 13640000
      *                                                                 13650000
           .                                                            13660000
      *################################################################*13670000
       Z000-Error-Message                Section.                       13680000
      *                                                                 13690000
           Set   R7918030-Version        To    True                     13700000
      *                                                                 13710000
           Move  'TF'                    To    R7918030-In-System-ID    13720000
           Move  R115X000-Fin-Inst-No    To    R7918030-In-Fin-Inst-No  13730000
           Move  R115X000-FI-Language-639-1                             13740000
                                         To    R7918030-In-Language     13750000
           If  R115X000-Trace-On                                        13760000
               Set   R7918030-In-Log-Yes To    True                     13770000
           End-If                                                       13780000
      *                                                                 13790000
           Call  'F7918030'              Using R7918030-ErrorMessage    13800000
           End-Call                                                     13810000
      *                                                                 13820000
           Move  R7918030-Out-MessageText                               13830000
                                         To    R7919999-Message         13840000
      *                                                                 13850000
           .                                                            13860000
      *################################################################*13870000
       Z900-Abend                        Section.                       13880000
      *                                                                 13890000
           If  R7919999-Return-Code      Not   Numeric                  13900000
           or  Not R7919999-Return-Abend                                13910000
               Move  +0                  To    R7919999-Module-Ind      13920000
           End-If                                                       13930000
      *                                                                 13940000
           Add   +1                      To    R7919999-Module-Ind      13950000
      *                                                                 13960000
           If  R7919999-Module-Ind       Not >                          13970000
                             ( Length    Of    R7919999-Module-Tab      13980000
                             / Length    Of    R7919999-Module-Element )13990000
               Move  'F115IPA0'          To    R7919999-Module-Name     14000000
                                                   (R7919999-Module-Ind)14010000
               Move  R7919999-Paragraph  To    R7919999-Module-Para     14020000
                                                   (R7919999-Module-Ind)14030000
           End-If                                                       14040000
      *                                                                 14050000
           Set   R7919999-Return-Abend   To    TRUE                     14060000
      *                                                                 14070000
           Goback.                                                      14080000
