           05  W-Max-Occ-WS-Tab          Pic S9(04)              Comp.  00830000
      *                                                                 00840000
           05  Filler.                                                  00850000
               10  WD-Fin-Inst-ID        Pic  zzzzzzzzzzzzzzzzz9.       00860000
               10  WD-Contract-No        Pic  9999999.                  00870000
               10  WD-PA-Seq-No          Pic  zzz9.                     00880000
               10  WD-TR-Seq-No          Pic  zzz9.                     00890000
      *                                                                 00900000
           05  Filler.                                                  00910000
               10  W-Fin-Inst-No         Pic  X(18).                    00920000
               10  W-Fin-Inst-ID         Pic S9(18)              Comp-3.00930000
      *                                                                 00940000
           05  W-Input-Action            Pic  X(10).                    00950000
             88  SW-IA-Initialize                   Value 'INITIALIZE'. 00960000
      *                                                                 00970000
      *    This field is needed because of the old interfaces used to   00980000
      *    access Fin-Inst-ID and Customer ID.                          00990000
           05  W-Tmp-Konsern-Nr          Pic  9(04).                    01000000
      *                                                                 01010000
      *----------------------------------------------------------------*01020000
      * Counters, used on cursor read, to return row no. and total      01030000
      * no. of rows.                                                    01040000
      * Total no. of rows is only returned when -In-Count is set on     01050000
      * the Get-1st-call.                                               01060000
      *                                                                 01070000
           05  WC-Counters.                                             01080000
               10  WC-Row-No             Pic S9(11)              Comp-3.01090000
               10  WC-Total-No-Of-Rows   Pic S9(11)              Comp-3.01100000
      *                                                                 01110000
      *----------------------------------------------------------------*01120000
      * Switches used for selecting the correct cursor:                 01130000
      *                                                                 01140000
           05  SW-Cursor-Code.                                          01150000
               10  SW-CC-Fin-Inst        Pic  X(01).                    01160000
                 88  SW-Use-Fin-Inst                Value 'F'.          01170000
               10  SW-CC-Contract        Pic  X(01).                    01180000
                 88  SW-Use-Contract                Value 'N'.          01190000
               10  SW-CC-Part-Amount     Pic  X(01).                    01200000
                 88  SW-Use-Part-Amount             Value 'P'.          01210000
               10  SW-CC-Transaction     Pic  X(01).                    01220000
                 88  SW-Use-Transaction             Value 'T'.          01230000
      *                                                                 01240000
           05  Filler                    Redefines SW-Cursor-Code       01250000
                                         Pic  X(04).                    01260000
             88  SW-Use-Fi-Asc                      Value 'F   '.       01270000
             88  SW-Use-Co-Asc                      Value ' N  '.       01280000
             88  SW-Use-Fi-Co-Asc                   Value 'FN  '.       01290000
             88  SW-Use-Fi-Co-PA-Asc                Value 'FNP '.       01300000
             88  SW-Use-Fi-Co-Tr-Asc                Value 'FN T'.       01310000
             88  SW-Use-Fi-Co-PA-Tr-Asc             Value 'FNPT'.       01320000
      *                                                                 01330000
      *----------------------------------------------------------------*01340000
      * These fields are used for SQL qualification:                    01350000
      *                                                                 01360000
           05  W-DB-Key.                                                01370000
               10  W-DB-Fin-Inst-ID      Pic S9(18)              Comp-3.01380000
               10  W-DB-Contract-Type    Pic  X(03).                    01390000
               10  W-DB-From-Contr-No    Pic S9(07)              Comp-3.01400000
               10  W-DB-To-Contr-No      Pic S9(07)              Comp-3.01410000
               10  W-DB-CA-Currency      Pic  X(03).                    01420000
               10  W-DB-From-PA-Seq-No   Pic S9(04)              Comp.  01430000
               10  W-DB-To-PA-Seq-No     Pic S9(04)              Comp.  01440000
               10  W-DB-From-TR-Seq-No   Pic S9(04)              Comp.  01450000
               10  W-DB-To-TR-Seq-No     Pic S9(04)              Comp.  01460000
      *                                                                 01470000
      *----------------------------------------------------------------*01480000
      * These fields are used for comparison with the WS-fields.        01490000
      *                                                                 01500000
           05  WE-Cursor-Info.                                          01510000
             07  WE-Key.                                                01520000
               10  WE-Fin-Inst-ID        Pic S9(18)              Comp-3.01530000
               10  WE-Fin-Inst-No        Pic  X(18).                    01540000
               10  WE-Contract-Type      Pic  X(03).                    01550000
               10  WE-From-Contr-No      Pic S9(07)              Comp-3.01560000
               10  WE-To-Contr-No        Pic S9(07)              Comp-3.01570000
               10  WE-CA-Currency        Pic  X(03).                    01580000
               10  WE-From-PA-Seq-No     Pic S9(04)              Comp.  01590000
               10  WE-To-PA-Seq-No       Pic S9(04)              Comp.  01600000
               10  WE-From-TR-Seq-No     Pic S9(04)              Comp.  01610000
               10  WE-To-TR-Seq-No       Pic S9(04)              Comp.  01620000
             07  WE-Code-Sequence        Pic  X(01).                    01630000
               88  WE-CS-Ascending                  Value 'A'.          01640000
               88  WE-CS-Descending                 Value 'D'.          01650000
      *                                                                 01660000
      *----------------------------------------------------------------*01670000
      * Storage, and switches for identifying the content:              01680000
      * The cursor info is used to verify that the get-next has the     01690000
      * same qualification as the get-1st.                              01700000
      *                                                                 01710000
       01  W-Storage.                                                   01720000
      *                                                                 01730000
           05  WS-Cursor-Info.                                          01740000
             07  WS-Key.                                                01750000
               10  WS-Fin-Inst-ID        Pic S9(18)              Comp-3.01760000
               10  WS-Fin-Inst-No        Pic  X(18).                    01770000
               10  WS-Contract-Type      Pic  X(03).                    01780000
               10  WS-From-Contr-No      Pic S9(07)              Comp-3.01790000
               10  WS-To-Contr-No        Pic S9(07)              Comp-3.01800000
               10  WS-CA-Currency        Pic  X(03).                    01810000
               10  WS-From-PA-Seq-No     Pic S9(04)              Comp.  01820000
               10  WS-To-PA-Seq-No       Pic S9(04)              Comp.  01830000
               10  WS-From-TR-Seq-No     Pic S9(04)              Comp.  01840000
               10  WS-To-TR-Seq-No       Pic S9(04)              Comp.  01850000
             07  WS-Code-Sequence        Pic  X(01).                    01860000
               88  WS-CS-Ascending                  Value 'A'.          01870000
               88  WS-CS-Descending                 Value 'D'.          01880000
             07  WS-Cursor-Status        Pic  X(08).                    01890000
               88  WS-Cursor-OK                     Value 'OK'.         01900000
               88  WS-Cursor-End                    Value 'END'.        01910000
      *                                                                 01920000
      * We store all occurences that are read, also those that we do    01930000
      * not find. This is to reduce the number of DB2 accesses.         01940000
      *                                                                 01950000
           05  WS-DB2-Table.                                            01960000
             07  WS-DB2-Row              Occurs 10 Times.               01970000
               10  WS-DB2-Fin-Inst-ID    Pic S9(18)              Comp-3.01980000
               10  WS-DB2-Contract-Type  Pic  X(03).                    01990000
               10  WS-DB2-Contract-No    Pic S9(07)              Comp-3.02000000
               10  WS-DB2-CA-Currency    Pic  X(03).                    02010000
               10  WS-DB2-PA-Seq-No      Pic S9(04)              Comp.  02020000
               10  WS-DB2-HI-Seq-No      Pic S9(04)              Comp.  02030000
               10  WS-DB2-Row-Status     Pic S9(01)              Comp-3.02040000
                 88  WS-DB2-Not-Read                Value +0.           02050000
                 88  WS-DB2-Read                    Value +1.           02060000
                 88  WS-DB2-Not-Found               Value +2.           02070000
               10  WS-DB2-DCL            Pic  X(250).                   02080000
      *                                                                 02090000
      *----------------------------------------------------------------*02100000
      * Areas for use when accessing DB2.                               02110000
