           End-If                                                       04640000
      *                                                                 04650000
           .                                                            04660000
      *################################################################.04670000
       D300-Select-Cursor                Section.                       04680000
      *                                                                 04690000
      * We choose which cursor to use, depending on the qualification.  04700000
      *                                                                 04710000
           Move  Space                   To    SW-Cursor-Code           04720000
      *                                                                 04730000
KUTT  *    If  W-DB-From-Type            Not = Space                    04740000
KUTT  *    and W-DB-From-Type (1:1)      Not = '%'                      04750000
KUTT  *        Set  Sw-Use-From          To    True                     04760000
KUTT  *    End-If                                                       04770000
KUTT  *                                                                 04780000
KUTT  *    If  W-DB-From-F-I-Id          Not = +0                       04790000
KUTT  *        Set  Sw-Use-From          To    True                     04800000
KUTT  *    End-If                                                       04810000
KUTT  *                                                                 04820000
KUTT  *    If  W-DB-From-Contr-Type      Not = Spaces                   04830000
KUTT  *    and W-DB-From-Contr-Type (1:1)                               04840000
KUTT  *                                  Not = '%'                      04850000
KUTT  *        Set  Sw-Use-From          To    True                     04860000
KUTT  *    End-If                                                       04870000
KUTT  *                                                                 04880000
KUTT  *    If  W-DB-From-Code            Not = Space                    04890000
KUTT  *    and W-DB-From-Code (1:1)      Not = '%'                      04900000
KUTT  *        Set  Sw-Use-From          To    True                     04910000
KUTT  *    End-If                                                       04920000
KUTT  *                                                                 04930000
KUTT  * ... then                                                        04940000
KUTT  *                                                                 04950000
KUTT  *    If  W-DB-To-Type              Not = Space                    04960000
KUTT  *    and W-DB-To-Type (1:1)        Not = '%'                      04970000
KUTT  *        Set  Sw-Use-To            To    True                     04980000
KUTT  *    End-If                                                       04990000
KUTT  *                                                                 05000000
KUTT  *    If  W-DB-To-F-I-Id            Not = +0                       05010000
KUTT  *        Set  Sw-Use-To            To    True                     05020000
KUTT  *    End-If                                                       05030000
KUTT  *                                                                 05040000
KUTT  *    If  W-DB-To-Contr-Type        Not = Spaces                   05050000
KUTT  *    and W-DB-To-Contr-Type (1:1)  Not = '%'                      05060000
KUTT  *        Set  Sw-Use-To            To    True                     05070000
KUTT  *    End-If                                                       05080000
KUTT  *                                                                 05090000
KUTT  *    If  W-DB-To-Code              Not = Space                    05100000
KUTT  *    and W-DB-To-Code (1:1)        Not = '%'                      05110000
KUTT  *        Set  Sw-Use-To            To    True                     05120000
KUTT  *    End-If                                                       05130000
KUTT  *                                                                 05140000
KUTT  *    If  W-DB-Rel-Type             Not = Space                    05150000
KUTT  *    and W-DB-Rel-Type (1:1)       Not = '%'                      05160000
KUTT  *        Set  Sw-Use-Relation      To    True                     05170000
KUTT  *    End-If                                                       05180000
KUTT  *                                                                 05190000
           If  W-DB-Fin-Inst-Id          Not = +0                       05200000
               Set  Sw-Use-Fin-Inst      To    True                     05210000
           End-If                                                       05220000
      *                                                                 05230000
           If  W-DB-From-Type            Not = Space                    05240000
           and W-DB-From-Type (1:1)      Not = '%'                      05250000
               Set  Sw-Use-ST-Type       To    True                     05260000
               Move  Length              Of    W-DB-From-Type           05270000
                                         To    W-Pos                    05280000
               If  W-DB-From-Type (W-Pos:1)                             05290000
                                         =     '%'                      05300000
               or  W-DB-To-Type (W-Pos:1)                               05310000
                                         =     '%'                      05320000
                   Set  Sw-Use-ST-Type-Like                             05330000
                                         To    True                     05340000
               End-If                                                   05350000
           End-If                                                       05360000
      *                                                                 05370000
           If  W-DB-Rel-Type             Not = Space                    05380000
           and W-DB-Rel-Type (1:1)       Not = '%'                      05390000
               Set  Sw-Use-Relation      To    True                     05400000
               Move  Length              Of    W-DB-Rel-Type            05410000
                                         To    W-Pos                    05420000
               If  W-DB-Rel-Type (W-Pos:1)                              05430000
                                         =     '%'                      05440000
                   Set  Sw-Use-Relation-Like                            05450000
                                         To    True                     05460000
               End-If                                                   05470000
           End-If                                                       05480000
      *                                                                 05490000
           If  W-DB-From-Code            Not = Space                    05500000
           and W-DB-From-Code (1:1)      Not = '%'                      05510000
               Set  Sw-Use-SC-Code       To    True                     05520000
               Move  Length              Of    W-DB-From-Code           05530000
                                         To    W-Pos                    05540000
               If  W-DB-From-Code (W-Pos:1)                             05550000
                                         =     '%'                      05560000
      *        We use LIKE on To-Code anyway, no need to specify that   05570000
      *        or  W-DB-To-Code (W-Pos:1)                               05580000
      *                                  =     '%'                      05590000
                   Set  Sw-Use-SC-Code-Like                             05600000
                                         To    True                     05610000
               End-If                                                   05620000
           End-If                                                       05630000
      *                                                                 05640000
           If  WE-From-Contr-Type        Not = Spaces                   05650000
           and WE-From-Contr-Type (1:1)  Not = '%'                      05660000
               Set  Sw-Use-SC-Contr-Type To    True                     05670000
           End-If                                                       05680000
      *                                                                 05690000
           Evaluate True                                                05700000
KUTT  *      When SW-Use-Asc                                            05710000
KUTT  *      or   SW-Use-Fr-Asc                                         05720000
KUTT  *      or   SW-Use-To-Asc                                         05730000
KUTT  *      or   SW-Use-Re-Asc                                         05740000
KUTT  *      or   SW-Use-Fr-To-Asc                                      05750000
KUTT  *      or   SW-Use-Fr-Re-Asc                                      05760000
KUTT  *      or   SW-Use-To-Re-Asc                                      05770000
KUTT  *      or   SW-Use-Fr-To-Re-Asc                                   05780000
             When SW-Use-Fi-ST-Asc                                      05790000
             or   SW-Use-Fi-ST-Re-Asc                                   05800000
             or   SW-Use-Fi-ST-SC-Asc                                   05810000
             or   SW-Use-Fi-ST-Re-SC-Asc                                05820000
               Continue                                                 05830000
      *                                                                 05840000
             When other                                                 05850000
               Initialize                      R7918030-ErrorMessage    05860000
               Move  'GL-CURSOR-UV'      To    R7918030-In-MessageCode  05870000
               Move  'VAR1'              To R7918030-In-Variable-Key (1)05880000
               Move  SW-Cursor-Code      To R7918030-In-Variable-Data(1)05890000
               Perform Z000-Error-Message                               05900000
               Move  'D302'              To    R7919999-Paragraph       05910000
               Perform Z900-Abend                                       05920000
      *                                                                 05930000
           End-Evaluate                                                 05940000
      *                                                                 05950000
           .                                                            05960000
      *################################################################.05970000
       D400-Count-Cursor                 Section.                       05980000
      *                                                                 05990000
           Initialize                          R115ISRS-SQL-Submodules  06000000
           Set   R115ISRS-Version        To    True                     06010000
           Set   R115ISRS-In-Count-Cursor                               06020000
                                         To    True                     06030000
           Move  Sw-Cursor-Code          To    R115ISRS-Cursor-Code     06040000
           Move  W-DB-Key                To    R115ISRS-DB-Key          06050000
      *                                                                 06060000
           Call  'F115ISRR'              Using R115ISRS-SQL-Submodules  06070000
                                               DCLTF-Sys-Code-Rel       06080000
                                               R7919999-Error-Area      06090000
           End-Call                                                     06100000
      *                                                                 06110000
           Evaluate True                                                06120000
             When R7919999-Return-OK                                    06130000
               Move  R115ISRS-Out-Total-Rows                            06140000
                                         To    WC-Total-No-Of-Rows      06150000
      *                                                                 06160000
             When other                                                 06170000
               Move  'D401'              To    R7919999-Paragraph       06180000
               Perform Z900-Abend                                       06190000
      *                                                                 06200000
           End-Evaluate                                                 06210000
      *                                                                 06220000
           .                                                            06230000
      *################################################################.06240000
       D500-Open-Cursor                  Section.                       06250000
      *                                                                 06260000
           Initialize                          R115ISRS-SQL-Submodules  06270000
           Set   R115ISRS-Version        To    True                     06280000
           Set   R115ISRS-In-Open-Cursor To    True                     06290000
           Move  Sw-Cursor-Code          To    R115ISRS-Cursor-Code     06300000
           Move  W-DB-Key                To    R115ISRS-DB-Key          06310000
      *                                                                 06320000
           Call  'F115ISRR'              Using R115ISRS-SQL-Submodules  06330000
                                               DCLTF-Sys-Code-Rel       06340000
                                               R7919999-Error-Area      06350000
           End-Call                                                     06360000
      *                                                                 06370000
           Evaluate True                                                06380000
             When R7919999-Return-OK                                    06390000
               Set   WS-Cursor-OK        To    True                     06400000
      *                                                                 06410000
             When other                                                 06420000
               Move  'D501'              To    R7919999-Paragraph       06430000
               Perform Z900-Abend                                       06440000
      *                                                                 06450000
           End-Evaluate                                                 06460000
      *                                                                 06470000
           .                                                            06480000
      *################################################################.06490000
       E000-Get-Next                     Section.                       06500000
      *                                                                 06510000
           Perform D100-Prepare-Input                                   06520000
           Perform E100-Check-Qualification                             06530000
           Perform E200-Fetch-Cursor                                    06540000
      *                                                                 06550000
           If  R7919999-Return-OK                                       06560000
               Perform L100-Store-DCL                                   06570000
               Perform J000-Get-Columns                                 06580000
           End-If                                                       06590000
      *                                                                 06600000
           .                                                            06610000
      *################################################################.06620000
       E100-Check-Qualification          Section.                       06630000
      *                                                                 06640000
      * We use the WE-fields for comparison with the WS-fields.         06650000
      * This to verify that the qualification has not changes since     06660000
      * the Get-1st.                                                    06670000
      *                                                                 06680000
           Evaluate True                                                06690000
             When WE-Key                 =     WS-Key                   06700000
             and  WE-Code-Sequence       =     WS-Code-Sequence         06710000
             and  WS-Cursor-OK                                          06720000
               Continue                                                 06730000
      *                                                                 06740000
             When WE-Key                 =     WS-Key                   06750000
             and  WE-Code-Sequence       =     WS-Code-Sequence         06760000
             and  WS-Cursor-End                                         06770000
               Initialize                      R7918030-ErrorMessage    06780000
               Move  'DB-LEST-SISTE'     To    R7918030-In-MessageCode  06790000
               Move  'VAR1'              To R7918030-In-Variable-Key (1)06800000
               Move  W-Table-Name        To R7918030-In-Variable-Data(1)06810000
               Perform Z000-Error-Message                               06820000
               Move  'E101'              To    R7919999-Paragraph       06830000
               Perform Z900-Abend                                       06840000
      *                                                                 06850000
             When Other                                                 06860000
               Initialize                      R7918030-ErrorMessage    06870000
               Move  'GL-BRUK-GET-1ST'   To    R7918030-In-MessageCode  06880000
               Perform Z000-Error-Message                               06890000
               Move  'E102'              To    R7919999-Paragraph       06900000
               Perform Z900-Abend                                       06910000
      *                                                                 06920000
           End-Evaluate                                                 06930000
      *                                                                 06940000
           .                                                            06950000
      *################################################################.06960000
       E200-Fetch-Cursor                 Section.                       06970000
      *                                                                 06980000
           Initialize                          R115ISRS-SQL-Submodules  06990000
           Set   R115ISRS-Version        To    True                     07000000
           Set   R115ISRS-In-Fetch-Cursor                               07010000
                                         To    True                     07020000
           Move  Sw-Cursor-Code          To    R115ISRS-Cursor-Code     07030000
           Move  W-DB-Key                To    R115ISRS-DB-Key          07040000
      *                                                                 07050000
           Call  'F115ISRR'              Using R115ISRS-SQL-Submodules  07060000
                                               DCLTF-Sys-Code-Rel       07070000
                                               R7919999-Error-Area      07080000
           End-Call                                                     07090000
      *                                                                 07100000
           Evaluate True                                                07110000
             When R7919999-Return-OK                                    07120000
               Add   +1                  To    WC-Row-No                07130000
      *                                                                 07140000
             When R7919999-Return-Error                                 07150000
               Set   WS-Cursor-End       To    True                     07160000
               If  WC-Row-No             =     +0                       07170000
                 Then                                                   07180000
                   Initialize                  R7918030-ErrorMessage    07190000
                   Move  'DB-FOREKOMST-NF'                              07200000
                                         To    R7918030-In-MessageCode  07210000
                   Move  'VAR1'          To R7918030-In-Variable-Key (1)07220000
                   Move  W-Table-Name    To R7918030-In-Variable-Data(1)07230000
                   Perform Z000-Error-Message                           07240000
                 Else                                                   07250000
                   Initialize                  R7918030-ErrorMessage    07260000
                   Move  'DB-LEST-SISTE' To    R7918030-In-MessageCode  07270000
                   Move  'VAR1'          To R7918030-In-Variable-Key (1)07280000
                   Move  W-Table-Name    To R7918030-In-Variable-Data(1)07290000
                   Perform Z000-Error-Message                           07300000
               End-If                                                   07310000
      *                                                                 07320000
             When other                                                 07330000
               Move  'E201'              To    R7919999-Paragraph       07340000
               Perform Z900-Abend                                       07350000
      *                                                                 07360000
           End-Evaluate                                                 07370000
      *                                                                 07380000
           .                                                            07390000
      *################################################################.07400000
       F000-Select                       Section.                       07410000
      *                                                                 07420000
           Perform F100-Prepare-Qualification                           07430000
      *                                                                 07440000
      * We will first look through the storage, to see if we have       07450000
      * already got the wanted occurence.                               07460000
      *                                                                 07470000
           Perform L200-Find-DCL                                        07480000
      *                                                                 07490000
      * If we didn't find anything, we need to read. Then we store.     07500000
      *                                                                 07510000
           If  Ind-WS                    >     W-Max-Occ-WS-Tab         07520000
           or  WS-DB2-Not-Read (Ind-WS)                                 07530000
               Perform F200-Select-Row                                  07540000
               Perform L100-Store-DCL                                   07550000
           End-If                                                       07560000
      *                                                                 07570000
      * At last we check what we've got to offer.                       07580000
      *                                                                 07590000
           Evaluate True                                                07600000
             When WS-DB2-Read (Ind-WS)                                  07610000
               Move  WS-DB2-DCL (Ind-WS) To    DCLTF-Sys-Code-Rel       07620000
               Perform J000-Get-Columns                                 07630000
      *                                                                 07640000
             When other                                                 07650000
               Move FK-OAKO-FINI-FROM    To    WD-Fin-Inst-Id           07660000
      *                                                                 07670000
               Initialize                      R7918030-ErrorMessage    07680000
               Move  'DB-FOREKOMST-NF-Q' To    R7918030-In-MessageCode  07690000
               Move  'VAR1'              To R7918030-In-Variable-Key (1)07700000
               Move  W-Table-Name        To R7918030-In-Variable-Data(1)07710000
               Move  'VAR2'              To R7918030-In-Variable-Key (2)07720000
               String WD-Fin-Inst-Id           Delimited by space       07730000
                      '/'                      Delimited by size        07740000
                      FK-TFST-Type-From        Delimited by space       07750000
                      '/'                      Delimited by size        07760000
                      FK-TFST-Type-To          Delimited by space       07770000
                      '/'                      Delimited by size        07780000
                      TFSR-Type                Delimited by space       07790000
                      '/'                      Delimited by size        07800000
                      FK-TFSC-Code-From        Delimited by space       07810000
                      '/'                      Delimited by size        07820000
                      FK-TFSC-Code-To          Delimited by space       07830000
                      '/'                      Delimited by size        07840000
                      FK-TFSC-COTY-FROM        Delimited by space       07850000
                      '/'                      Delimited by size        07860000
                      FK-TFSC-COTY-To          Delimited by space       07870000
                                       Into R7918030-In-Variable-Data(2)07880000
               End-String                                               07890000
               Perform Z000-Error-Message                               07900000
               Set   R7919999-Return-Error                              07910000
                                         To    True                     07920000
      *                                                                 07930000
           End-Evaluate                                                 07940000
      *                                                                 07950000
           .                                                            07960000
      *################################################################.07970000
       F100-Prepare-Qualification        Section.                       07980000
      *                                                                 07990000
      * We fill in the host variables for the SQL.                      08000000
      *                                                                 08010000
           Initialize                          DCLTF-Sys-Code-Rel       08020000
      *                                                                 08030000
           Move  R115ISR0-In-From-ST-Type                               08040000
                                         To    FK-TFST-Type-From        08050000
           Move  R115ISR0-In-F-I-Id                                     08060000
                                         To    FK-OAKO-FINI-FROM        08070000
           Move  R115ISR0-In-From-Contr-Type                            08080000
                                         To    FK-TFSC-COTY-FROM        08090000
           Move  R115ISR0-In-From-SC-Code                               08100000
                                         To    FK-TFSC-Code-From        08110000
      *                                                                 08120000
      * .. then To variables                                            08130000
      *                                                                 08140000
           Move  R115ISR0-In-To-ST-Type  To    FK-TFST-Type-To          08150000
           Move  R115ISR0-In-F-I-Id      To    FK-OAKO-FINI-To          08160000
           Move  R115ISR0-In-To-Contr-Type                              08170000
                                         To    FK-TFSC-COTY-To          08180000
           Move  R115ISR0-In-To-SC-Code  To    FK-TFSC-Code-To          08190000
           Move  R115ISR0-In-Relation-Type                              08200000
                                         To    TFSR-Type                08210000
      *                                                                 08220000
           If  R115ISR0-In-F-I-No        Not = Spaces                   08230000
           and FK-OAKO-FINI-FROM         =     +0                       08240000
               Move  R115ISR0-In-F-I-No  To    W-Fin-Inst-No            08250000
               Perform N100-Fetch-Fin-Inst-ID                           08260000
               Move  W-Fin-Inst-ID       To    FK-OAKO-FINI-FROM        08270000
           End-If                                                       08280000
      *                                                                 08290000
           If  R115ISR0-In-F-I-No        Not = Spaces                   08300000
           and FK-OAKO-FINI-To           =     +0                       08310000
               Move  R115ISR0-In-F-I-No  To    W-Fin-Inst-No            08320000
               Perform N100-Fetch-Fin-Inst-ID                           08330000
               Move  W-Fin-Inst-ID       To    FK-OAKO-FINI-TO          08340000
           End-If                                                       08350000
      *                                                                 08360000
           .                                                            08370000
      *################################################################.08380000
       F200-Select-Row                   Section.                       08390000
      *                                                                 08400000
           Initialize                          R115ISRS-SQL-Submodules  08410000
           Set   R115ISRS-Version        To    True                     08420000
           Set   R115ISRS-In-Select      To    True                     08430000
      *                                                                 08440000
           Call  'F115ISRR'              Using R115ISRS-SQL-Submodules  08450000
                                               DCLTF-Sys-Code-Rel       08460000
                                               R7919999-Error-Area      08470000
           End-Call                                                     08480000
      *                                                                 08490000
           Evaluate True                                                08500000
             When R7919999-Return-OK                                    08510000
               Continue                                                 08520000
      *                                                                 08530000
             When R7919999-Return-Error                                 08540000
               Continue                                                 08550000
      *                                                                 08560000
             When other                                                 08570000
               Move  'F201'              To    R7919999-Paragraph       08580000
               Perform Z900-Abend                                       08590000
      *                                                                 08600000
           End-Evaluate                                                 08610000
      *                                                                 08620000
           .                                                            08630000
      *################################################################.08640000
       G000-Insert                       Section.                       08650000
      *                                                                 08660000
           Perform G100-Move-Input-To-DCL                               08670000
           Perform G200-Insert-Row                                      08680000
      *                                                                 08690000
           Perform L300-Remove-DCL                                      08700000
           Perform L100-Store-DCL                                       08710000
      *                                                                 08720000
           .                                                            08730000
      *################################################################.08740000
       G100-Move-Input-To-DCL            Section.                       08750000
      *                                                                 08760000
           Initialize                          DCLTF-Sys-Code-Rel       08770000
      *                                                                 08780000
           Move R115ISR0-From-ST-Type    To    FK-TFST-Type-From        08790000
           Move R115ISR0-F-I-Id          To    FK-OAKO-FINI-FROM        08800000
           Move R115ISR0-From-Contr-Type To    FK-TFSC-COTY-FROM        08810000
           Move R115ISR0-From-SC-Code    To    FK-TFSC-Code-From        08820000
      *                                                                 08830000
           Move R115ISR0-To-ST-Type      To    FK-TFST-Type-To          08840000
           Move R115ISR0-F-I-Id          To    FK-OAKO-FINI-To          08850000
           Move R115ISR0-To-Contr-Type   To    FK-TFSC-COTY-To          08860000
           Move R115ISR0-To-SC-Code      To    FK-TFSC-Code-To          08870000
      *                                                                 08880000
           Move R115ISR0-Relation-Type   To    TFSR-Type                08890000
      *                                                                 08900000
           If  R115ISR0-F-I-No           Not = Spaces                   08910000
           and FK-OAKO-FINI-FROM         =     +0                       08920000
               Move  R115ISR0-F-I-No     To    W-Fin-Inst-No            08930000
               Perform N100-Fetch-Fin-Inst-ID                           08940000
               Move  W-Fin-Inst-ID       To    FK-OAKO-FINI-FROM        08950000
           End-If                                                       08960000
      *                                                                 08970000
           If  R115ISR0-F-I-No           Not = Spaces                   08980000
           and FK-OAKO-FINI-To           =     +0                       08990000
               Move  R115ISR0-F-I-No     To    W-Fin-Inst-No            09000000
               Perform N100-Fetch-Fin-Inst-ID                           09010000
               Move  W-Fin-Inst-ID       To    FK-OAKO-FINI-TO          09020000
           End-If                                                       09030000
      *                                                                 09040000
           .                                                            09050000
      *################################################################.09060000
       G200-Insert-Row                   Section.                       09070000
      *                                                                 09080000
           Initialize                          R115ISRS-SQL-Submodules  09090000
           Set   R115ISRS-Version        To    True                     09100000
           Set   R115ISRS-In-Insert      To    True                     09110000
      *                                                                 09120000
           Call  'F115ISRU'              Using R115ISRS-SQL-Submodules  09130000
                                               DCLTF-Sys-Code-Rel       09140000
                                               R7919999-Error-Area      09150000
           End-Call                                                     09160000
      *                                                                 09170000
           Evaluate True                                                09180000
             When R7919999-Return-OK                                    09190000
               Continue                                                 09200000
      *                                                                 09210000
             When R7919999-Return-Error                                 09220000
               Continue                                                 09230000
      *                                                                 09240000
             When other                                                 09250000
               Move  'G201'              To    R7919999-Paragraph       09260000
               Perform Z900-Abend                                       09270000
      *                                                                 09280000
           End-Evaluate                                                 09290000
      *                                                                 09300000
           .                                                            09310000
      *################################################################.09320000
       H000-Update                       Section.                       09330000
      *                                                                 09340000
           Perform H100-Check-Qualification                             09350000
           Perform G100-Move-Input-To-DCL                               09360000
      *                                                                 09370000
           Perform H200-Update-Row                                      09380000
      *                                                                 09390000
           Perform L300-Remove-DCL                                      09400000
           Perform L100-Store-DCL                                       09410000
      *                                                                 09420000
           .                                                            09430000
      *################################################################.09440000
       H100-Check-Qualification          Section.                       09450000
      *                                                                 09460000
      * Handling ST-Type                                                09470000
      *                                                                 09480000
           Evaluate True                                                09490000
             When R115ISR0-From-ST-Type  Not = Space                    09500000
               Continue                                                 09510000
                                                                        09520000
             When R115ISR0-In-From-ST-Type                              09530000
                                         Not = Space                    09540000
               Move R115ISR0-In-From-ST-Type                            09550000
                                         To    R115ISR0-From-ST-Type    09560000
                                                                        09570000
             When other                                                 09580000
               Initialize                      R7918030-ErrorMessage    09590000
               Move  'TF-TYPE-MISSING'   To    R7918030-In-MessageCode  09600000
               Perform Z000-Error-Message                               09610000
               Set   R7919999-Return-Error                              09620000
                                         To    True                     09630000
                                                                        09640000
           End-Evaluate                                                 09650000
      *                                                                 09660000
      * Handling Fin-Inst-From                                          09670000
      *                                                                 09680000
           Evaluate True                                                09690000
             When R115ISR0-F-I-Id        Not = +0                       09700000
               Continue                                                 09710000
                                                                        09720000
             When R115ISR0-In-F-I-Id     Not = +0                       09730000
               Move R115ISR0-In-F-I-Id   To    R115ISR0-F-I-Id          09740000
                                                                        09750000
             When R115ISR0-F-I-No        Not = Spaces                   09760000
               Move R115ISR0-F-I-No      To    W-Fin-Inst-No            09770000
               Perform N100-Fetch-Fin-Inst-ID                           09780000
               Move  W-Fin-Inst-ID       To    R115ISR0-F-I-Id          09790000
                                                                        09800000
             When R115ISR0-In-F-I-No     Not = Spaces                   09810000
               Move R115ISR0-In-F-I-No   To    W-Fin-Inst-No            09820000
               Perform N100-Fetch-Fin-Inst-ID                           09830000
               Move  W-Fin-Inst-ID       To    R115ISR0-F-I-Id          09840000
                                                                        09850000
             When other                                                 09860000
               Initialize                      R7918030-ErrorMessage    09870000
               Move  'TF-FININST-MISSING'                               09880000
                                         To    R7918030-In-MessageCode  09890000
               Perform Z000-Error-Message                               09900000
               Set   R7919999-Return-Error                              09910000
                                         To    True                     09920000
                                                                        09930000
           End-Evaluate                                                 09940000
      *                                                                 09950000
      * Handling Contr-Type                                             09960000
      *                                                                 09970000
           Evaluate True                                                09980000
             When R115ISR0-From-Contr-Type Not = Space                  09990000
               Continue                                                 10000000
                                                                        10010000
             When R115ISR0-In-From-Contr-Type                           10020000
                                         Not = Space                    10030000
               Move R115ISR0-In-From-Contr-Type                         10040000
                                         To    R115ISR0-From-Contr-Type 10050000
                                                                        10060000
             When other                                                 10070000
               Initialize                      R7918030-ErrorMessage    10080000
               Move  'TF-CONTRTY-MISSING'                               10090000
                                         To    R7918030-In-MessageCode  10100000
               Perform Z000-Error-Message                               10110000
               Set   R7919999-Return-Error                              10120000
                                         To    True                     10130000
                                                                        10140000
           End-Evaluate                                                 10150000
      *                                                                 10160000
      * Handling SC-COde                                                10170000
      *                                                                 10180000
           Evaluate True                                                10190000
             When R115ISR0-From-SC-Code  Not = Space                    10200000
               Continue                                                 10210000
                                                                        10220000
             When R115ISR0-In-From-SC-Code                              10230000
                                         Not = Space                    10240000
               Move R115ISR0-In-From-SC-Code                            10250000
                                         To    R115ISR0-From-SC-Code    10260000
                                                                        10270000
             When other                                                 10280000
               Initialize                      R7918030-ErrorMessage    10290000
               Move  'TF-CODE-MISSING'   To    R7918030-In-MessageCode  10300000
               Perform Z000-Error-Message                               10310000
               Set   R7919999-Return-Error                              10320000
                                         To    True                     10330000
                                                                        10340000
           End-Evaluate                                                 10350000
      *                                                                 10360000
      * Handling ST-Type   -     T O    -                               10370000
      *                                                                 10380000
           Evaluate True                                                10390000
             When R115ISR0-To-ST-Type    Not = Space                    10400000
               Continue                                                 10410000
                                                                        10420000
             When R115ISR0-In-To-ST-Type Not = Space                    10430000
               Move R115ISR0-In-To-ST-Type                              10440000
                                         To    R115ISR0-To-ST-Type      10450000
                                                                        10460000
             When other                                                 10470000
               Initialize                      R7918030-ErrorMessage    10480000
               Move  'TF-TYPE-MISSING'   To    R7918030-In-MessageCode  10490000
               Perform Z000-Error-Message                               10500000
               Set   R7919999-Return-Error                              10510000
                                         To    True                     10520000
                                                                        10530000
           End-Evaluate                                                 10540000
      *                                                                 10550000
      * Handling Fin-Inst- To                                           10560000
      *                                                                 10570000
           Evaluate True                                                10580000
             When R115ISR0-F-I-Id        Not = +0                       10590000
               Continue                                                 10600000
                                                                        10610000
             When R115ISR0-In-F-I-Id     Not = +0                       10620000
               Move R115ISR0-In-F-I-Id   To    R115ISR0-F-I-Id          10630000
                                                                        10640000
             When R115ISR0-In-F-I-No     Not = Spaces                   10650000
               Move R115ISR0-In-F-I-No   To    W-Fin-Inst-No            10660000
               Perform N100-Fetch-Fin-Inst-ID                           10670000
               Move  W-Fin-Inst-ID       To    R115ISR0-F-I-Id          10680000
                                                                        10690000
             When R115ISR0-In-F-I-No     Not = Spaces                   10700000
               Move R115ISR0-In-F-I-No   To    W-Fin-Inst-No            10710000
               Perform N100-Fetch-Fin-Inst-ID                           10720000
               Move  W-Fin-Inst-ID       To    R115ISR0-F-I-Id          10730000
                                                                        10740000
             When other                                                 10750000
               Initialize                      R7918030-ErrorMessage    10760000
               Move  'TF-FININST-MISSING'                               10770000
                                         To    R7918030-In-MessageCode  10780000
               Perform Z000-Error-Message                               10790000
               Set   R7919999-Return-Error                              10800000
                                         To    True                     10810000
                                                                        10820000
           End-Evaluate                                                 10830000
      *                                                                 10840000
      * Handling Contr-Type                                             10850000
      *                                                                 10860000
           Evaluate True                                                10870000
             When R115ISR0-To-Contr-Type Not = Space                    10880000
               Continue                                                 10890000
                                                                        10900000
             When R115ISR0-In-To-Contr-Type                             10910000
                                         Not = Space                    10920000
               Move R115ISR0-In-To-Contr-Type                           10930000
                                         To    R115ISR0-To-Contr-Type   10940000
                                                                        10950000
             When other                                                 10960000
               Initialize                      R7918030-ErrorMessage    10970000
               Move  'TF-CONTRTY-MISSING'                               10980000
                                         To    R7918030-In-MessageCode  10990000
               Perform Z000-Error-Message                               11000000
               Set   R7919999-Return-Error                              11010000
                                         To    True                     11020000
                                                                        11030000
           End-Evaluate                                                 11040000
      *                                                                 11050000
      * Handling SC-COde                                                11060000
      *                                                                 11070000
           Evaluate True                                                11080000
             When R115ISR0-To-SC-Code    Not = Space                    11090000
               Continue                                                 11100000
                                                                        11110000
             When R115ISR0-In-To-SC-Code Not = Space                    11120000
               Move R115ISR0-In-To-SC-Code                              11130000
                                         To    R115ISR0-To-SC-Code      11140000
                                                                        11150000
             When other                                                 11160000
               Initialize                      R7918030-ErrorMessage    11170000
               Move  'TF-CODE-MISSING'   To    R7918030-In-MessageCode  11180000
               Perform Z000-Error-Message                               11190000
               Set   R7919999-Return-Error                              11200000
                                         To    True                     11210000
                                                                        11220000
           End-Evaluate                                                 11230000
      *                                                                 11240000
      * Handling Relation-Code                                          11250000
      *                                                                 11260000
           Evaluate True                                                11270000
             When R115ISR0-Relation-Type Not = Space                    11280000
               Continue                                                 11290000
                                                                        11300000
             When R115ISR0-In-Relation-Type                             11310000
                                         Not = Space                    11320000
               Move R115ISR0-In-Relation-Type                           11330000
                                         To    R115ISR0-Relation-Type   11340000
                                                                        11350000
             When other                                                 11360000
               Initialize                      R7918030-ErrorMessage    11370000
               Move  'TF-RELATION-MISSING'                              11380000
                                         To    R7918030-In-MessageCode  11390000
               Perform Z000-Error-Message                               11400000
               Set   R7919999-Return-Error                              11410000
                                         To    True                     11420000
                                                                        11430000
           End-Evaluate                                                 11440000
      *                                                                 11450000
           .                                                            11460000
      *################################################################.11470000
       H200-Update-Row                   Section.                       11480000
      *                                                                 11490000
           Initialize                          R115ISRS-SQL-Submodules  11500000
           Set   R115ISRS-Version        To    True                     11510000
           Set   R115ISRS-In-Update      To    True                     11520000
      *                                                                 11530000
           Call  'F115ISRU'              Using R115ISRS-SQL-Submodules  11540000
                                               DCLTF-Sys-Code-Rel       11550000
                                               R7919999-Error-Area      11560000
           End-Call                                                     11570000
      *                                                                 11580000
           Evaluate True                                                11590000
             When R7919999-Return-OK                                    11600000
               Continue                                                 11610000
      *                                                                 11620000
             When R7919999-Return-Error                                 11630000
               Continue                                                 11640000
      *                                                                 11650000
             When other                                                 11660000
               Move  'H201'              To    R7919999-Paragraph       11670000
               Perform Z900-Abend                                       11680000
      *                                                                 11690000
           End-Evaluate                                                 11700000
      *                                                                 11710000
           .                                                            11720000
      *################################################################.11730000
       I000-Delete                       Section.                       11740000
      *                                                                 11750000
           Perform F100-Prepare-Qualification                           11760000
           Perform I200-Delete-Row                                      11770000
      *                                                                 11780000
           Perform L300-Remove-DCL                                      11790000
      *                                                                 11800000
           .                                                            11810000
      *################################################################.11820000
       I200-Delete-Row                   Section.                       11830000
      *                                                                 11840000
           Initialize                          R115ISRS-SQL-Submodules  11850000
           Set   R115ISRS-Version        To    True                     11860000
           Set   R115ISRS-In-Delete      To    True                     11870000
      *                                                                 11880000
           Call  'F115ISRU'              Using R115ISRS-SQL-Submodules  11890000
                                               DCLTF-Sys-Code-Rel       11900000
                                               R7919999-Error-Area      11910000
           End-Call                                                     11920000
      *                                                                 11930000
           Evaluate True                                                11940000
             When R7919999-Return-OK                                    11950000
               Continue                                                 11960000
      *                                                                 11970000
             When R7919999-Return-Error                                 11980000
               Continue                                                 11990000
      *                                                                 12000000
             When other                                                 12010000
               Move  'I201'              To    R7919999-Paragraph       12020000
               Perform Z900-Abend                                       12030000
      *                                                                 12040000
           End-Evaluate                                                 12050000
      *                                                                 12060000
           .                                                            12070000
      *################################################################.12080000
       J000-Get-Columns                  Section.                       12090000
      *                                                                 12100000
           Perform J100-Move-DCL-To-Output                              12110000
      *                                                                 12120000
           .                                                            12130000
      *################################################################.12140000
       J100-Move-DCL-To-Output           Section.                       12150000
      *                                                                 12160000
           Move  FK-TFST-Type-From       To    R115ISR0-From-ST-Type    12170000
           Move  FK-OAKO-FINI-FROM       To    R115ISR0-F-I-Id          12180000
           Move  FK-TFSC-COTY-FROM       To    R115ISR0-From-Contr-Type 12190000
           Move  FK-TFSC-Code-From       To    R115ISR0-From-SC-Code    12200000
      *                                                                 12210000
           Move  FK-TFST-Type-To         To    R115ISR0-To-ST-Type      12220000
           Move  FK-OAKO-FINI-To         To    R115ISR0-F-I-Id          12230000
           Move  FK-TFSC-COTY-To         To    R115ISR0-To-Contr-Type   12240000
           Move  FK-TFSC-Code-To         To    R115ISR0-To-SC-Code      12250000
      *                                                                 12260000
           Move  TFSR-Type               To    R115ISR0-Relation-Type   12270000
      *                                                                 12280000
           Move  FK-OAKO-FINI-From       To    W-Fin-Inst-ID            12290000
           Perform N200-Fetch-Fin-Inst-No                               12300000
           Move  W-Fin-Inst-No           To    R115ISR0-F-I-No          12310000
      *                                                                 12320000
      * Info about the cursor:                                          12330000
      *                                                                 12340000
           Move  WC-Row-No               To    R115ISR0-Out-Row-No      12350000
           Move  WC-Total-No-Of-Rows     To    R115ISR0-Out-Total-Rows  12360000
      *                                                                 12370000
           .                                                            12380000
      *################################################################.12390000
       L100-Store-DCL                    Section.                       12400000
      *                                                                 12410000
      * We might already have this row in storage.                      12420000
      *                                                                 12430000
           Perform L200-Find-DCL                                        12440000
      *                                                                 12450000
           If  Ind-WS                    >     W-Max-Occ-WS-Tab         12460000
           or  WS-DB2-Not-Read (Ind-WS)                                 12470000
             Then                                                       12480000
      *        If we have reached the end of the storage-table,         12490000
      *        we start on the beginning.                               12500000
      *        This way, we always keep the "newest" occurrences.       12510000
               Add   +1                  To    Ind-WS-Put               12520000
               If  Ind-WS-Put            >     W-Max-Occ-WS-Tab         12530000
                   Move  +1              To    Ind-WS-Put               12540000
               End-If                                                   12550000
               Move  Ind-WS-Put          To    Ind-WS                   12560000
             Else                                                       12570000
               Move  Ind-WS              To    Ind-WS-Put               12580000
           End-If                                                       12590000
      *                                                                 12600000
      * We store the identification.                                    12610000
      *                                                                 12620000
KUTT  *    Move  FK-TFST-Type-From       To    WS-DB2-From-Type         12630000
KUTT  *                                                     (Ind-WS-Put)12640000
KUTT  *    Move  FK-OAKO-FINI-FROM       To    WS-DB2-From-F-I-Id       12650000
KUTT  *                                                     (Ind-WS-Put)12660000
KUTT  *    Move  FK-TFSC-COTY-FROM       To    WS-DB2-From-Contr-Type   12670000
KUTT  *                                                     (Ind-WS-Put)12680000
KUTT  *    Move  FK-TFSC-Code-From       To    WS-DB2-From-Code         12690000
KUTT  *                                                     (Ind-WS-Put)12700000
KUTT  *    Move  FK-TFST-Type-To         To    WS-DB2-To-Type           12710000
KUTT  *                                                     (Ind-WS-Put)12720000
KUTT  *    Move  FK-OAKO-FINI-To         To    WS-DB2-To-F-I-Id         12730000
KUTT  *                                                     (Ind-WS-Put)12740000
KUTT  *    Move  FK-TFSC-COTY-To         To    WS-DB2-To-Contr-Type     12750000
KUTT  *                                                     (Ind-WS-Put)12760000
KUTT  *    Move  FK-TFSC-Code-To         To    WS-DB2-To-Code           12770000
KUTT  *                                                     (Ind-WS-Put)12780000
KUTT  *    Move  TFSR-Type               To    WS-DB2-Rel-Type          12790000
KUTT  *                                                     (Ind-WS-Put)12800000
KUTT  *                                                                 12810000
           Move  FK-OAKO-FINI-FROM       To    WS-DB2-Fin-Inst-Id       12820000
                                                            (Ind-WS-Put)12830000
           Move  FK-TFST-Type-From       To    WS-DB2-From-Type         12840000
                                                            (Ind-WS-Put)12850000
           Move  FK-TFST-Type-To         To    WS-DB2-To-Type           12860000
                                                            (Ind-WS-Put)12870000
           Move  TFSR-Type               To    WS-DB2-Rel-Type          12880000
                                                            (Ind-WS-Put)12890000
           Move  FK-TFSC-Code-From       To    WS-DB2-From-Code         12900000
                                                            (Ind-WS-Put)12910000
           Move  FK-TFSC-Code-To         To    WS-DB2-To-Code           12920000
                                                            (Ind-WS-Put)12930000
           Move  FK-TFSC-COTY-FROM       To    WS-DB2-From-Contr-Type   12940000
                                                            (Ind-WS-Put)12950000
           Move  FK-TFSC-COTY-To         To    WS-DB2-To-Contr-Type     12960000
                                                            (Ind-WS-Put)12970000
      *                                                                 12980000
      * The DCL is stored if found, the status is set.                  12990000
      *                                                                 13000000
           Evaluate True                                                13010000
             When Length                 Of    DCLTF-Sys-Code-Rel       13020000
                > Length                 Of    WS-DB2-DCL               13030000
               Move  Length              Of    DCLTF-Sys-Code-Rel       13040000
                                         To    WD-Length                13050000
               Initialize                      R7918030-ErrorMessage    13060000
               Move  'GL-WL-DCL-UTVIDES' To    R7918030-In-MessageCode  13070000
               Move  'VAR1'              To R7918030-In-Variable-Key (1)13080000
               Move  WD-Length           To R7918030-In-Variable-Data(1)13090000
               Perform Z000-Error-Message                               13100000
               Move  'L101'              To    R7919999-Paragraph       13110000
               Perform Z900-Abend                                       13120000
      *                                                                 13130000
             When R7919999-Return-Error                                 13140000
               Set   WS-DB2-Not-Found (Ind-WS-Put)                      13150000
                                         To    True                     13160000
      *                                                                 13170000
             When other                                                 13180000
               Move  DCLTF-Sys-Code-Rel                                 13190000
                                         To    WS-DB2-DCL   (Ind-WS-Put)13200000
               Set   WS-DB2-Read (Ind-WS-Put)                           13210000
                                         To    True                     13220000
      *                                                                 13230000
           End-Evaluate                                                 13240000
      *                                                                 13250000
           .                                                            13260000
      *################################################################.13270000
       L200-Find-DCL                     Section.                       13280000
      *                                                                 13290000
           Perform Varying Ind-WS                                       13300000
                   From  +1              By    +1                       13310000
                   Until Ind-WS          >     W-Max-Occ-WS-Tab         13320000
KUTT  *            or  ( WS-DB2-From-Type (Ind-WS)                      13330000
KUTT  *                                  =     FK-TFST-Type-From        13340000
KUTT  *            and   WS-DB2-From-F-I-Id     (Ind-WS)                13350000
KUTT  *                                  =     FK-OAKO-FINI-FROM        13360000
KUTT  *            and   WS-DB2-From-Contr-Type (Ind-WS)                13370000
KUTT  *                                  =     FK-TFSC-COTY-FROM        13380000
KUTT  *            and   WS-DB2-From-Code (Ind-WS)                      13390000
KUTT  *                                  =     FK-TFSC-Code-From        13400000
KUTT  *            and   WS-DB2-To-Type (Ind-WS)                        13410000
KUTT  *                                  =     FK-TFST-Type-To          13420000
KUTT  *            and   WS-DB2-To-F-I-Id     (Ind-WS)                  13430000
KUTT  *                                  =     FK-OAKO-FINI-To          13440000
KUTT  *            and   WS-DB2-To-Contr-Type (Ind-WS)                  13450000
KUTT  *                                  =     FK-TFSC-COTY-To          13460000
KUTT  *            and   WS-DB2-To-Code (Ind-WS)                        13470000
KUTT  *                                  =     FK-TFSC-Code-To          13480000
KUTT  *            and   WS-DB2-Rel-Type (Ind-WS)                       13490000
KUTT  *                                  =     TFSR-Type )              13500000
KUTT  *                                                                 13510000
                   or  ( WS-DB2-Fin-Inst-Id     (Ind-WS)                13520000
                                         =     FK-OAKO-FINI-FROM        13530000
                   and   WS-DB2-From-Type (Ind-WS)                      13540000
                                         =     FK-TFST-Type-From        13550000
                   and   WS-DB2-To-Type (Ind-WS)                        13560000
                                         =     FK-TFST-Type-To          13570000
                   and   WS-DB2-Rel-Type (Ind-WS)                       13580000
                                         =     TFSR-Type                13590000
                   and   WS-DB2-From-Code (Ind-WS)                      13600000
                                         =     FK-TFSC-Code-From        13610000
                   and   WS-DB2-To-Code (Ind-WS)                        13620000
                                         =     FK-TFSC-Code-To          13630000
                   and   WS-DB2-From-Contr-Type (Ind-WS)                13640000
                                         =     FK-TFSC-COTY-FROM        13650000
                   and   WS-DB2-To-Contr-Type (Ind-WS)                  13660000
                                         =     FK-TFSC-COTY-To )        13670000
           End-Perform                                                  13680000
      *                                                                 13690000
           .                                                            13700000
      *################################################################*13710000
       L300-Remove-DCL                   Section.                       13720000
      *                                                                 13730000
           Perform Varying Ind-WS                                       13740000
                   From  +1              By    +1                       13750000
                   Until Ind-WS          >     W-Max-Occ-WS-Tab         13760000
KUTT  *            or  ( WS-DB2-From-Type (Ind-WS)                      13770000
KUTT  *                                  =     FK-TFST-Type-From        13780000
KUTT  *            and   WS-DB2-From-F-I-Id     (Ind-WS)                13790000
KUTT  *                                  =     FK-OAKO-FINI-From        13800000
KUTT  *            and   WS-DB2-From-Contr-Type (Ind-WS)                13810000
KUTT  *                                  =     FK-TFSC-COTY-From        13820000
KUTT  *            and   WS-DB2-From-Code (Ind-WS)                      13830000
KUTT  *                                  =     FK-TFSC-Code-From        13840000
KUTT  *            and   WS-DB2-To-Type (Ind-WS)                        13850000
KUTT  *                                  =     FK-TFST-Type-To          13860000
KUTT  *            and   WS-DB2-To-F-I-Id     (Ind-WS)                  13870000
KUTT  *                                  =     FK-OAKO-FINI-To          13880000
KUTT  *            and   WS-DB2-To-Contr-Type (Ind-WS)                  13890000
KUTT  *                                  =     FK-TFSC-COTY-To          13900000
KUTT  *            and   WS-DB2-To-Code (Ind-WS)                        13910000
KUTT  *                                  =     FK-TFSC-Code-To          13920000
KUTT  *            and   WS-DB2-Rel-Type (Ind-WS)                       13930000
KUTT  *                                  =     TFSR-Type )              13940000
KUTT  *                                                                 13950000
                   or  ( WS-DB2-Fin-Inst-Id     (Ind-WS)                13960000
                                         =     FK-OAKO-FINI-FROM        13970000
                   and   WS-DB2-From-Type (Ind-WS)                      13980000
                                         =     FK-TFST-Type-From        13990000
                   and   WS-DB2-To-Type (Ind-WS)                        14000000
                                         =     FK-TFST-Type-To          14010000
                   and   WS-DB2-Rel-Type (Ind-WS)                       14020000
                                         =     TFSR-Type                14030000
                   and   WS-DB2-From-Code (Ind-WS)                      14040000
                                         =     FK-TFSC-Code-From        14050000
                   and   WS-DB2-To-Code (Ind-WS)                        14060000
                                         =     FK-TFSC-Code-To          14070000
                   and   WS-DB2-From-Contr-Type (Ind-WS)                14080000
                                         =     FK-TFSC-COTY-FROM        14090000
                   and   WS-DB2-To-Contr-Type (Ind-WS)                  14100000
                                         =     FK-TFSC-COTY-To )        14110000
           End-Perform                                                  14120000
      *                                                                 14130000
           Evaluate True                                                14140000
             When Ind-WS                 >     W-Max-Occ-WS-Tab         14150000
               Continue                                                 14160000
      *                                                                 14170000
             When other                                                 14180000
               Initialize                      WS-DB2-Row (Ind-WS)      14190000
      *                                                                 14200000
           End-Evaluate                                                 14210000
      *                                                                 14220000
           .                                                            14230000
      *################################################################*14240000
       N100-Fetch-Fin-Inst-ID            Section.                       14250000
      *                                                                 14260000
           Move  W-Fin-Inst-No (1:4)     To    W-Tmp-Konsern-Nr         14270000
      *                                                                 14280000
           If  Not R5879010-Versjon                                     14290000
           or  R5879010-In-Konsernnr     Not = W-Tmp-Konsern-Nr         14300000
      *                                                                 14310000
               Initialize                      R5879010-Konsern         14320000
               Set   R5879010-Versjon    To    True                     14330000
               Set   R5879010-In-Select  To    True                     14340000
               Move  W-Tmp-Konsern-Nr    To    R5879010-In-Konsernnr    14350000
               Call  'F5879010'          Using R5879010-Konsern         14360000
                                               R7919999-Error-Area      14370000
               End-Call                                                 14380000
               If  Not R7919999-Return-OK                               14390000
                   Move  'N101'          To    R7919999-Paragraph       14400000
                   Perform Z900-Abend                                   14410000
               End-If                                                   14420000
      *                                                                 14430000
           End-If                                                       14440000
      *                                                                 14450000
           Move  R5879010-Ut-KO-Konsern-Id                              14460000
                                         To    W-Fin-Inst-ID            14470000
      *                                                                 14480000
           .                                                            14490000
      *################################################################*14500000
       N200-Fetch-Fin-Inst-No            Section.                       14510000
      *                                                                 14520000
           If  Not R5879010-Versjon                                     14530000
           or  R5879010-In-Konsern-ID    Not = W-Fin-Inst-ID            14540000
      *                                                                 14550000
               Initialize                      R5879010-Konsern         14560000
               Set   R5879010-Versjon    To    True                     14570000
               Set   R5879010-In-Select  To    True                     14580000
               Move  W-Fin-Inst-ID       To    R5879010-In-Konsern-ID   14590000
               Call  'F5879010'          Using R5879010-Konsern         14600000
                                               R7919999-Error-Area      14610000
               End-Call                                                 14620000
               If  Not R7919999-Return-OK                               14630000
                   Move  'N201'          To    R7919999-Paragraph       14640000
                   Perform Z900-Abend                                   14650000
               End-If                                                   14660000
      *                                                                 14670000
           End-If                                                       14680000
      *                                                                 14690000
           Move  R5879010-Ut-KO-Konsernnummer                           14700000
                                         To    W-Tmp-Konsern-Nr         14710000
           Move  W-Tmp-Konsern-Nr        To    W-Fin-Inst-No            14720000
      *                                                                 14730000
           .                                                            14740000
      *################################################################*14750000
       ZI00-Conv-Input-Version           Section.                       14760000
      *                                                                 14770000
      * Version control.                                                14780000
      * If conversion is needed, we call the conversion module.         14790000
      *                                                                 14800000
           Set   R115ISR0-Version        To    True                     14810000
           Move  Length                  Of    R115ISR0-Sys-Code-Rel    14820000
                                         To    W-IO-Length              14830000
      *                                                                 14840000
           Evaluate True                                                14850000
             When L-Ext-IO-Area (1:8)    =     R115ISR0-Version-No      14860000
             and  Length                 Of    L-Ext-IO-Area            14870000
                                         Not < W-IO-Length              14880000
               Move  L-Ext-IO-Area (1:W-IO-Length)                      14890000
                                         To    W-Int-IO-Area            14900000
      *                                                                 14910000
             When Other                                                 14920000
               Call  'F115I999'                                         14930000
                   Using By Content      'F115ISR0 '                    14940000
                                         'INPUT '                       14950000
                         By Reference    L-Ext-IO-Area                  14960000
                                         W-Int-IO-Area                  14970000
                                         R7919999-Error-Area            14980000
               End-Call                                                 14990000
      *                                                                 15000000
               If  R7919999-Return-Abend                                15010000
                   Move  'ZI03'          To    R7919999-Paragraph       15020000
                   Perform Z900-Abend                                   15030000
               End-If                                                   15040000
      *                                                                 15050000
           End-Evaluate                                                 15060000
      *                                                                 15070000
           .                                                            15080000
      *################################################################*15090000
       ZO00-Conv-Output-Version          Section.                       15100000
      *                                                                 15110000
      * Version control.                                                15120000
      * If conversion is needed, we call the conversion module.         15130000
      *                                                                 15140000
           Evaluate True                                                15150000
             When L-Ext-IO-Area (1:8)    =     R115ISR0-Version-No      15160000
             and  Length                 Of    L-Ext-IO-Area            15170000
                                         Not < W-IO-Length              15180000
               Move  W-Int-IO-Area       To    L-Ext-IO-Area            15190000
                                                         (1:W-IO-Length)15200000
      *                                                                 15210000
             When Other                                                 15220000
               Call  'F115I999'                                         15230000
                   Using By Content      'F115ISR0 '                    15240000
                                         'OUTPUT '                      15250000
                         By Reference    L-Ext-IO-Area                  15260000
                                         W-Int-IO-Area                  15270000
                                         R7919999-Error-Area            15280000
               End-Call                                                 15290000
      *                                                                 15300000
               If  R7919999-Return-Abend                                15310000
                   Move  'ZO01'          To    R7919999-Paragraph       15320000
                   Perform Z900-Abend                                   15330000
               End-If                                                   15340000
      *                                                                 15350000
           End-Evaluate                                                 15360000
      *                                                                 15370000
           .                                                            15380000
      *################################################################*15390000
       Z000-Error-Message                Section.                       15400000
      *                                                                 15410000
           Set   R7918030-Version        To    True                     15420000
      *                                                                 15430000
           Move  'TF'                    To    R7918030-In-System-ID    15440000
           Move  R115X000-Fin-Inst-No    To    R7918030-In-Fin-Inst-No  15450000
           Move  R115X000-FI-Language-639-1                             15460000
                                         To    R7918030-In-Language     15470000
           If  R115X000-Trace-On                                        15480000
               Set   R7918030-In-Log-Yes To    True                     15490000
           End-If                                                       15500000
      *                                                                 15510000
           Call  'F7918030'              Using R7918030-ErrorMessage    15520000
           End-Call                                                     15530000
      *                                                                 15540000
           Move  R7918030-Out-MessageText                               15550000
                                         To    R7919999-Message         15560000
      *                                                                 15570000
           .                                                            15580000
      *################################################################*15590000
       Z900-Abend                        Section.                       15600000
      *                                                                 15610000
           If  R7919999-Return-Code      Not   Numeric                  15620000
           or  Not R7919999-Return-Abend                                15630000
               Move  +0                  To    R7919999-Module-Ind      15640000
           End-If                                                       15650000
      *                                                                 15660000
           Add   +1                      To    R7919999-Module-Ind      15670000
      *                                                                 15680000
           If  R7919999-Module-Ind       Not >                          15690000
                             ( Length    Of    R7919999-Module-Tab      15700000
                             / Length    Of    R7919999-Module-Element )15710000
               Move  'F115ISR0'          To    R7919999-Module-Name     15720000
                                                   (R7919999-Module-Ind)15730000
               Move  R7919999-Paragraph  To    R7919999-Module-Para     15740000
                                                   (R7919999-Module-Ind)15750000
           End-If                                                       15760000
      *                                                                 15770000
           Set   R7919999-Return-Abend   To    TRUE                     15780000
      *                                                                 15790000
           Goback.                                                      15800000
