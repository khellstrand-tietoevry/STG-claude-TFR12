      *################################################################.02550000
       Linkage Section.                                                 02560000
      *                                                                 02570000
       01  L-Ext-IO-Area                 Pic  X(560).                   02580000
       Copy R7919999.                                                   02590000
      *                                                                 02600000
      *################################################################.02610000
       Procedure Division                Using L-Ext-IO-Area            02620000
                                               R7919999-Error-Area.     02630000
      *                                                                 02640000
       A000-Main                         Section.                       02650000
      *                                                                 02660000
           Perform B000-Initialize                                      02670000
      *                                                                 02680000
           Evaluate True                                                02690000
             When SW-IA-Initialize                                      02700000
               Continue                                                 02710000
      *                                                                 02720000
             When Other                                                 02730000
               Perform ZI00-Conv-Input-Version                          02740000
               Perform C000-Interface                                   02750000
               Perform ZO00-Conv-Output-Version                         02760000
      *                                                                 02770000
           End-Evaluate                                                 02780000
      *                                                                 02790000
           Goback.                                                      02800000
      *################################################################*02810000
       B000-Initialize                   Section.                       02820000
      *                                                                 02830000
           Set   R7919999-Return-OK      To    True                     02840000
      *                                                                 02850000
           Evaluate True                                                02860000
             When L-Ext-IO-Area (1:10)   =     'INITIALIZE'             02870000
               Set   Sw-IA-Initialize    To    True                     02880000
             When Other                                                 02890000
               Move  Space               To    W-Input-Action           02900000
           End-Evaluate                                                 02910000
      *                                                                 02920000
           Compute  W-Max-Occ-WS-Tab                                    02930000
               =    Length               Of    WS-DB2-Table             02940000
               /    Length               Of    WS-DB2-Row               02950000
      *                                                                 02960000
           If  Sw-IA-Initialize                                         02970000
           or  WS-DB2-Row-Status (1)     Not   Numeric                  02980000
               Initialize                      W-Storage                02990000
               Move  +0                  To    Ind-WS-Put               03000000
           End-If                                                       03010000
      *                                                                 03020000
           If  WC-Row-No                 Not   Numeric                  03030000
           or  WC-Total-No-Of-Rows       Not   Numeric                  03040000
               Initialize                      WC-Counters              03050000
           End-If                                                       03060000
      *                                                                 03070000
           Evaluate True                                                03080000
             When Not R115X000-Is-Initiated                             03090000
               Initialize                      R115X000-External-Data   03100000
             When Not R115X000-Version                                  03110000
               Initialize                      R7918030-ErrorMessage    03120000
               Move  'GL-VERSION-INVALID'                               03130000
                                         To    R7918030-In-MessageCode  03140000
               Move  'VAR1'              To R7918030-In-Variable-Key (1)03150000
               Move  R115X000-Version-No To R7918030-In-Variable-Data(1)03160000
               Move  'VAR2'              To R7918030-In-Variable-Key (2)03170000
               Move  'R115X000'          To R7918030-In-Variable-Data(2)03180000
               Perform Z000-Error-Message                               03190000
               Move  'B001'              To    R7919999-Paragraph       03200000
               Perform Z900-Abend                                       03210000
           End-Evaluate                                                 03220000
      *                                                                 03230000
           .                                                            03240000
      *################################################################.03250000
       C000-Interface                    Section.                       03260000
      *                                                                 03270000
           Evaluate True                                                03280000
             When R115ISR0-In-Get-1st                                   03290000
               Perform C100-Initialize-Output                           03300000
               Perform D000-Get-1st                                     03310000
               Perform E000-Get-Next                                    03320000
      *                                                                 03330000
             When R115ISR0-In-Get-Next                                  03340000
               Perform C100-Initialize-Output                           03350000
               Perform E000-Get-Next                                    03360000
      *                                                                 03370000
             When R115ISR0-In-Select                                    03380000
               Perform C100-Initialize-Output                           03390000
               Perform F000-Select                                      03400000
      *                                                                 03410000
             When R115ISR0-In-Insert                                    03420000
               Perform G000-Insert                                      03430000
      *                                                                 03440000
      *      When R115ISR0-In-Update                                    03450000
      *        Perform H000-Update                                      03460000
      *                                                                 03470000
             When R115ISR0-In-Delete                                    03480000
