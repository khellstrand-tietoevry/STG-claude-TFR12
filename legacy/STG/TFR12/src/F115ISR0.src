               10  WS-From-Type          Pic  X(20).                    01950000
               10  WS-To-Type            Pic  X(20).                    01960000
               10  WS-Rel-Type           Pic  X(20).                    01970000
               10  WS-From-Code          Pic  X(20).                    01980000
               10  WS-To-Code            Pic  X(20).                    01990000
               10  WS-From-Contr-Type    Pic  X(03).                    02000000
               10  WS-To-Contr-Type      Pic  X(03).                    02010000
             07  WS-Code-Sequence        Pic  X(01).                    02020000
               88  WS-CS-Ascending                  Value 'A'.          02030000
               88  WS-CS-Descending                 Value 'D'.          02040000
             07  WS-Cursor-Status        Pic  X(08).                    02050000
               88  WS-Cursor-OK                     Value 'OK'.         02060000
