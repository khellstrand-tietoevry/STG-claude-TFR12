           Initialize                          R115ICAS-SQL-Submodules  07590000
           Set   R115ICAS-Version        To    True                     07600000
           Set   R115ICAS-In-Insert      To    True                     07610000
           Move  R115ICA0-In-Table-Version                              07620000
                                         To    R115ICAS-In-Table-Version07630000
      *                                                                 07640000
           Call  'F115ICAU'              Using R115ICAS-SQL-Submodules  07650000
                                               DCLTF-Contract-Amount    07660000
                                               R7919999-Error-Area      07670000
           End-Call                                                     07680000
      *                                                                 07690000
           Evaluate True                                                07700000
             When R7919999-Return-OK                                    07710000
               Continue                                                 07720000
      *                                                                 07730000
             When R7919999-Return-Error                                 07740000
               Continue                                                 07750000
      *                                                                 07760000
             When other                                                 07770000
               Move  'G201'              To    R7919999-Paragraph       07780000
               Perform Z900-Abend                                       07790000
      *                                                                 07800000
           End-Evaluate                                                 07810000
      *                                                                 07820000
           .                                                            07830000
      *################################################################.07840000
       H000-Update                       Section.                       07850000
      *                                                                 07860000
           Perform H100-Check-Qualification                             07870000
           Perform G100-Move-Input-To-DCL                               07880000
      *                                                                 07890000
           Perform H200-Update-Row                                      07900000
      *                                                                 07910000
           Perform L300-Remove-DCL                                      07920000
           Perform L100-Store-DCL                                       07930000
      *                                                                 07940000
           .                                                            07950000
      *################################################################.07960000
       H100-Check-Qualification          Section.                       07970000
      *                                                                 07980000
           Evaluate True                                                07990000
             When R115ICA0-Fin-Inst-ID   Not = +0                       08000000
               Continue                                                 08010000
                                                                        08020000
             When R115ICA0-Fin-Inst-No   Not = Space                    08030000
               Move  R115ICA0-Fin-Inst-No                               08040000
                                         To    W-Fin-Inst-No            08050000
               Perform N100-Fetch-Fin-Inst-ID                           08060000
               Move  W-Fin-Inst-ID       To    R115ICA0-Fin-Inst-ID     08070000
                                                                        08080000
             When R115ICA0-In-Fin-Inst-Id Not = +0                      08090000
               Move R115ICA0-In-Fin-Inst-ID                             08100000
                                         To    R115ICA0-Fin-Inst-ID     08110000
                                                                        08120000
             When R115ICA0-In-Fin-Inst-No                               08130000
                                         Not = Space                    08140000
               Move  R115ICA0-In-Fin-Inst-No                            08150000
                                         To    W-Fin-Inst-No            08160000
               Perform N100-Fetch-Fin-Inst-ID                           08170000
               Move  W-Fin-Inst-ID       To    R115ICA0-Fin-Inst-ID     08180000
                                                                        08190000
             When other                                                 08200000
               Initialize                      R7918030-ErrorMessage    08210000
               Move  'TF-FIN-INST-MISSING'                              08220000
                                         To    R7918030-In-MessageCode  08230000
               Perform Z000-Error-Message                               08240000
               Set   R7919999-Return-Error                              08250000
                                         To    True                     08260000
                                                                        08270000
           End-Evaluate                                                 08280000
      *                                                                 08290000
           Evaluate True                                                08300000
             When R115ICA0-Contract-Type Not = Space                    08310000
               Continue                                                 08320000
                                                                        08330000
             When R115ICA0-In-Contract-Type                             08340000
                                         Not = Space                    08350000
               Move R115ICA0-In-Contract-Type                           08360000
                                         To    R115ICA0-Contract-Type   08370000
                                                                        08380000
             When other                                                 08390000
               Initialize                      R7918030-ErrorMessage    08400000
               Move  'TF-CONTRACT-MISSING'                              08410000
                                         To    R7918030-In-MessageCode  08420000
               Perform Z000-Error-Message                               08430000
               Set   R7919999-Return-Error                              08440000
                                         To    True                     08450000
                                                                        08460000
           End-Evaluate                                                 08470000
      *                                                                 08480000
           Evaluate True                                                08490000
             When R115ICA0-Contract-No   Not = +0                       08500000
               Continue                                                 08510000
                                                                        08520000
             When R115ICA0-In-Contract-No                               08530000
                                         Not = +0                       08540000
               Move R115ICA0-In-Contract-No                             08550000
                                         To    R115ICA0-Contract-No     08560000
                                                                        08570000
             When other                                                 08580000
               Initialize                      R7918030-ErrorMessage    08590000
               Move  'TF-CONTRACT-MISSING'                              08600000
                                         To    R7918030-In-MessageCode  08610000
               Perform Z000-Error-Message                               08620000
               Set   R7919999-Return-Error                              08630000
                                         To    True                     08640000
                                                                        08650000
           End-Evaluate                                                 08660000
      *                                                                 08670000
           Evaluate True                                                08680000
             When R115ICA0-Currency      Not = Space                    08690000
               Continue                                                 08700000
                                                                        08710000
             When R115ICA0-In-Currency   Not = Space                    08720000
               Move R115ICA0-In-Currency To    R115ICA0-Currency        08730000
                                                                        08740000
             When other                                                 08750000
               Initialize                      R7918030-ErrorMessage    08760000
               Move  'TF-CURRENCY-MISSING'                              08770000
                                         To    R7918030-In-MessageCode  08780000
               Perform Z000-Error-Message                               08790000
               Set   R7919999-Return-Error                              08800000
                                         To    True                     08810000
                                                                        08820000
           End-Evaluate                                                 08830000
      *                                                                 08840000
           .                                                            08850000
      *################################################################.08860000
       H200-Update-Row                   Section.                       08870000
      *                                                                 08880000
           Initialize                          R115ICAS-SQL-Submodules  08890000
           Set   R115ICAS-Version        To    True                     08900000
           Set   R115ICAS-In-Update      To    True                     08910000
           Move  R115ICA0-In-Table-Version                              08920000
                                         To    R115ICAS-In-Table-Version08930000
      *                                                                 08940000
           Call  'F115ICAU'              Using R115ICAS-SQL-Submodules  08950000
                                               DCLTF-Contract-Amount    08960000
                                               R7919999-Error-Area      08970000
           End-Call                                                     08980000
      *                                                                 08990000
           Evaluate True                                                09000000
             When R7919999-Return-OK                                    09010000
               Continue                                                 09020000
      *                                                                 09030000
             When R7919999-Return-Error                                 09040000
               Continue                                                 09050000
      *                                                                 09060000
             When other                                                 09070000
               Move  'H201'              To    R7919999-Paragraph       09080000
               Perform Z900-Abend                                       09090000
      *                                                                 09100000
           End-Evaluate                                                 09110000
      *                                                                 09120000
           .                                                            09130000
      *################################################################.09140000
       I000-Delete                       Section.                       09150000
      *                                                                 09160000
           Perform F100-Prepare-Qualification                           09170000
           Perform I200-Delete-Row                                      09180000
      *                                                                 09190000
           Perform L300-Remove-DCL                                      09200000
      *                                                                 09210000
           .                                                            09220000
      *################################################################.09230000
       I200-Delete-Row                   Section.                       09240000
      *                                                                 09250000
           Initialize                          R115ICAS-SQL-Submodules  09260000
           Set   R115ICAS-Version        To    True                     09270000
           Set   R115ICAS-In-Delete      To    True                     09280000
           Move  R115ICA0-In-Table-Version                              09290000
                                         To    R115ICAS-In-Table-Version09300000
      *                                                                 09310000
           Call  'F115ICAU'              Using R115ICAS-SQL-Submodules  09320000
                                               DCLTF-Contract-Amount    09330000
                                               R7919999-Error-Area      09340000
           End-Call                                                     09350000
      *                                                                 09360000
           Evaluate True                                                09370000
             When R7919999-Return-OK                                    09380000
               Continue                                                 09390000
      *                                                                 09400000
             When R7919999-Return-Error                                 09410000
               Continue                                                 09420000
      *                                                                 09430000
             When other                                                 09440000
               Move  'I201'              To    R7919999-Paragraph       09450000
               Perform Z900-Abend                                       09460000
      *                                                                 09470000
           End-Evaluate                                                 09480000
      *                                                                 09490000
           .                                                            09500000
      *################################################################.09510000
       J000-Get-Columns                  Section.                       09520000
      *                                                                 09530000
           Perform J100-Move-DCL-To-Output                              09540000
      *                                                                 09550000
           .                                                            09560000
      *################################################################.09570000
       J100-Move-DCL-To-Output           Section.                       09580000
      *                                                                 09590000
      * PLEASE REMEMBER:                                                09600000
      *    When you modify the code in this section, you need to do     09610000
      *    the same modifications in module F115ACA0 - E500-section.    09620000
      *                                                                 09630000
           Move  FK-OAKO-FinInst-ID      To    R115ICA0-Fin-Inst-ID     09640000
           Move  FK-TFMC-Contr-Type      To    R115ICA0-Contract-Type   09650000
           Move  FK-TFMC-Contr-No        To    R115ICA0-Contract-No     09660000
      *                                                                 09670000
           Move  FK-OAKO-FinInst-ID      To    W-Fin-Inst-ID            09680000
           Perform N200-Fetch-Fin-Inst-No                               09690000
           Move  W-Fin-Inst-No           To    R115ICA0-Fin-Inst-No     09700000
      *                                                                 09710000
           Move  TFCA-Currency           To    R115ICA0-Currency        09720000
           Move  TFCA-Orig-Amount        To    R115ICA0-Original-Amount 09730000
           Move  TFCA-Remain-Amount      To    R115ICA0-Remaining-Amount09740000
           Move  TFCA-Min-Pct-Toler      To  R115ICA0-Min-Pct-Tolerance 09750000
           Move  TFCA-Max-Pct-Toler      To  R115ICA0-Max-Pct-Tolerance 09760000
           Move  TFCA-Prev-O-Amount      To  R115ICA0-Prev-O-Amount     09770000
           Move  TFCA-Curr-O-Amount      To  R115ICA0-Curr-O-Amount     09780000
      *                                                                 09790000
           Compute  R115ICA0-Max-Amount                                 09800000
               =    TFCA-Remain-Amount                                  09810000
               +  ( TFCA-Remain-Amount * TFCA-Max-Pct-Toler / 100 )     09820000
      *                                                                 09830000
      * Info about the cursor:                                          09840000
      *                                                                 09850000
           Move  WC-Row-No               To  R115ICA0-Out-Row-No        09860000
           Move  WC-Total-No-Of-Rows     To  R115ICA0-Out-Total-Rows    09870000
      *                                                                 09880000
           .                                                            09890000
      *################################################################.09900000
       L100-Store-DCL                    Section.                       09910000
      *                                                                 09920000
      * We might already have this row in storage.                      09930000
      *                                                                 09940000
           Perform L200-Find-DCL                                        09950000
      *                                                                 09960000
           If  Ind-WS                    >     W-Max-Occ-WS-Tab         09970000
           or  WS-DB2-Not-Read (Ind-WS)                                 09980000
             Then                                                       09990000
      *        If we have reached the end of the storage-table,         10000000
      *        we start on the beginning.                               10010000
      *        This way, we always keep the "newest" occurrences.       10020000
               Add   +1                  To    Ind-WS-Put               10030000
               If  Ind-WS-Put            >     W-Max-Occ-WS-Tab         10040000
                   Move  +1              To    Ind-WS-Put               10050000
               End-If                                                   10060000
               Move  Ind-WS-Put          To    Ind-WS                   10070000
             Else                                                       10080000
               Move  Ind-WS              To    Ind-WS-Put               10090000
           End-If                                                       10100000
      *                                                                 10110000
      * We store the identification.                                    10120000
      *                                                                 10130000
           Move  R115ICA0-In-Table-Version                              10140000
                                         To    WS-DB2-Tbl-Version       10150000
                                                            (Ind-WS-Put)10160000
           Move  FK-OAKO-FinInst-ID      To    WS-DB2-Fin-Inst-ID       10170000
                                                            (Ind-WS-Put)10180000
           Move  FK-TFMC-Contr-Type      To    WS-DB2-Contract-Type     10190000
                                                            (Ind-WS-Put)10200000
           Move  FK-TFMC-Contr-No        To    WS-DB2-Contract-No       10210000
                                                            (Ind-WS-Put)10220000
           Move  TFCA-Currency           To    WS-DB2-Currency          10230000
                                                            (Ind-WS-Put)10240000
      *                                                                 10250000
      * The DCL is stored if found, the status is set.                  10260000
      *                                                                 10270000
           Evaluate True                                                10280000
             When Length                 Of    DCLTF-Contract-Amount    10290000
                > Length                 Of    WS-DB2-DCL               10300000
               Move  Length              Of    DCLTF-Contract-Amount    10310000
                                         To    WD-Length                10320000
               Initialize                      R7918030-ErrorMessage    10330000
               Move  'GL-WL-DCL-UTVIDES' To    R7918030-In-MessageCode  10340000
               Move  'VAR1'              To R7918030-In-Variable-Key (1)10350000
               Move  WD-Length           To R7918030-In-Variable-Data(1)10360000
               Perform Z000-Error-Message                               10370000
               Move  'L101'              To    R7919999-Paragraph       10380000
               Perform Z900-Abend                                       10390000
      *                                                                 10400000
             When R7919999-Return-Error                                 10410000
               Set   WS-DB2-Not-Found (Ind-WS-Put)                      10420000
                                         To    True                     10430000
      *                                                                 10440000
             When other                                                 10450000
               Move  DCLTF-Contract-Amount                              10460000
                                         To    WS-DB2-DCL   (Ind-WS-Put)10470000
               Set   WS-DB2-Read (Ind-WS-Put)                           10480000
                                         To    True                     10490000
      *                                                                 10500000
           End-Evaluate                                                 10510000
      *                                                                 10520000
           .                                                            10530000
      *################################################################.10540000
       L200-Find-DCL                     Section.                       10550000
      *                                                                 10560000
           Perform Varying Ind-WS                                       10570000
                   From  +1              By    +1                       10580000
                   Until Ind-WS          >     W-Max-Occ-WS-Tab         10590000
                   or  ( WS-DB2-Tbl-Version (Ind-WS)                    10600000
                                         =     R115ICA0-In-Table-Version10610000
                     and WS-DB2-Fin-Inst-ID (Ind-WS)                    10620000
                                         =     FK-OAKO-FinInst-ID       10630000
                     and WS-DB2-Contract-Type (Ind-WS)                  10640000
                                         =     FK-TFMC-Contr-Type       10650000
                     and WS-DB2-Contract-No (Ind-WS)                    10660000
                                         =     FK-TFMC-Contr-No         10670000
                     and WS-DB2-Currency (Ind-WS)                       10680000
                                         =     TFCA-Currency )          10690000
           End-Perform                                                  10700000
      *                                                                 10710000
           .                                                            10720000
      *################################################################*10730000
       L300-Remove-DCL                   Section.                       10740000
      *                                                                 10750000
           Perform Varying Ind-WS                                       10760000
                   From  +1              By    +1                       10770000
                   Until Ind-WS          >     W-Max-Occ-WS-Tab         10780000
                   or  ( WS-DB2-Tbl-Version (Ind-WS)                    10790000
                                         =     R115ICA0-In-Table-Version10800000
                     and WS-DB2-Fin-Inst-ID (Ind-WS)                    10810000
                                         =     FK-OAKO-FinInst-ID       10820000
                     and WS-DB2-Contract-Type (Ind-WS)                  10830000
                                         =     FK-TFMC-Contr-Type       10840000
                     and WS-DB2-Contract-No (Ind-WS)                    10850000
                                         =     FK-TFMC-Contr-No         10860000
                     and WS-DB2-Currency (Ind-WS)                       10870000
                                         =     TFCA-Currency )          10880000
           End-Perform                                                  10890000
      *                                                                 10900000
           Evaluate True                                                10910000
             When Ind-WS                 >     W-Max-Occ-WS-Tab         10920000
               Continue                                                 10930000
      *                                                                 10940000
             When other                                                 10950000
               Initialize                      WS-DB2-Row (Ind-WS)      10960000
      *                                                                 10970000
           End-Evaluate                                                 10980000
      *                                                                 10990000
           .                                                            11000000
      *################################################################*11010000
       N100-Fetch-Fin-Inst-ID            Section.                       11020000
      *                                                                 11030000
           Move  W-Fin-Inst-No (1:4)     To    W-Tmp-Konsern-Nr         11040000
      *                                                                 11050000
           If  Not R5879010-Versjon                                     11060000
           or  R5879010-In-Konsernnr     Not = W-Tmp-Konsern-Nr         11070000
      *                                                                 11080000
               Initialize                      R5879010-Konsern         11090000
               Set   R5879010-Versjon    To    True                     11100000
               Set   R5879010-In-Select  To    True                     11110000
               Move  W-Tmp-Konsern-Nr    To    R5879010-In-Konsernnr    11120000
               Call  'F5879010'          Using R5879010-Konsern         11130000
                                               R7919999-Error-Area      11140000
               End-Call                                                 11150000
               If  Not R7919999-Return-OK                               11160000
                   Move  'N101'          To    R7919999-Paragraph       11170000
                   Perform Z900-Abend                                   11180000
               End-If                                                   11190000
      *                                                                 11200000
           End-If                                                       11210000
      *                                                                 11220000
           Move  R5879010-Ut-KO-Konsern-Id                              11230000
                                         To    W-Fin-Inst-ID            11240000
      *                                                                 11250000
           .                                                            11260000
      *################################################################*11270000
       N200-Fetch-Fin-Inst-No            Section.                       11280000
      *                                                                 11290000
           If  Not R5879010-Versjon                                     11300000
           or  R5879010-In-Konsern-ID    Not = W-Fin-Inst-ID            11310000
      *                                                                 11320000
               Initialize                      R5879010-Konsern         11330000
               Set   R5879010-Versjon    To    True                     11340000
               Set   R5879010-In-Select  To    True                     11350000
               Move  W-Fin-Inst-ID       To    R5879010-In-Konsern-ID   11360000
               Call  'F5879010'          Using R5879010-Konsern         11370000
                                               R7919999-Error-Area      11380000
               End-Call                                                 11390000
               If  Not R7919999-Return-OK                               11400000
                   Move  'N201'          To    R7919999-Paragraph       11410000
                   Perform Z900-Abend                                   11420000
               End-If                                                   11430000
      *                                                                 11440000
           End-If                                                       11450000
      *                                                                 11460000
           Move  R5879010-Ut-KO-Konsernnummer                           11470000
                                         To    W-Tmp-Konsern-Nr         11480000
           Move  W-Tmp-Konsern-Nr        To    W-Fin-Inst-No            11490000
      *                                                                 11500000
           .                                                            11510000
      *################################################################*11520000
       ZI00-Conv-Input-Version           Section.                       11530000
      *                                                                 11540000
      * Version control.                                                11550000
      * If conversion is needed, we call the conversion module.         11560000
      *                                                                 11570000
           Set   R115ICA0-Version        To    True                     11580000
           Move  Length                  Of    R115ICA0-Contract-Amount 11590000
                                         To    W-IO-Length              11600000
      *                                                                 11610000
           Evaluate True                                                11620000
             When L-Ext-IO-Area (1:8)    =     R115ICA0-Version-No      11630000
             and  Length                 Of    L-Ext-IO-Area            11640000
                                         Not < W-IO-Length              11650000
               Move  L-Ext-IO-Area (1:W-IO-Length)                      11660000
                                         To    W-Int-IO-Area            11670000
      *                                                                 11680000
             When Other                                                 11690000
               Call  'F115I999'                                         11700000
                   Using By Content      'F115ICA0 '                    11710000
                                         'INPUT '                       11720000
                         By Reference    L-Ext-IO-Area                  11730000
                                         W-Int-IO-Area                  11740000
                                         R7919999-Error-Area            11750000
               End-Call                                                 11760000
      *                                                                 11770000
               If  R7919999-Return-Abend                                11780000
                   Move  'ZI03'          To    R7919999-Paragraph       11790000
                   Perform Z900-Abend                                   11800000
               End-If                                                   11810000
      *                                                                 11820000
           End-Evaluate                                                 11830000
      *                                                                 11840000
           .                                                            11850000
      *################################################################*11860000
       ZO00-Conv-Output-Version          Section.                       11870000
      *                                                                 11880000
      * Version control.                                                11890000
      * If conversion is needed, we call the conversion module.         11900000
      *                                                                 11910000
           Evaluate True                                                11920000
             When L-Ext-IO-Area (1:8)    =     R115ICA0-Version-No      11930000
             and  Length                 Of    L-Ext-IO-Area            11940000
                                         Not < W-IO-Length              11950000
               Move  W-Int-IO-Area       To    L-Ext-IO-Area            11960000
                                                         (1:W-IO-Length)11970000
      *                                                                 11980000
             When Other                                                 11990000
               Call  'F115I999'                                         12000000
                   Using By Content      'F115ICA0 '                    12010000
                                         'OUTPUT '                      12020000
                         By Reference    L-Ext-IO-Area                  12030000
                                         W-Int-IO-Area                  12040000
                                         R7919999-Error-Area            12050000
               End-Call                                                 12060000
      *                                                                 12070000
               If  R7919999-Return-Abend                                12080000
                   Move  'ZO01'          To    R7919999-Paragraph       12090000
                   Perform Z900-Abend                                   12100000
               End-If                                                   12110000
      *                                                                 12120000
           End-Evaluate                                                 12130000
      *                                                                 12140000
           .                                                            12150000
      *################################################################*12160000
       Z000-Error-Message                Section.                       12170000
      *                                                                 12180000
           Set   R7918030-Version        To    True                     12190000
      *                                                                 12200000
           Move  'TF'                    To    R7918030-In-System-ID    12210000
           Move  R115X000-Fin-Inst-No    To    R7918030-In-Fin-Inst-No  12220000
           Move  R115X000-FI-Language-639-1                             12230000
                                         To    R7918030-In-Language     12240000
           If  R115X000-Trace-On                                        12250000
               Set   R7918030-In-Log-Yes To    True                     12260000
           End-If                                                       12270000
      *                                                                 12280000
           Call  'F7918030'              Using R7918030-ErrorMessage    12290000
           End-Call                                                     12300000
      *                                                                 12310000
           Move  R7918030-Out-MessageText                               12320000
                                         To    R7919999-Message         12330000
      *                                                                 12340000
           .                                                            12350000
      *################################################################*12360000
       Z900-Abend                        Section.                       12370000
      *                                                                 12380000
           If  R7919999-Return-Code      Not   Numeric                  12390000
           or  Not R7919999-Return-Abend                                12400000
               Move  +0                  To    R7919999-Module-Ind      12410000
           End-If                                                       12420000
      *                                                                 12430000
           Add   +1                      To    R7919999-Module-Ind      12440000
      *                                                                 12450000
           If  R7919999-Module-Ind       Not >                          12460000
                             ( Length    Of    R7919999-Module-Tab      12470000
                             / Length    Of    R7919999-Module-Element )12480000
               Move  'F115ICA0'          To    R7919999-Module-Name     12490000
                                                   (R7919999-Module-Ind)12500000
               Move  R7919999-Paragraph  To    R7919999-Module-Para     12510000
                                                   (R7919999-Module-Ind)12520000
           End-If                                                       12530000
      *                                                                 12540000
           Set   R7919999-Return-Abend   To    TRUE                     12550000
      *                                                                 12560000
           Goback.                                                      12570000
