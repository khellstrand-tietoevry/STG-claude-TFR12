      * These fields will only be delivered if spesifically asked for:  05080000
      *                                                                 05090000
      *  - R5879010-Ut-KO-Kjoregruppe                                   05100000
      *  - R5879010-Ut-KO-Delgruppe                                     05110000
      *  - R5879010-Ut-KO-Oppdat-Kode                                   05120000
      *  - R5879010-Ut-KO-Mellomregnrte                                 05130000
      *                                                                 05140000
           If  R5879010-In-Xtra-Info-Yes                                05150000
               Perform G000-Get-Attributes                              05160000
           End-If                                                       05170000
      *                                                                 05180000
           .                                                            05190000
      *################################################################.05200000
       G000-Get-Attributes               Section.                       05210000
      *                                                                 05220000
           Perform G100-Get-Search-Date                                 05230000
           Perform G200-Get-1st-Attribute                               05240000
           If  R791ERRX-State-OK                                        05250000
               Perform G400-Extract-Attributes                          05260000
               Perform G300-Close-Attribute                             05270000
           End-If                                                       05280000
           Set   R791ERRX-State-OK       To    True                     05290000
      *                                                                 05300000
           .                                                            05310000
      *################################################################*05320000
       G100-Get-Search-Date              Section.                       05330000
      *                                                                 05340000
           If  Not R7918110-Versjon                                     05350000
      *                                                                 05360000
               Initialize                      R7918110-System-Datoer   05370000
               Set   R7918110-Versjon    To    True                     05380000
               Call  'F7918110'          Using R7918110-System-Datoer   05390000
                                               R7919999-Error           05400000
               End-Call                                                 05410000
               If  Not R7919999-Return-OK                               05420000
                   Move  'G101'          To    R7919999-Paragraph       05430000
                   Perform Z900-Abend                                   05440000
               End-If                                                   05450000
      *                                                                 05460000
           End-If                                                       05470000
      *                                                                 05480000
           Move  R7918110-Ut-Kjore-Dato  To    W-Search-Date            05490000
      *                                                                 05500000
           .                                                            05510000
      *################################################################.05520000
       G200-Get-1st-Attribute            Section.                       05530000
      *                                                                 05540000
           Initialize                          BZXOJNA0-OR-Org-Unit-Attr05550000
           Set   BZXOJNA0-EyeCatcher     To    True                     05560000
           Set   BZXOJNA0-Version        To    True                     05570000
      *                                                                 05580000
           Move  BZXOJOR0-OROR-Org-ID    To BZXOJNA0-In-FK-OR-Org-ID    05590000
           Move  'ORORH'                 To BZXOJNA0-In-FK-TY-Int-Code  05600000
           Move  W-Search-Date           To BZXOJNA0-In-ORNA-Val-From-Dt05610000
           Move  W-Search-Date           To BZXOJNA0-In-ORNA-Val-To-Dt  05620000
      *                                                                 05630000
           Set   BZXOJNA0-Cursor2-ET     To    True                     05640003
      *                                                                 05650003
           Set   BZXOJNA0-In-Get-1st     To    True                     05660000
           Move  R5879010-In-Gruppe      To    BZXOJNA0-In-PackageSet   05670009
      *                                                                 05680000
           Call  BZXOJNA0                Using BZXOJNA0-OR-Org-Unit-Attr05690002
           End-Call                                                     05700000
      *                                                                 05710000
           Evaluate True                                                05720000
             When R791ERRX-State-Abend                                  05730000
               Perform Zkey-Move-Keys                                   05740000
               Move  'G201'              To    R791ERR0-In-Paragraph-Id 05750000
               Perform Z300-Call-Trace-R7919999-2-Old                   05760000
           End-Evaluate                                                 05770000
      *                                                                 05780000
           .                                                            05790000
      *################################################################.05800000
       G300-Close-Attribute              Section.                       05810000
      *                                                                 05820000
           Set   BZXOJNA0-In-Close       To    True                     05830000
           Move  R5879010-In-Gruppe      To    BZXOJNA0-In-PackageSet   05840009
      *                                                                 05850000
           Call  BZXOJNA0                Using BZXOJNA0-OR-Org-Unit-Attr05860002
           End-Call                                                     05870000
      *                                                                 05880000
           Evaluate True                                                05890000
             When R791ERRX-State-Abend                                  05900000
               Perform Zkey-Move-Keys                                   05910000
               Move  'G301'              To    R791ERR0-In-Paragraph-Id 05920000
               Perform Z300-Call-Trace-R7919999-2-Old                   05930000
           End-Evaluate                                                 05940000
      *                                                                 05950000
           .                                                            05960000
      *################################################################.05970000
       G400-Extract-Attributes           Section.                       05980000
      *                                                                 05990000
           Initialize                          W-Ext-Fields             06000007
           Initialize                          WT-Data-Table            06010007
           Move  0                       To    W-Max-Occ-Data-Tbl       06020000
      *                                                                 06030000
           Unstring BZXOJNA0-ORNA-Data                                  06040000
             Delimited by                ':' or ';'                     06050000
             Into                        WT-Data-Key   (01)             06060000
                                         WT-Data-Value (01)             06070000
                                         WT-Data-Key   (02)             06080000
                                         WT-Data-Value (02)             06090000
                                         WT-Data-Key   (03)             06100000
                                         WT-Data-Value (03)             06110000
                                         WT-Data-Key   (04)             06120000
                                         WT-Data-Value (04)             06130000
                                         WT-Data-Key   (05)             06140000
                                         WT-Data-Value (05)             06150000
                                         WT-Data-Key   (06)             06160000
                                         WT-Data-Value (06)             06170000
                                         WT-Data-Key   (07)             06180000
                                         WT-Data-Value (07)             06190000
                                         WT-Data-Key   (08)             06200000
                                         WT-Data-Value (08)             06210000
                                         WT-Data-Key   (09)             06220000
                                         WT-Data-Value (09)             06230000
                                         WT-Data-Key   (10)             06240000
                                         WT-Data-Value (10)             06250000
             Tallying in                 W-Max-Occ-Data-Tbl             06260000
             On overflow                                                06270000
               Move  Space               To    R7919999-Message         06280000
               String 'For mange parameter-elementer'                   06290000
                      ', tabell må utvides.'   Delimited By Size        06300000
                                         Into  R7919999-Message         06310000
               End-String                                               06320000
               Move  'G401'              To    R7919999-Paragraph       06330000
               Perform Z900-Abend                                       06340000
           End-Unstring                                                 06350000
      *                                                                 06360000
           Perform Varying Ind-Data                                     06370000
                   From  +1              By    +1                       06380000
                   Until Ind-Data        >     W-Max-Occ-Data-Tbl       06390000
               Evaluate WT-Data-Key (Ind-Data)                          06400000
                 When 'GRP'                                             06410000
                   Move  WT-Data-Value (Ind-Data) (1:3)                 06420004
                                         To W-Ext-GRP                   06430000
                   Move  W-Ext-GRP       To R5879010-Ut-KO-Kjoregruppe  06440000
                 When 'SGRP'                                            06450000
                   Move  WT-Data-Value (Ind-Data) (1:4)                 06460000
                                         To W-Ext-SGRP                  06470000
                   Move  W-Ext-SGRP      To R5879010-Ut-KO-Delgruppe    06480000
                 When 'UPDC'                                            06490000
                   Move  WT-Data-Value (Ind-Data) (1:4)                 06500000
                                         To W-Ext-UPDC                  06510000
                   Move  W-Ext-UPDC      To R5879010-Ut-KO-Oppdat-Kode  06520000
                 When 'MRR'                                             06530000
                   Move  WT-Data-Value (Ind-Data) (1:6)                 06540004
                                         To W-Ext-MRR (1:6)             06550005
                   Move  W-Ext-MRR       To R5879010-Ut-KO-Mellomregnrte06560000
               End-Evaluate                                             06570000
           End-Perform                                                  06580000
      *                                                                 06590000
           .                                                            06600000
      *################################################################*06610000
       ZI00-Conv-Input-Version           Section.                       06620000
      *                                                                 06630000
      * Version handling - from external to internal area               06640000
      *                                                                 06650000
           Set   R5879010-Versjon        To    True                     06660000
           Move  Length                  Of    W-Int-IO-Area            06670000
                                         To    W-IO-Length              06680000
      *                                                                 06690000
           Evaluate True                                                06700000
             When L-Ext-IO-Area (1:8)    =     R5879010-Versjons-Nr     06710000
             and  Length                 Of    L-Ext-IO-Area            06720000
                                         Not < W-IO-Length              06730000
               Move  L-Ext-IO-Area (1:W-IO-Length)                      06740000
                                         To    W-Int-IO-Area            06750000
      *                                                                 06760000
             When Other                                                 06770000
               Call  'F5879990'                                         06780000
                   Using By Reference    WC-Program-ID                  06790000
                         By Content      'INPUT '                       06800000
                         By Reference    L-Ext-IO-Area                  06810000
                                         W-Int-IO-Area                  06820000
                                         R7919999-Error                 06830000
               End-Call                                                 06840000
      *                                                                 06850000
               If  R7919999-Return-Abend                                06860000
                   Move  'ZI01'          To    R7919999-Paragraph       06870000
                   Perform Z900-Abend                                   06880000
               End-If                                                   06890000
      *                                                                 06900000
           End-Evaluate                                                 06910000
      *                                                                 06920000
           .                                                            06930000
      *################################################################*06940000
       ZO00-Conv-Output-Version          Section.                       06950000
      *                                                                 06960000
      * Version handling - from internal to external area               06970000
      *                                                                 06980000
           Evaluate True                                                06990000
             When L-Ext-IO-Area (1:8)    =     R5879010-Versjons-Nr     07000000
             and  Length                 Of    L-Ext-IO-Area            07010000
                                         Not < W-IO-Length              07020000
               Move  W-Int-IO-Area       To    L-Ext-IO-Area            07030000
                                                         (1:W-IO-Length)07040000
      *                                                                 07050000
             When Other                                                 07060000
               Call  'F5879990'                                         07070000
                   Using By Reference    WC-Program-ID                  07080000
                         By Content      'OUTPUT '                      07090000
                         By Reference    L-Ext-IO-Area                  07100000
                                         W-Int-IO-Area                  07110000
                                         R7919999-Error                 07120000
               End-Call                                                 07130000
      *                                                                 07140000
               If  R7919999-Return-Abend                                07150000
                   Move  'ZO01'          To    R7919999-Paragraph       07160000
                   Perform Z900-Abend                                   07170000
               End-If                                                   07180000
      *                                                                 07190000
           End-Evaluate                                                 07200000
      *                                                                 07210000
           .                                                            07220000
      *################################################################*07230000
       Z900-Abend                        Section.                       07240000
      *                                                                 07250000
           If  R7919999-Return-Code      Not   Numeric                  07260000
           or  Not R7919999-Return-Abend                                07270000
               Move  +0                  To    R7919999-Module-Ind      07280000
           End-If                                                       07290000
      *                                                                 07300000
           Add   +1                      To    R7919999-Module-Ind      07310000
      *                                                                 07320000
           If  R7919999-Module-Ind       Not >                          07330000
                             ( Length    Of    R7919999-Module-Tab      07340000
                             / Length    Of    R7919999-Module-Element )07350000
               Move  WC-Program-ID       To    R7919999-Module-Name     07360000
                                                   (R7919999-Module-Ind)07370000
               Move  R7919999-Paragraph  To    R7919999-Module-Para     07380000
                                                   (R7919999-Module-Ind)07390000
           End-If                                                       07400000
      *                                                                 07410000
           Set   R7919999-Return-Abend   To    True                     07420000
      *                                                                 07430000
           Perform A200-Free-Packageset                                 07440000
      *                                                                 07450000
           Goback                                                       07460000
      *                                                                 07470000
           .                                                            07480000
      *################################################################*07490000
       Zkey-Move-Keys                    Section.                       07500000
      *                                                                 07510000
      * In-Konsern                                                      07520000
      *                                                                 07530000
           If  R5879010-In-Konsern-ID    Not = 0                        07540000
           or  R5879010-In-KonsernNr     Not = 0                        07550000
      *                                                                 07560000
               Perform Varying Ind-Key                                  07570000
                       From  +1          By +1                          07580000
                       Until Ind-Key     >     W-Max-Occ-Key-Tbl        07590000
                       or    R791ERR0-In-Key-Fin-Inst (Ind-Key)         07600000
                       or    R791ERR0-In-Key-Type (Ind-Key)             07610000
                                         =     Space                    07620000
               End-Perform                                              07630000
      *                                                                 07640000
               If  Ind-Key               Not > W-Max-Occ-Key-Tbl        07650000
                   Set   R791ERR0-In-Key-Fin-Inst (Ind-Key)             07660000
                                         To    True                     07670000
                   If  R5879010-In-Konsern-ID                           07680000
                                         Not = 0                        07690000
                       Move  Space       To    R791ERR0-In-Key-Int-Alpha07700000
                                                               (Ind-Key)07710000
                       Move  R5879010-In-Konsern-ID                     07720000
                                         To    R791ERR0-In-Key-Int-Num  07730000
                                                               (Ind-Key)07740000
                   End-If                                               07750000
                   If  R5879010-In-KonsernNr                            07760000
                                         Not = 0                        07770000
                       Move  Space       To    R791ERR0-In-Key-Ext-Alpha07780000
                                                               (Ind-Key)07790000
                       Move  R5879010-In-KonsernNr                      07800000
                                         To    R791ERR0-In-Key-Ext-Num  07810000
                                                               (Ind-Key)07820000
                   End-If                                               07830000
               End-If                                                   07840000
      *                                                                 07850000
           End-If                                                       07860000
      *                                                                 07870000
      * Package                                                         07880000
      *                                                                 07890000
           If  R5879010-Package          Not = Space                    07900000
      *                                                                 07910000
               Perform Varying Ind-Key                                  07920000
                       From  +1          By +1                          07930000
                       Until Ind-Key     >     W-Max-Occ-Key-Tbl        07940000
                       or    R791ERR0-In-Key-Type (Ind-Key)             07950000
                                         =     'PACKAGE'                07960000
                       or    R791ERR0-In-Key-Type (Ind-Key)             07970000
                                         =     Space                    07980000
               End-Perform                                              07990000
      *                                                                 08000000
               If  Ind-Key               Not > W-Max-Occ-Key-Tbl        08010000
                   Move  'PACKAGE'       To    R791ERR0-In-Key-Type     08020000
                                                               (Ind-Key)08030000
                   Move  R5879010-Package                               08040000
                                         To    R791ERR0-In-Key-Int-Alpha08050000
                                                               (Ind-Key)08060000
               End-If                                                   08070000
      *                                                                 08080000
           End-If                                                       08090000
      *                                                                 08100000
           .                                                            08110000
      *################################################################*08120000
      * Error Handling                                                  08130000
      *                                                                 08140000
       Copy S791ERR0.                                                   08150000
       Copy S791ERX0.                                                   08160000
      *                                                                 08170000
       Copy S791ERRS.                                                   08180000
      *    This statement will be part of the system exit section       08190000
      *    in the preceeding copy book.                                 08200000
           Perform A200-Free-Packageset                                 08210000
           .                                                            08220000
      *                                                                 08230000
