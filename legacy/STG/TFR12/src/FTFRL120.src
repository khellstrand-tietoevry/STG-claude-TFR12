      *################################################################*07810099
       I100-Stored-Values                Section.                       07820099
      *                                                                 07830099
           If   R115L070-Charge-text(WA-Ind) > Spaces                   07840099
                Move  R115L070-Charge-text(WA-Ind)                      07841099
                                         To    WA-charge-text           07850099
           Else                                                         07850199
                Move Spaces              To    WA-charge-text           07850299
           End-If                                                       07850399
           Move  R115L070-Charge-Amount(WA-Ind)                         07851099
                                         To    WA-Amount                07852099
           Move  R115L070-Charge-Currency(WA-Ind)                       07860099
                                         To    WA-Currency              07870099
           Move  R115L070-Charge-Percentage(WA-Ind)                     07880099
                                         To    WA-Percent-Comm          07890099
           Move  'Y'                     To    WA-Selected              07900099
      *                                                                 07910099
           If (R115L070-MethCalc-Pct-Of-CA(WA-Ind)                      07920099
           or  R115L070-MethCalc-Pct-Of-PA(WA-Ind))                     07930099
              If R115L070-Charge-Percentage(WA-Ind)  > 0                07940099
                  Set Sw-Percent-Reg      To    True                    07950099
              Else                                                      07960099
                  Move Spaces             To    Wa-Percent              07970099
      *        Beregner prosent utfra kontraktsbel�p/ratebel�p          07980099
                  Perform G500-Read-Contract-Amount                     07990099
                  If RTFRE120-I-Part-Amount-No-D > 0                    08000099
      *        Feilretting juli 01: Finner kontraktsbel�p utfra Curr-   08010099
      *        orig-amount dersom methcalc = pct-of-CA                  08020099
                  and NOT R115L070-MethCalc-Pct-Of-CA(WA-Ind)           08030099
                    Perform G600-Read-Part-Amount                       08040099
                    Move  R115IPA0-Amount To    WS-PA-or-CA-Amount      08050099
                  Else                                                  08060099
      *             Move  R115ICA0-Remaining-Amount                     08070099
                    Move  R115ICA0-Curr-O-Amount                        08080099
                                          To    WS-PA-or-CA-Amount      08090099
                  End-If                                                08100099
      *                                                                 08110099
                  If Ws-PA-or-CA-Amount > 0                             08120099
                     Compute WA-Percent-Comm                            08130099
                       =                        WA-Amount               08140099
                      *                         100                     08150099
                      /                         Ws-PA-or-CA-Amount      08160099
                     End-Compute                                        08170099
                  Else                                                  08180099
                     Move +0              To    WA-Percent-Comm         08190099
                  End-If                                                08200099
              End-If                                                    08210099
           End-If                                                       08220099
           .                                                            08230099
      *                                                                 08240099
       I100-Stored-Values-Ex.                                           08250099
           Exit.                                                        08260099
                                                                        08270099
      *################################################################*08280099
       I200-Default-Values               Section.                       08290099
      *                                                                 08300099
           Perform I250-Find-Default-Values                             08310099
      *                                                                 08320099
           Evaluate True                                                08330099
             When  R115L150-Charge-Amount <     R115L150-Minimum-Charge 08340099
               Move  R115L150-Minimum-Charge                            08350099
                                          To    WA-Amount               08360099
      *        Feilretting, beregner ny prosent hvis den eksisterer     08370099
               If R115L150-Percent-Comm  > 0                            08380099
                  Perform G500-Read-Contract-Amount                     08390099
      *                                                                 08400099
      *        M� finne kontraktsbel�p/ratebel�p                        08410099
      *        Feilretting juli 01: Finner kontraktsbel�p utfra Curr-   08420099
      *        orig-amount dersom methcalc = pct-of-CA                  08430099
                  If RTFRE120-I-Part-Amount-No-D > 0                    08440099
      *                                                                 08450099
                  and NOT R115L070-MethCalc-Pct-Of-CA(WA-Ind)           08460099
      *                                                                 08470099
                    Perform G600-Read-Part-Amount                       08480099
                    Move  R115IPA0-Amount To    WS-PA-or-CA-Amount      08490099
                  Else                                                  08500099
      *        Feilretting juli 01: Bruker Current-Orig-Amount          08510099
      *             Move  R115ICA0-Remaining-Amount                     08520099
                    Move  R115ICA0-Curr-O-Amount                        08530099
                                          To    WS-PA-or-CA-Amount      08540099
                  End-If                                                08550099
      *                                                                 08560099
                  If  Ws-PA-or-CA-Amount  > 0                           08570099
                      Compute WA-Percent-Comm                           08580099
                       =                        WA-Amount               08590099
                       *                        100                     08600099
                       /                        Ws-PA-or-CA-Amount      08610099
                      End-Compute                                       08620099
                  Else                                                  08630099
                      Move +0             To    Ws-PA-or-CA-Amount      08640099
                  End-If                                                08650099
               Else                                                     08660099
      *           Move R115L150-Percent-Comm                            08670099
                  Move +0                                               08680099
                                          To    WA-Percent-Comm         08690099
               End-If                                                   08700099
      *        Move  Zero                 To    WA-Percent-Comm         08710099
      *      Feilretting slutt                                          08720099
      *                                                                 08730099
             When R115L150-Charge-Amount  >     R115L150-Maximum-Charge 08740099
             and not (R115L150-Maximum-Charge = Zero)                   08750099
               Move  R115L150-Maximum-Charge                            08760099
                                          To    WA-Amount               08770099
      *        Feilretting, beregner ny prosent hvis den eksisterer     08780099
               If  R115L150-Percent-Comm  > 0                           08790099
                  Perform G500-Read-Contract-Amount                     08800099
      *                                                                 08810099
      *        M� finne kontraktsbel�p/ratebel�p                        08820099
                  If RTFRE120-I-Part-Amount-No-D > 0                    08830099
                  and NOT R115L070-MethCalc-Pct-Of-CA(WA-Ind)           08840099
                    Perform G600-Read-Part-Amount                       08850099
                    Move  R115IPA0-Amount To    WS-PA-or-CA-Amount      08860099
                  Else                                                  08870099
      *             Move  R115ICA0-Remaining-Amount                     08880099
                    Move  R115ICA0-Curr-O-Amount                        08890099
                                          To    WS-PA-or-CA-Amount      08900099
                  End-If                                                08910099
      *                                                                 08920099
                  If  Ws-PA-or-CA-Amount  > 0                           08930099
                      Compute WA-Percent-Comm                           08940099
                        =                       WA-Amount               08950099
                        *                       100                     08960099
                        /                       Ws-PA-or-CA-Amount      08970099
                      End-Compute                                       08980099
                  Else                                                  08990099
                      Move +0             To    Ws-PA-or-CA-Amount      09000099
                  End-If                                                09010099
               Else                                                     09020099
      *           Move R115L150-Percent-Comm                            09030099
                  Move +0                                               09040099
                                          To    WA-Percent-Comm         09050099
               End-If                                                   09060099
      *        Move  Zero                 To    WA-Percent-Comm         09070099
      *      Feilretting slutt                                          09080099
      *                                                                 09090099
             When other                                                 09100099
               Move  R115L150-Charge-Amount                             09110099
                                          To    WA-Amount               09120099
               Move  R115L150-Percent-Comm                              09130099
                                          To    WA-Percent-Comm         09140099
           End-Evaluate                                                 09150099
      *                                                                 09160099
           If Wa-Percent-Comm  > 0                                      09170099
              Set Sw-Percent-Reg          To    True                    09180099
           Else                                                         09190099
              Move Spaces                 To    Wa-Percent              09200099
           End-If                                                       09210099
      *                                                                 09220099
           If R115L150-Currency          not = Space                    09230099
              Move  R115L150-Currency    To    WA-Currency              09240099
           Else                                                         09250099
              Move R115L070-CA-Currency  To    WA-Currency              09260099
           End-If                                                       09270099
      *                                                                 09280099
           Move  ' '                     To    WA-Selected              09290099
           Move Spaces                   To    WA-charge-text           09291099
           .                                                            09300099
