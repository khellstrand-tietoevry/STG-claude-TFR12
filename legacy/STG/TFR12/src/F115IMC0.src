      *################################################################.08960000
       H100-Check-Qualification          Section.                       08970000
      *                                                                 08980000
           Evaluate True                                                08990000
             When R115IMC0-Fin-Inst-ID   Not = +0                       09000000
               Continue                                                 09010000
                                                                        09020000
             When R115IMC0-Fin-Inst-No   Not = Space                    09030000
               Move  R115IMC0-Fin-Inst-No                               09040000
                                         To    W-Fin-Inst-No            09050000
               Perform N100-Fetch-Fin-Inst-ID                           09060000
               Move  W-Fin-Inst-ID       To    R115IMC0-Fin-Inst-ID     09070000
                                                                        09080000
             When R115IMC0-In-Fin-Inst-Id                               09090000
                                         Not = +0                       09100000
               Move R115IMC0-In-Fin-Inst-ID                             09110000
                                         To    R115IMC0-Fin-Inst-ID     09120000
                                                                        09130000
             When R115IMC0-In-Fin-Inst-No                               09140000
                                         Not = Space                    09150000
               Move  R115IMC0-In-Fin-Inst-No                            09160000
                                         To    W-Fin-Inst-No            09170000
               Perform N100-Fetch-Fin-Inst-ID                           09180000
               Move  W-Fin-Inst-ID       To    R115IMC0-Fin-Inst-ID     09190000
                                                                        09200000
             When other                                                 09210000
               Initialize                      R7918030-ErrorMessage    09220000
               Move  'TF-FIN-INST-MISSING'                              09230000
                                         To    R7918030-In-MessageCode  09240000
               Perform Z000-Error-Message                               09250000
