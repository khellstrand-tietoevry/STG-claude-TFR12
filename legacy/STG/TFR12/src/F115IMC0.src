      *################################################################.09700000
       H200-Update-Row                   Section.                       09710000
      *                                                                 09720000
           Initialize                          R115IMCS-SQL-Submodules  09730000
           Set   R115IMCS-Version        To    True                     09740000
           Set   R115IMCS-In-Update      To    True                     09750000
           Move  R115IMC0-In-Table-Version                              09760000
                                         To    R115IMCS-In-Table-Version09770000
      *                                                                 09780000
           Call  'F115IMCU'              Using R115IMCS-SQL-Submodules  09790000
                                               DCLTF-Main-Contract      09800000
                                               R7919999-Error-Area      09810000
           End-Call                                                     09820000
      *                                                                 09830000
           Evaluate True                                                09840000
             When R7919999-Return-OK                                    09850000
               Continue                                                 09860000
      *                                                                 09870000
             When R7919999-Return-Error                                 09880000
               Continue                                                 09890000
      *                                                                 09900000
             When other                                                 09910000
               Move  'H201'              To    R7919999-Paragraph       09920000
               Perform Z900-Abend                                       09930000
      *                                                                 09940000
           End-Evaluate                                                 09950000
      *                                                                 09960000
           .                                                            09970000
      *################################################################.09980000
       I000-Delete                       Section.                       09990000
      *                                                                 10000000
           Perform F100-Prepare-Qualification                           10010000
           Perform I200-Delete-Row                                      10020000
      *                                                                 10030000
           Perform L300-Remove-DCL                                      10040000
      *                                                                 10050000
           .                                                            10060000
      *################################################################.10070000
       I200-Delete-Row                   Section.                       10080000
      *                                                                 10090000
           Initialize                          R115IMCS-SQL-Submodules  10100000
           Set   R115IMCS-Version        To    True                     10110000
           Set   R115IMCS-In-Delete      To    True                     10120000
           Move  R115IMC0-In-Table-Version                              10130000
                                         To    R115IMCS-In-Table-Version10140000
      *                                                                 10150000
           Call  'F115IMCU'              Using R115IMCS-SQL-Submodules  10160000
                                               DCLTF-Main-Contract      10170000
                                               R7919999-Error-Area      10180000
           End-Call                                                     10190000
      *                                                                 10200000
           Evaluate True                                                10210000
             When R7919999-Return-OK                                    10220000
               Continue                                                 10230000
      *                                                                 10240000
             When R7919999-Return-Error                                 10250000
               Continue                                                 10260000
      *                                                                 10270000
             When other                                                 10280000
               Move  'I201'              To    R7919999-Paragraph       10290000
               Perform Z900-Abend                                       10300000
      *                                                                 10310000
           End-Evaluate                                                 10320000
      *                                                                 10330000
           .                                                            10340000
      *################################################################.10350000
       J000-Get-Columns                  Section.                       10360000
      *                                                                 10370000
           Perform J100-Move-DCL-To-Output                              10380000
      *                                                                 10390000
           .                                                            10400000
      *################################################################.10410000
       J100-Move-DCL-To-Output           Section.                       10420000
      *                                                                 10430000
      * PLEASE REMEMBER:                                                10440000
      *    When you modify the code in this section, you need to do     10450000
      *    the same modifications in module F115AMC0 - E500-section.    10460000
      *                                                                 10470000
           Move  FK-OAKO-FinInst-ID      To    R115IMC0-Fin-Inst-ID     10480000
           Move  TFMC-Contr-Type         To    R115IMC0-Contract-Type   10490000
           Move  TFMC-Contr-No           To    R115IMC0-Contract-No     10500000
           Move  FK-KLID-Cust-ID         To    R115IMC0-Customer-ID     10510000
      *                                                                 10520000
           Move  FK-OAKO-FinInst-ID      To    W-Fin-Inst-ID            10530000
           Perform N200-Fetch-Fin-Inst-No                               10540000
           Move  W-Fin-Inst-No           To    R115IMC0-Fin-Inst-No     10550000
      *                                                                 10560000
           If  FK-KLID-Cust-ID           Not = +0                       10570000
               Move  FK-KLID-Cust-ID     To    W-Customer-ID            10580000
               Perform N400-Fetch-Customer-No                           10590000
               Move  W-Customer-No       To    R115IMC0-Customer-No     10600000
           End-If                                                       10610000
      *                                                                 10620000
           Move  TFMC-Availability       To    R115IMC0-Availability    10630000
           Move  TFMC-Status             To    R115IMC0-Status          10640000
           Move  TFMC-In-Progress        To    R115IMC0-In-Progress     10650000
           Move  FK-KFAV-LOPENR          To    R115IMC0-KFAV-Seq-No     10660000
      *                                                                 10670000
           Initialize                          R7919100-Konverter-Dato  10680000
           Set   R7919100-Versjon        To    True                     10690000
           Move  TFMC-Register-Date      To    R7919100-In-Dato-DB2     10700000
           Set   R7919100-In-Konv-Til-AMD9                              10710000
                                         To    True                     10720000
           Call  'F7919100'              Using R7919100-Konverter-Dato  10730000
                                               R7919999-Error-Area      10740000
           End-Call                                                     10750000
           If  Not R7919999-Return-OK                                   10760000
               Move  'J101'              To    R7919999-Paragraph       10770000
               Perform Z900-Abend                                       10780000
           End-If                                                       10790000
           Move  R7919100-Ut-Dato-AMD9   To    R115IMC0-Register-Date   10800000
      *                                                                 10810000
           Move  TFMC-User-ID            To    R115IMC0-Upd-User-ID     10820000
      *                                                                 10830000
           Move  TFMC-Last-Upd-TS        To    R115IMC0-Upd-Timestamp   10840000
      *                                                                 10850000
           Initialize                          R7919270-Konv-Timestamp  10860000
           Set   R7919270-Versjon        To    True                     10870000
           Move  TFMC-Last-Upd-TS        To    R7919270-In-Timestamp-DB210880000
           Call  'F7919270'              Using R7919270-Konv-Timestamp  10890000
                                               R7919999-Error           10900000
           End-Call                                                     10910000
           If  Not R7919999-Retur-OK                                    10920000
               Move  'J102'              To    R7919999-Paragraf        10930000
               Perform Z900-Abend                                       10940000
           End-If                                                       10950000
           Move  R7919270-Ut-Dato        To    R115IMC0-Upd-Date        10960000
           Move  R7919270-Ut-Tid-TMSH    To    R115IMC0-Upd-Time        10970000
      *                                                                 10980000
           Initialize                          R7919100-Konverter-Dato  10990000
           Set   R7919100-Versjon        To    True                     11000000
           Move  TFMC-Issued-Date        To    R7919100-In-Dato-DB2     11010000
           Set   R7919100-In-Konv-Til-AMD9                              11020000
                                         To    True                     11030000
           Call  'F7919100'              Using R7919100-Konverter-Dato  11040000
                                               R7919999-Error-Area      11050000
           End-Call                                                     11060000
           If  Not R7919999-Return-OK                                   11070000
               Move  'J103'              To    R7919999-Paragraph       11080000
               Perform Z900-Abend                                       11090000
           End-If                                                       11100000
           Move  R7919100-Ut-Dato-AMD9   To    R115IMC0-Issued-Date     11110000
      *                                                                 11120000
           Move  TFMC-Confirmed          To    R115IMC0-Confirmed       11130000
           Move  TFMC-Incom-Swift        To    R115IMC0-Incom-Swift     11140000
           Move  TFMC-Silent-Confrm      To    R115IMC0-Silent-Confrm   11150000
      *                                                                 11160000
      * Info about the cursor:                                          11170000
      *                                                                 11180000
           Move  WC-Row-No               To  R115IMC0-Out-Row-No        11190000
           Move  WC-Total-No-Of-Rows     To  R115IMC0-Out-Total-Rows    11200000
      *                                                                 11210000
           .                                                            11220000
      *################################################################.11230000
       L100-Store-DCL                    Section.                       11240000
      *                                                                 11250000
      * We might already have this row in storage.                      11260000
      *                                                                 11270000
           Perform L200-Find-DCL                                        11280000
      *                                                                 11290000
           If  Ind-WS                    >     W-Max-Occ-WS-Tab         11300000
           or  WS-DB2-Not-Read (Ind-WS)                                 11310000
             Then                                                       11320000
      *        If we have reached the end of the storage-table,         11330000
      *        we start on the beginning.                               11340000
      *        This way, we always keep the "newest" occurrences.       11350000
               Add   +1                  To    Ind-WS-Put               11360000
               If  Ind-WS-Put            >     W-Max-Occ-WS-Tab         11370000
                   Move  +1              To    Ind-WS-Put               11380000
               End-If                                                   11390000
               Move  Ind-WS-Put          To    Ind-WS                   11400000
             Else                                                       11410000
               Move  Ind-WS              To    Ind-WS-Put               11420000
           End-If                                                       11430000
      *                                                                 11440000
      * We store the identification.                                    11450000
      *                                                                 11460000
           Move  R115IMC0-In-Table-Version                              11470000
                                         To    WS-DB2-Tbl-Version       11480000
                                                            (Ind-WS-Put)11490000
           Move  FK-OAKO-FinInst-ID      To    WS-DB2-Fin-Inst-ID       11500000
                                                            (Ind-WS-Put)11510000
           Move  TFMC-Contr-Type         To    WS-DB2-Contr-Type        11520000
                                                            (Ind-WS-Put)11530000
           Move  TFMC-Contr-No           To    WS-DB2-Contr-No          11540000
                                                            (Ind-WS-Put)11550000
      *                                                                 11560000
      * The DCL is stored if found, the status is set.                  11570000
      *                                                                 11580000
           Evaluate True                                                11590000
             When Length                 Of    DCLTF-Main-Contract      11600000
                > Length                 Of    WS-DB2-DCL               11610000
               Move  Length              Of    DCLTF-Main-Contract      11620000
                                         To    WD-Length                11630000
               Initialize                      R7918030-ErrorMessage    11640000
               Move  'GL-WL-DCL-UTVIDES' To    R7918030-In-MessageCode  11650000
               Move  'VAR1'              To R7918030-In-Variable-Key (1)11660000
               Move  WD-Length           To R7918030-In-Variable-Data(1)11670000
               Perform Z000-Error-Message                               11680000
               Move  'L101'              To    R7919999-Paragraph       11690000
               Perform Z900-Abend                                       11700000
      *                                                                 11710000
             When R7919999-Return-Error                                 11720000
               Set   WS-DB2-Not-Found (Ind-WS-Put)                      11730000
                                         To    True                     11740000
      *                                                                 11750000
             When other                                                 11760000
               Move  DCLTF-Main-Contract To    WS-DB2-DCL   (Ind-WS-Put)11770000
               Set   WS-DB2-Read (Ind-WS-Put)                           11780000
                                         To    True                     11790000
      *                                                                 11800000
           End-Evaluate                                                 11810000
      *                                                                 11820000
           .                                                            11830000
      *################################################################.11840000
       L200-Find-DCL                     Section.                       11850000
      *                                                                 11860000
           Perform Varying Ind-WS                                       11870000
                   From  +1              By    +1                       11880000
                   Until Ind-WS          >     W-Max-Occ-WS-Tab         11890000
                   or  ( WS-DB2-Tbl-Version (Ind-WS)                    11900000
                                         =     R115IMC0-In-Table-Version11910000
                     and WS-DB2-Fin-Inst-ID (Ind-WS)                    11920000
                                         =     FK-OAKO-FinInst-ID       11930000
                     and WS-DB2-Contr-Type (Ind-WS)                     11940000
                                         =     TFMC-Contr-Type          11950000
                     and WS-DB2-Contr-No (Ind-WS)                       11960000
                                         =     TFMC-Contr-No )          11970000
           End-Perform                                                  11980000
      *                                                                 11990000
           .                                                            12000000
      *################################################################*12010000
       L300-Remove-DCL                   Section.                       12020000
      *                                                                 12030000
           Perform Varying Ind-WS                                       12040000
                   From  +1              By    +1                       12050000
                   Until Ind-WS          >     W-Max-Occ-WS-Tab         12060000
                   or  ( WS-DB2-Tbl-Version (Ind-WS)                    12070000
                                         =     R115IMC0-In-Table-Version12080000
                     and WS-DB2-Fin-Inst-ID (Ind-WS)                    12090000
                                         =     FK-OAKO-FinInst-ID       12100000
                     and WS-DB2-Contr-Type (Ind-WS)                     12110000
                                         =     TFMC-Contr-Type          12120000
                     and WS-DB2-Contr-No (Ind-WS)                       12130000
                                         =     TFMC-Contr-No )          12140000
           End-Perform                                                  12150000
      *                                                                 12160000
           Evaluate True                                                12170000
             When Ind-WS                 >     W-Max-Occ-WS-Tab         12180000
               Continue                                                 12190000
      *                                                                 12200000
             When other                                                 12210000
               Initialize                      WS-DB2-Row (Ind-WS)      12220000
      *                                                                 12230000
           End-Evaluate                                                 12240000
      *                                                                 12250000
           .                                                            12260000
      *################################################################*12270000
       N100-Fetch-Fin-Inst-ID            Section.                       12280000
      *                                                                 12290000
           Move  W-Fin-Inst-No (1:4)     To    W-Tmp-Konsern-Nr         12300000
      *                                                                 12310000
           If  Not R5879010-Versjon                                     12320000
           or  R5879010-In-Konsernnr     Not = W-Tmp-Konsern-Nr         12330000
      *                                                                 12340000
               Initialize                      R5879010-Konsern         12350000
               Set   R5879010-Versjon    To    True                     12360000
               Set   R5879010-In-Select  To    True                     12370000
               Move  W-Tmp-Konsern-Nr    To    R5879010-In-Konsernnr    12380000
               Call  'F5879010'          Using R5879010-Konsern         12390000
                                               R7919999-Error-Area      12400000
               End-Call                                                 12410000
               If  Not R7919999-Return-OK                               12420000
                   Move  'N101'          To    R7919999-Paragraph       12430000
                   Perform Z900-Abend                                   12440000
               End-If                                                   12450000
      *                                                                 12460000
           End-If                                                       12470000
      *                                                                 12480000
           Move  R5879010-Ut-KO-Konsern-Id                              12490000
                                         To    W-Fin-Inst-ID            12500000
      *                                                                 12510000
           .                                                            12520000
      *################################################################*12530000
       N200-Fetch-Fin-Inst-No            Section.                       12540000
      *                                                                 12550000
           If  Not R5879010-Versjon                                     12560000
           or  R5879010-In-Konsern-ID    Not = W-Fin-Inst-ID            12570000
      *                                                                 12580000
               Initialize                      R5879010-Konsern         12590000
               Set   R5879010-Versjon    To    True                     12600000
               Set   R5879010-In-Select  To    True                     12610000
               Move  W-Fin-Inst-ID       To    R5879010-In-Konsern-ID   12620000
               Call  'F5879010'          Using R5879010-Konsern         12630000
                                               R7919999-Error-Area      12640000
               End-Call                                                 12650000
               If  Not R7919999-Return-OK                               12660000
                   Move  'N201'          To    R7919999-Paragraph       12670000
                   Perform Z900-Abend                                   12680000
               End-If                                                   12690000
      *                                                                 12700000
           End-If                                                       12710000
      *                                                                 12720000
           Move  R5879010-Ut-KO-Konsernnummer                           12730000
                                         To    W-Tmp-Konsern-Nr         12740000
           Move  W-Tmp-Konsern-Nr        To    W-Fin-Inst-No            12750000
      *                                                                 12760000
           .                                                            12770000
      *################################################################*12780000
       N300-Fetch-Customer-ID            Section.                       12790000
      *                                                                 12800000
           If  W-Fin-Inst-No             =     Space                    12810000
           and W-Fin-Inst-ID             Not = +0                       12820000
               Perform N200-Fetch-Fin-Inst-No                           12830000
           End-If                                                       12840000
      *                                                                 12850000
           Move  W-Fin-Inst-No (1:4)     To    W-Tmp-Konsern-Nr         12860000
      *                                                                 12870000
           If  Not R1781910-Versjon                                     12880000
           or  R1781910-In-Konsern-Nr    Not = W-Tmp-Konsern-Nr         12890000
           or  R1781910-In-Kunde-Nr      Not = W-Customer-No            12900000
      *                                                                 12910000
               Initialize                      R1781910-Kunde-ID        12920000
               Set   R1781910-Versjon    To    True                     12930000
               Set   R1781910-In-Select  To    True                     12940000
               Move  W-Tmp-Konsern-Nr    To    R1781910-In-Konsern-Nr   12950000
               Move  W-Customer-No       To    R1781910-In-Kunde-Nr     12960000
               Call  'F1781910'          Using R1781910-Kunde-ID        12970000
                                               R7919999-Error-Area      12980000
               End-Call                                                 12990000
      *                                                                 13000000
               If  Not R7919999-Return-OK                               13010000
                   Move  'N301'          To    R7919999-Paragraph       13020000
                   Perform Z900-Abend                                   13030000
               End-If                                                   13040000
      *                                                                 13050000
           End-If                                                       13060000
      *                                                                 13070000
           Move  R1781910-Ut-Kunde-ID    To    W-Customer-ID            13080000
      *                                                                 13090000
           .                                                            13100000
      *################################################################*13110000
       N400-Fetch-Customer-No            Section.                       13120000
      *                                                                 13130000
           If  Not R1781910-Versjon                                     13140000
           or  R1781910-In-Kunde-ID      Not = W-Customer-ID            13150000
      *                                                                 13160000
               Initialize                      R1781910-Kunde-ID        13170000
               Set   R1781910-Versjon    To    True                     13180000
               Set   R1781910-In-Select  To    True                     13190000
               Move  W-Customer-ID       To    R1781910-In-Kunde-ID     13200000
               Call  'F1781910'          Using R1781910-Kunde-ID        13210000
                                               R7919999-Error-Area      13220000
               End-Call                                                 13230000
      *                                                                 13240000
               If  Not R7919999-Return-OK                               13250000
                   Move  'N401'          To    R7919999-Paragraph       13260000
                   Perform Z900-Abend                                   13270000
               End-If                                                   13280000
      *                                                                 13290000
           End-If                                                       13300000
      *                                                                 13310000
           Move  R1781910-Ut-Kunde-Nr    To    W-Customer-No            13320000
      *                                                                 13330000
           .                                                            13340000
      *################################################################*13350000
       ZI00-Conv-Input-Version           Section.                       13360000
      *                                                                 13370000
      * Version control.                                                13380000
      * If conversion is needed, we call the conversion module.         13390000
      *                                                                 13400000
           Set   R115IMC0-Version        To    True                     13410000
           Move  Length                  Of    R115IMC0-Main-Contract   13420000
                                         To    W-IO-Length              13430000
      *                                                                 13440000
           Evaluate True                                                13450000
             When L-Ext-IO-Area (1:8)    =     R115IMC0-Version-No      13460000
             and  Length                 Of    L-Ext-IO-Area            13470000
                                         Not < W-IO-Length              13480000
               Move  L-Ext-IO-Area (1:W-IO-Length)                      13490000
                                         To    W-Int-IO-Area            13500000
      *                                                                 13510000
             When Other                                                 13520000
               Call  'F115I999'                                         13530000
                   Using By Content      'F115IMC0 '                    13540000
                                         'INPUT '                       13550000
                         By Reference    L-Ext-IO-Area                  13560000
                                         W-Int-IO-Area                  13570000
                                         R7919999-Error-Area            13580000
               End-Call                                                 13590000
      *                                                                 13600000
               If  R7919999-Return-Abend                                13610000
                   Move  'ZI03'          To    R7919999-Paragraph       13620000
                   Perform Z900-Abend                                   13630000
               End-If                                                   13640000
      *                                                                 13650000
           End-Evaluate                                                 13660000
      *                                                                 13670000
           .                                                            13680000
      *################################################################*13690000
       ZO00-Conv-Output-Version          Section.                       13700000
      *                                                                 13710000
      * Version control.                                                13720000
      * If conversion is needed, we call the conversion module.         13730000
      *                                                                 13740000
           Evaluate True                                                13750000
             When L-Ext-IO-Area (1:8)    =     R115IMC0-Version-No      13760000
             and  Length                 Of    L-Ext-IO-Area            13770000
                                         Not < W-IO-Length              13780000
               Move  W-Int-IO-Area       To    L-Ext-IO-Area            13790000
                                                         (1:W-IO-Length)13800000
      *                                                                 13810000
             When Other                                                 13820000
               Call  'F115I999'                                         13830000
                   Using By Content      'F115IMC0 '                    13840000
                                         'OUTPUT '                      13850000
                         By Reference    L-Ext-IO-Area                  13860000
                                         W-Int-IO-Area                  13870000
                                         R7919999-Error-Area            13880000
               End-Call                                                 13890000
      *                                                                 13900000
               If  R7919999-Return-Abend                                13910000
                   Move  'ZO01'          To    R7919999-Paragraph       13920000
                   Perform Z900-Abend                                   13930000
               End-If                                                   13940000
      *                                                                 13950000
           End-Evaluate                                                 13960000
      *                                                                 13970000
           .                                                            13980000
      *################################################################*13990000
       Z000-Error-Message                Section.                       14000000
      *                                                                 14010000
           Set   R7918030-Version        To    True                     14020000
      *                                                                 14030000
           Move  'TF'                    To    R7918030-In-System-ID    14040000
           Move  R115X000-Fin-Inst-No    To    R7918030-In-Fin-Inst-No  14050000
           Move  R115X000-FI-Language-639-1                             14060000
                                         To    R7918030-In-Language     14070000
           If  R115X000-Trace-On                                        14080000
               Set   R7918030-In-Log-Yes To    True                     14090000
           End-If                                                       14100000
      *                                                                 14110000
           Call  'F7918030'              Using R7918030-ErrorMessage    14120000
           End-Call                                                     14130000
      *                                                                 14140000
           Move  R7918030-Out-MessageText                               14150000
                                         To    R7919999-Message         14160000
      *                                                                 14170000
           .                                                            14180000
      *################################################################*14190000
       Z900-Abend                        Section.                       14200000
      *                                                                 14210000
           If  R7919999-Return-Code      Not   Numeric                  14220000
           or  Not R7919999-Return-Abend                                14230000
               Move  +0                  To    R7919999-Module-Ind      14240000
           End-If                                                       14250000
      *                                                                 14260000
           Add   +1                      To    R7919999-Module-Ind      14270000
      *                                                                 14280000
           If  R7919999-Module-Ind       Not >                          14290000
                             ( Length    Of    R7919999-Module-Tab      14300000
                             / Length    Of    R7919999-Module-Element )14310000
               Move  'F115IMC0'          To    R7919999-Module-Name     14320000
                                                   (R7919999-Module-Ind)14330000
               Move  R7919999-Paragraph  To    R7919999-Module-Para     14340000
                                                   (R7919999-Module-Ind)14350000
           End-If                                                       14360000
      *                                                                 14370000
           Set   R7919999-Return-Abend   To    TRUE                     14380000
      *                                                                 14390000
           Goback.                                                      14400000
