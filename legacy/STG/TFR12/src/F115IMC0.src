           and R115IMC0-Customer-ID      =     +0                       07750000
               Move  R115IMC0-Fin-Inst-No                               07760000
                                         To    W-Fin-Inst-No            07770000
               Move  R115IMC0-Fin-Inst-ID                               07780000
                                         To    W-Fin-Inst-ID            07790000
               Move  R115IMC0-Customer-No                               07800000
                                         To    W-Customer-No            07810000
               Perform N300-Fetch-Customer-ID                           07820000
               Move  W-Customer-ID       To    FK-KLID-Cust-ID          07830000
           End-If                                                       07840000
      *                                                                 07850000
           Move R115IMC0-Contract-Type   To    TFMC-Contr-Type          07860000
           Move R115IMC0-Contract-No     To    TFMC-Contr-No            07870000
      *                                                                 07880000
           Move R115IMC0-Availability    To    TFMC-Availability        07890000
           Move R115IMC0-Status          To    TFMC-Status              07900000
           Move R115IMC0-In-Progress     To    TFMC-In-Progress         07910000
           Move R115IMC0-KFAV-Seq-No     To    FK-KFAV-LOPENR           07920000
      *                                                                 07930000
