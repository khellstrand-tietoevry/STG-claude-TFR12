               Set   R7919270-Versjon    To    True                     08130000
               Move  R115IMC0-Upd-Date   To    R7919270-In-Dato         08140000
               Move  R115IMC0-Upd-Time   To    R7919270-In-Tid-TMSH     08150000
               Call  'F7919270'          Using R7919270-Konv-Timestamp  08160000
                                               R7919999-Error           08170000
               End-Call                                                 08180000
               If  Not R7919999-Retur-OK                                08190000
                   Move  'G102'          To    R7919999-Paragraf        08200000
                   Perform Z900-Abend                                   08210000
               End-If                                                   08220000
               Move  R7919270-Ut-Timestamp-DB2                          08230000
                                         To    TFMC-Last-Upd-TS         08240000
      *                                                                 08250000
             Else                                                       08260000
               Move  R115IMC0-Upd-Timestamp                             08270000
                                         To    TFMC-Last-Upd-TS         08280000
           End-If                                                       08290000
      *                                                                 08300000
           Initialize                          R7919100-Konverter-Dato  08310000
           Set   R7919100-Versjon        To    True                     08320000
           If  R115IMC0-Issued-Date      >     +0                       08330000
             Then                                                       08340000
               Move  R115IMC0-Issued-Date                               08350000
                                         To    R7919100-In-Dato-AMD9    08360000
             Else                                                       08370000
               Move  +00010101           To    R7919100-In-Dato-AMD9    08380000
           End-If                                                       08390000
           Set   R7919100-In-Konv-Til-DB2                               08400000
                                         To    True                     08410000
           Call  'F7919100'              Using R7919100-Konverter-Dato  08420000
                                               R7919999-Error-Area      08430000
           End-Call                                                     08440000
           If  Not R7919999-Return-OK                                   08450000
               Move  'G103'              To    R7919999-Paragraph       08460000
               Perform Z900-Abend                                       08470000
           End-If                                                       08480000
           Move  R7919100-Ut-Dato-DB2    To    TFMC-Issued-Date         08490000
