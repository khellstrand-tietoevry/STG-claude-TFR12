             88  SW-Use-Fi-Cu-CT-CN-Asc             Value 'FCTN '.      01300000
             88  SW-Use-Fi-ST-Asc                   Value 'F   S'.      01310000
             88  SW-Use-None                        Value '     '.      01320000
