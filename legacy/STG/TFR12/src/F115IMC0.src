           Copy R115IMC0.                                               02070000
      *                                                                 02080000
      *----------------------------------------------------------------*02090000
      * Assorted copy-areas:                                            02100000
      *                                                                 02110000
       01  Filler.                                                      02120000
           Copy R115IMCS.                                               02130000
      *                                                                 02140000
       01  Filler.                                                      02150000
           Copy R1781910.                                               02160000
      *                                                                 02170000
       01  Filler.                                                      02180000
           Copy R5879010.                                               02190000
      *                                                                 02200000
       01  Filler.                                                      02210000
           Copy R7918030.                                               02220000
      *                                                                 02230000
       Copy R7919100.                                                   02240000
       Copy R7919270.                                                   02250000
      *                                                                 02260000
       Copy R115X000.                                                   02270000
      *                                                                 02280000
      *################################################################.02290000
       Linkage Section.                                                 02300000
      *                                                                 02310000
       01  L-Ext-IO-Area                 Pic  X(560).                   02320000
       Copy R7919999.                                                   02330000
      *                                                                 02340000
      *################################################################.02350000
       Procedure Division                Using L-Ext-IO-Area            02360000
                                               R7919999-Error-Area.     02370000
      *                                                                 02380000
       A000-Main                         Section.                       02390000
      *                                                                 02400000
           Perform B000-Initialize                                      02410000
      *                                                                 02420000
           Evaluate True                                                02430000
             When SW-IA-Initialize                                      02440000
               Continue                                                 02450000
      *                                                                 02460000
             When Other                                                 02470000
               Perform ZI00-Conv-Input-Version                          02480000
               Perform C000-Interface                                   02490000
               Perform ZO00-Conv-Output-Version                         02500000
      *                                                                 02510000
           End-Evaluate                                                 02520000
      *                                                                 02530000
           Goback.                                                      02540000
      *################################################################*02550000
       B000-Initialize                   Section.                       02560000
      *                                                                 02570000
           Set   R7919999-Return-OK      To    True                     02580000
      *                                                                 02590000
           Evaluate True                                                02600000
             When L-Ext-IO-Area (1:10)   =     'INITIALIZE'             02610000
               Set   Sw-IA-Initialize    To    True                     02620000
             When Other                                                 02630000
               Move  Space               To    W-Input-Action           02640000
           End-Evaluate                                                 02650000
      *                                                                 02660000
           Compute  W-Max-Occ-WS-Tab                                    02670000
               =    Length               Of    WS-DB2-Table             02680000
               /    Length               Of    WS-DB2-Row               02690000
      *                                                                 02700000
           If  Sw-IA-Initialize                                         02710000
           or  WS-DB2-Row-Status (1)     Not   Numeric                  02720000
               Initialize                      W-Storage                02730000
               Move  +0                  To    Ind-WS-Put               02740000
           End-If                                                       02750000
      *                                                                 02760000
           If  WC-Row-No                 Not   Numeric                  02770000
           or  WC-Total-No-Of-Rows       Not   Numeric                  02780000
               Initialize                      WC-Counters              02790000
           End-If                                                       02800000
      *                                                                 02810000
           Evaluate True                                                02820000
             When Not R115X000-Is-Initiated                             02830000
               Initialize                      R115X000-External-Data   02840000
             When Not R115X000-Version                                  02850000
               Initialize                      R7918030-ErrorMessage    02860000
               Move  'GL-VERSION-INVALID'                               02870000
                                         To    R7918030-In-MessageCode  02880000
               Move  'VAR1'              To R7918030-In-Variable-Key (1)02890000
               Move  R115X000-Version-No To R7918030-In-Variable-Data(1)02900000
               Move  'VAR2'              To R7918030-In-Variable-Key (2)02910000
               Move  'R115X000'          To R7918030-In-Variable-Data(2)02920000
               Perform Z000-Error-Message                               02930000
               Move  'B001'              To    R7919999-Paragraph       02940000
               Perform Z900-Abend                                       02950000
           End-Evaluate                                                 02960000
      *                                                                 02970000
           .                                                            02980000
      *################################################################.02990000
       C000-Interface                    Section.                       03000000
      *                                                                 03010000
           Perform C100-Verify                                          03020000
      *                                                                 03030000
           Evaluate True                                                03040000
             When R115IMC0-In-Get-1st                                   03050000
               Perform C200-Initialize-Output                           03060000
               Perform D000-Get-1st                                     03070000
               Perform E000-Get-Next                                    03080000
      *                                                                 03090000
             When R115IMC0-In-Get-Next                                  03100000
               Perform C200-Initialize-Output                           03110000
               Perform E000-Get-Next                                    03120000
      *                                                                 03130000
             When R115IMC0-In-Select                                    03140000
               Perform C200-Initialize-Output                           03150000
               Perform F000-Select                                      03160000
      *                                                                 03170000
             When R115IMC0-In-Insert                                    03180000
               Perform G000-Insert                                      03190000
      *                                                                 03200000
             When R115IMC0-In-Update                                    03210000
               Perform H000-Update                                      03220000
      *                                                                 03230000
             When R115IMC0-In-Delete                                    03240000
               Perform I000-Delete                                      03250000
      *                                                                 03260000
             When Other                                                 03270000
               Initialize                      R7918030-ErrorMessage    03280000
               Move  'GL-IN-AKSJON-UV'   To    R7918030-In-MessageCode  03290000
               Move  'VAR1'              To R7918030-In-Variable-Key (1)03300000
               Move  R115IMC0-In-Action  To R7918030-In-Variable-Data(1)03310000
               Perform Z000-Error-Message                               03320000
               Move  'C001'              To    R7919999-Paragraph       03330000
               Perform Z900-Abend                                       03340000
      *                                                                 03350000
           End-Evaluate                                                 03360000
      *                                                                 03370000
           .                                                            03380000
      *################################################################.03390000
       C100-Verify                       Section.                       03400000
      *                                                                 03410000
           Evaluate True                                                03420000
             When R115IMC0-In-Actual                                    03430000
               Set   SW-Table-Actual     To    True                     03440000
      *                                                                 03450000
             When R115IMC0-In-Work                                      03460000
               Set   SW-Table-Work       To    True                     03470000
      *                                                                 03480000
             When other                                                 03490000
               Initialize                      R7918030-ErrorMessage    03500000
               Move  'GL-IN-TABLE-VERSION-UV'                           03510000
                                         To    R7918030-In-MessageCode  03520000
               Move  'VAR1'              To R7918030-In-Variable-Key (1)03530000
               Move  R115IMC0-In-Table-Version                          03540000
                                         To R7918030-In-Variable-Data(1)03550000
               Perform Z000-Error-Message                               03560000
               Move  'C101'              To    R7919999-Paragraph       03570000
               Perform Z900-Abend                                       03580000
      *                                                                 03590000
           End-Evaluate                                                 03600000
      *                                                                 03610000
           .                                                            03620000
      *################################################################.03630000
       C200-Initialize-Output            Section.                       03640000
      *                                                                 03650000
           Initialize                          R115IMC0-Data            03660000
      *                                                                 03670000
           .                                                            03680000
      *################################################################.03690000
       D000-Get-1st                      Section.                       03700000
      *                                                                 03710000
           Perform D100-Prepare-Input                                   03720000
           Perform D200-Prepare-Qualification                           03730000
           Perform D300-Select-Cursor                                   03740000
           If  R115IMC0-In-CC-Count                                     03750000
               Perform D400-Count-Cursor                                03760000
           End-If                                                       03770000
           Perform D500-Open-Cursor                                     03780000
      *                                                                 03790000
           .                                                            03800000
      *################################################################.03810000
       D100-Prepare-Input                Section.                       03820000
      *                                                                 03830000
      * We create internal from- and to-values, depending on the input. 03840000
      *                                                                 03850000
           Initialize                          WE-Cursor-Info           03860000
      *                                                                 03870000
           Move  R115IMC0-In-Fin-Inst-ID To    WE-Fin-Inst-ID           03880000
           Move  R115IMC0-In-Fin-Inst-No To    WE-Fin-Inst-No           03890000
      *                                                                 03900000
           Move  R115IMC0-In-Customer-ID To    WE-Customer-ID           03910000
           Move  R115IMC0-In-Customer-No To    WE-Customer-No           03920000
      *                                                                 03930000
           Move  R115IMC0-In-Contract-Type                              03940000
                                         To    WE-Contr-Type            03950000
           Move  R115IMC0-In-Contract-No To    WE-Contract-No           03960000
      *                                                                 03970000
           Move  R115IMC0-In-Status      To    WE-Status                03980000
           Move  +0                      To    W-Tally                  03990000
           Inspect WE-Status            Tallying W-Tally for all '*' '%'04000000
           If  W-Tally                   >     +0                       04010000
               Inspect WE-Status         Converting '* ' to '%%'        04020000
           End-If                                                       04030000
      *                                                                 04040000
           .                                                            04050000
      *################################################################.04060000
       D200-Prepare-Qualification        Section.                       04070000
      *                                                                 04080000
      * We store the qualification, so that we can check that the       04090000
      * qualification do not change on any following Get-Next.          04100000
      *                                                                 04110000
           Initialize                          WS-Cursor-Info           04120000
           Move  WE-Key                  To    WS-Key                   04130000
           Move  WE-Code-Sequence        To    WS-Code-Sequence         04140000
      *                                                                 04150000
           Initialize WC-Counters                                       04160000
      *                                                                 04170000
      * We fill in the SQL host variables.                              04180000
      *                                                                 04190000
           Initialize                          W-DB-Key                 04200000
      *                                                                 04210000
           Move  WE-Fin-Inst-ID          To    W-DB-Fin-Inst-ID         04220000
           Move  WE-Customer-ID          To    W-DB-Customer-ID         04230000
           Move  WE-Contr-Type           To    W-DB-Contract-Type       04240000
      *                                                                 04250000
           Move  WE-Contract-No          To    W-DB-Contract-No         04260000
      *                                                                 04270000
           If  WE-Fin-Inst-No            Not = Space                    04280000
           and W-DB-Fin-Inst-ID          =     +0                       04290000
               Move  WE-Fin-Inst-No      To    W-Fin-Inst-No            04300000
               Perform N100-Fetch-Fin-Inst-ID                           04310000
               Move  W-Fin-Inst-ID       To    W-DB-Fin-Inst-ID         04320000
           End-If                                                       04330000
      *                                                                 04340000
           If  WE-Customer-No            Not = +0                       04350000
           and W-DB-Customer-ID          =     +0                       04360000
               Move  WE-Fin-Inst-No      To    W-Fin-Inst-No            04370000
               Move  WE-Fin-Inst-ID      To    W-Fin-Inst-ID            04380000
               Move  WE-Customer-No      To    W-Customer-No            04390000
               Perform N300-Fetch-Customer-ID                           04400000
               Move  W-Customer-ID       To    W-DB-Customer-ID         04410000
           End-If                                                       04420000
      *                                                                 04430000
           Move  WE-Status               To    W-DB-Status              04440000
      *                                                                 04450000
           .                                                            04460000
      *################################################################.04470000
       D300-Select-Cursor                Section.                       04480000
      *                                                                 04490000
      * We choose which cursor to use, depending on the qualification.  04500000
      *                                                                 04510000
           Move  Space                   To    SW-Cursor-Code           04520000
      *                                                                 04530000
           If  W-DB-Fin-Inst-ID          Not = +0                       04540000
               Set  Sw-Use-Fin-Inst      To    True                     04550000
           End-If                                                       04560000
      *                                                                 04570000
           If  W-DB-Customer-ID          Not = +0                       04580000
               Set  Sw-Use-Customer      To    True                     04590000
           End-If                                                       04600000
      *                                                                 04610000
           If  W-DB-Contract-Type        Not = Space                    04620000
               Set   SW-Use-Contract-Type                               04630000
                                         To    True                     04640000
           End-If                                                       04650000
      *                                                                 04660000
           If  W-DB-Contract-No          Not = +0                       04670000
               Set   SW-Use-Contract-No  To    True                     04680000
           End-If                                                       04690000
      *                                                                 04700000
           If  W-DB-Status               Not = Space                    04710000
           and W-DB-Status (1:1)         Not = '%'                      04720000
               Set   SW-Use-Status       To    True                     04730000
           End-If                                                       04740000
      *                                                                 04750000
           Evaluate True                                                04760000
             When SW-Use-Fi-Asc                                         04770000
             or   SW-Use-Fi-Cu-Asc                                      04780000
             or   SW-Use-Fi-CT-Asc                                      04790000
             or   SW-Use-Fi-CN-Asc                                      04800000
             or   SW-Use-Fi-Cu-CT-Asc                                   04810000
             or   SW-Use-Fi-CT-CN-Asc                                   04820000
             or   SW-Use-Fi-CT-ST-Asc                                   04830000
             or   SW-Use-Fi-Cu-CT-CN-Asc                                04840000
             or   SW-Use-Fi-St-Asc                                      04850000
             or   SW-Use-None                                           04860000
               Continue                                                 04870000
      *                                                                 04880000
             When other                                                 04890000
               Initialize                      R7918030-ErrorMessage    04900000
               Move  'GL-CURSOR-UV'      To    R7918030-In-MessageCode  04910000
               Move  'VAR1'              To R7918030-In-Variable-Key (1)04920000
               Move  SW-Cursor-Code      To R7918030-In-Variable-Data(1)04930000
               Perform Z000-Error-Message                               04940000
               Move  'D302'              To    R7919999-Paragraph       04950000
               Perform Z900-Abend                                       04960000
      *                                                                 04970000
           End-Evaluate                                                 04980000
      *                                                                 04990000
           .                                                            05000000
      *################################################################.05010000
       D400-Count-Cursor                 Section.                       05020000
      *                                                                 05030000
           Initialize                          R115IMCS-SQL-Submodules  05040000
           Set   R115IMCS-Version        To    True                     05050000
           Set   R115IMCS-In-Count-Cursor                               05060000
                                         To    True                     05070000
           Move  R115IMC0-In-Table-Version                              05080000
                                         To    R115IMCS-In-Table-Version05090000
           Move  Sw-Cursor-Code          To    R115IMCS-Cursor-Code     05100000
           Move  W-DB-Key                To    R115IMCS-DB-Key          05110000
      *                                                                 05120000
           Call  'F115IMCR'              Using R115IMCS-SQL-Submodules  05130000
                                               DCLTF-Main-Contract      05140000
                                               R7919999-Error-Area      05150000
           End-Call                                                     05160000
      *                                                                 05170000
           Evaluate True                                                05180000
             When R7919999-Return-OK                                    05190000
               Move  R115IMCS-Out-Total-Rows                            05200000
                                         To    WC-Total-No-Of-Rows      05210000
      *                                                                 05220000
             When other                                                 05230000
               Move  'D401'              To    R7919999-Paragraph       05240000
               Perform Z900-Abend                                       05250000
      *                                                                 05260000
           End-Evaluate                                                 05270000
      *                                                                 05280000
           .                                                            05290000
      *################################################################.05300000
       D500-Open-Cursor                  Section.                       05310000
      *                                                                 05320000
           Initialize                          R115IMCS-SQL-Submodules  05330000
           Set   R115IMCS-Version        To    True                     05340000
           Set   R115IMCS-In-Open-Cursor To    True                     05350000
           Move  R115IMC0-In-Table-Version                              05360000
                                         To    R115IMCS-In-Table-Version05370000
           Move  Sw-Cursor-Code          To    R115IMCS-Cursor-Code     05380000
           Move  W-DB-Key                To    R115IMCS-DB-Key          05390000
      *                                                                 05400000
           Call  'F115IMCR'              Using R115IMCS-SQL-Submodules  05410000
                                               DCLTF-Main-Contract      05420000
                                               R7919999-Error-Area      05430000
           End-Call                                                     05440000
      *                                                                 05450000
           Evaluate True                                                05460000
             When R7919999-Return-OK                                    05470000
               Set   WS-Cursor-OK        To    True                     05480000
      *                                                                 05490000
             When other                                                 05500000
               Move  'D501'              To    R7919999-Paragraph       05510000
               Perform Z900-Abend                                       05520000
      *                                                                 05530000
           End-Evaluate                                                 05540000
