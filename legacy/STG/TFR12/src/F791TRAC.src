           Move  01                      To    R791MQSH-Melding-Ver     03200000
           Move  W-Timestamp             To    R791MQSH-Sendt-Timestamp 03210000
           Move  'FDPO-TRACE'            To    R791MQSH-Mottaker-Appl   03220000
           Move  'FDPO-TRACE'            To    R791MQSH-Avsender-Appl   03230000
           Move  Zeroes                  To    R791MQSH-Bank            03240000
           Move  R7919220-Ut-Jobb-Navn   To    R791MQSH-Arbeidsstasjon  03250000
           Move  R7919220-Ut-Load-Navn   To    R791MQSH-Brukerid        03260000
           Initialize                          R7919330-Token           03270000
           Set   R7919330-Versjon        To    True                     03280000
           Move  R791MQSH-Brukerid       To    R7919330-In-Brukerid     03290000
           Move  R791MQSH-Arbeidsstasjon To    R7919330-In-Terminal     03300000
                                                                        03310000
           If  Not R7919330-Versjon                                     03320000
               Initialize                      R7919330-Token           03330000
               Set   R7919330-Versjon    To    True                     03340000
               Move  R791MQSH-Brukerid   To    R7919330-In-Brukerid     03350000
               Move  R791MQSH-Arbeidsstasjon                            03360000
                                         To    R7919330-In-Terminal     03370000
               Call  'F7919330'          Using R7919330-Token           03380000
                                               R7919999-Error           03390000
               End-Call                                                 03400000
               If  Not R7919999-Retur-OK                                03410000
                   Move  'E201'              To    R7919999-Paragraf    03420000
                   Perform Z900-Abend                                   03430000
               End-If                                                   03440000
           End-If                                                       03450000
           Move  R7919330-Ut-Token       To    R791MQSH-Verifikasjon    03460000
      *                                                                 03470000
      *    Initialiser MQ omr�det                                       03480000
      *                                                                 03490000
           Initialize                    R791MQS0-Interface             03500000
           Set  R791MQS0-Versjon         To    True                     03510000
      *                                                                 03520000
      *    Sett k� det skal skrives til                                 03530000
      *                                                                 03540000
           If R791TRAC-In-Trace-Queue    In    R791TRAC-Interface       03541012
                                         =     SPaces                   03542012
              Move  'FDPO.TRACELOG'      To    R791MQS0-In-QueueName    03550012
           Else                                                         03551012
              Move R791TRAC-In-Trace-Queue                              03551112
                                         In    R791TRAC-Interface       03551212
                                         To    R791MQS0-In-QueueName    03551312
           End-If                                                       03552012
      *                                                                 03560000
      *    Vi �pner k�en som output                                     03570000
      *                                                                 03580000
           Set   R791MQS0-In-O-F-Output  To    True                     03590000
      *                                                                 03600008
      *    Vi logger utenfor syncpoint                                  03610008
      *                                                                 03620008
           Set   R791MQS0-In-No-Syncpoint                               03630008
                                         To    True                     03640008
      *                                                                 03650000
      *    Setter correlation ID                                        03660004
      *                                                                 03670000
           Move  W-Timestamp             To    R791MQS0-In-Correlid     03680004
           Move  R791DBGH-JobbNavn       To    R791MQS0-In-Correlid     03690007
                                               (17 : 8)                 03700007
      *                                                                 03710004
      *    Set lengden p� meldingen                                     03720004
      *                                                                 03730004
           Move  W-I-Len                 To    R791MQS0-In-Put-LL       03740004
      *                                                                 03750000
      *    Utf�r PUT1 kallet                                            03760000
      *                                                                 03770000
           Perform M100-MQ-Put1                                         03780000
           .                                                            03790000
      *                                                                 03800000
       E000-Trace-Logg-Ex.                                              03810000
           Exit.                                                        03820000
                                                                        03830000
      *################################################################*03840000
      *                                                                *03850000
      * Styring av PUT1 kallet til MQSeries                            *03860000
      *                                                                *03870000
      *----------------------------------------------------------------*03880000
       M100-MQ-Put1                      Section.                       03890000
      *                                                                 03900000
           Set  R791MQS0-In-Put1         To    True                     03910000
           Call  'F791MQS0'                                             03920000
                 Using By Reference      R791MQS0-Interface             03930000
                       By Reference      R791MQSH-Interface             03940000
                       By Reference      W-Trace-Area(1:32768)          03950000
                       By Reference      R7919999-Error                 03960000
           End-Call                                                     03970000
      *                                                                 03980000
      *    Sjekker status etter put1 kallet                             03990000
      *                                                                 04000000
           If  Not R7919999-Retur-Ok                                    04010000
               Move  'M101'              To    R7919999-Paragraf        04020000
               Perform Z900-Abend                                       04030000
           End-If                                                       04040000
           .                                                            04050000
      *                                                                 04060000
       M100-MQ-Put1-Ex.                                                 04070000
           Exit.                                                        04080000
