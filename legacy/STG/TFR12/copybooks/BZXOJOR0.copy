      *                                                                         
      *  Description and qualifications for the different cursors.              
      *  It is required to populate all %-In-% items.                           
      *                                                                         
      *  Cursor1                                                                
      *    WHERE   OROR_EXT_ORG_REF                                             
      *    =       BZXOJOR0-In-OROR-EXT-ORG-REF                                 
      *    Order  By                                                            
      *            OROR_EXT_ORG_REF  ASC                                        
      *                                                                         
      *  Cursor2                                                                
      *    WHERE   OROR_LEGAL_ORG_NO                                            
      *    =       BZXOJOR0-In-OROR-LEGAL-ORG-NO                                
      *    AND     OROR_ISO_3166_NUM                                            
      *    =       BZXOJOR0-In-OROR-ISO-3166-NUM                                
      *    Order  By                                                            
      *            OROR_LEGAL_ORG_NO  ASC                                       
      *                                                                         
      *  Cursor3                                                                
      *    WHERE   OROR_LEGAL_ORG_NO                                            
      *    =       BZXOJOR0-In-OROR-LEGAL-ORG-NO                                
      *    AND     OROR_ISO_3166_A2                                             
      *    =       BZXOJOR0-In-OROR-ISO-3166-A2                                 
      *    Order  By                                                            
      *            OROR_LEGAL_ORG_NO  ASC                                       
      *                                                                         
      *  Cursor4                                                                
      *    WHERE   FK_TY_INT_CODE                                               
      *    =       BZXOJOR0-In-FK-TY-INT-CODE                                   
      *    Order  By                                                            
      *            FK_TY_INT_CODE  ASC                                          
      *          , OROR_EXT_ORG_REF  ASC                                        
      *                                                                         
      *  Cursor5                                                                
      *    WHERE   OROR_ORG_ID                                                  
      *    >=      BZXOJOR0-In-From-Org-Id                                      
      *    AND     OROR_ORG_ID                                                  
      *    <=      BZXOJOR0-In-To-Org-Id                                        
      *    Order  By                                                            
      *            OROR_EXT_ORG_REF  ASC                                        
      *                                                                         
      *  Cursor6                                                                
      *    WHERE   FK_TY_INT_CODE                                               
      *    =       BZXOJOR0-In-FK-TY-INT-CODE                                   
      *    AND     UPPER(OROR_ORG_NAME)                                         
      *    LIKE    BZXOJOR0-In-OROR-ORG-NAME                                    
      *    Order  By                                                            
      *            OROR_ORG_NAME  ASC                                           
      *                                                                         
      *  Cursor7                                                                
      *    WHERE   UPPER(OROR_ORG_NAME)                                         
      *    LIKE    BZXOJOR0-In-OROR-ORG-NAME                                    
      *    Order  By                                                            
      *            OROR_ORG_NAME  ASC                                           
      *                                                                         
      *</META>                                                                  
